//+------------------------------------------------------------------+
//| position sizing helpers                                          |
//+------------------------------------------------------------------+
// Lots that lose exactly risk_money if sl_dist (price units) is hit.
double XRawLots(const double risk_money, const double sl_dist,
                const double tick_size, const double tick_value)
{
   if(sl_dist <= 0.0 || tick_size <= 0.0 || tick_value <= 0.0 || risk_money <= 0.0) return 0.0;
   const double loss_per_lot = (sl_dist / tick_size) * tick_value;
   if(loss_per_lot <= 0.0) return 0.0;
   return risk_money / loss_per_lot;
}

// Round DOWN to the volume step and clamp to [vmin, vmax]. Returns 0 if below vmin.
double XNormLotsDown(const double lots, const double vmin, const double vmax, const double vstep)
{
   if(lots <= 0.0 || vstep <= 0.0) return 0.0;
   double v = MathFloor(lots / vstep + 1e-9) * vstep;
   if(v > vmax) v = vmax;
   if(v < vmin) return 0.0;
   return v;
}

//+------------------------------------------------------------------+
//| configuration                                                    |
//+------------------------------------------------------------------+
struct XConfig
{
   // time model (all "GMT" hours are GMT clock hours 0..24)
   int    gmt_offset_sec;    // broker server time minus GMT in WINTER (standard) time
   int    dst_mode;          // 0 fixed offset, 1 server follows US DST (New-York-close servers), 2 follows EU DST
   bool   london_sessions;   // trade_start/end/fri_cutoff are London local clock (follows UK DST)
   int    day_roll_hour;     // GMT hour a new trading day starts (FX roll)
   double asia_start, asia_end;
   double trade_start, trade_end, fri_cutoff;
   bool   use_session_filter;
   int    base_sec;          // seconds per base bar
   int    htf_sec;           // seconds per higher-timeframe bar
   int    warmup;            // bars before signals are trusted

   // indicator periods
   int    ema1, ema2, ema3, atr_p, rsi_p, adx_p, bb_p, don_p;
   double htf_adx_min;
   double pb_adx_min;        // trend pullbacks need a trending market on the base timeframe

   // scorer
   double w[XM_COUNT];
   int    en[XM_COUNT];
   double w_htf, w_inter;
   double score_min;
   int    min_confluence;
   double min_margin;        // winning side must beat the other side by this much
   int    min_grade;
   double grade_a_add, grade_ap_add;

   // filters
   double atr_ratio_min, atr_ratio_max, min_atr_price;
   double asia_compress;
   double round_step;
   double adr_block;         // block trend continuation once this share of the average daily range is used (0 = off)
   int    regime_on;         // 1 = weight modules by the efficiency-ratio regime
   double er_lo, er_hi;      // efficiency-ratio regime thresholds
   double reg_trend_lo;      // trend-module weight multiplier in a choppy regime
   double reg_mr_hi;         // mean-reversion-module weight multiplier in a strongly trending regime
   double fc_er_min;         // below this efficiency ratio the forecast is 'no map' (range only)
   double an_conf;           // neighbours agreeing needed for a 'confident' analog call
   double an_edge;           // median 4-bar move (ATR) needed for a confident call
   double an_z;              // audit gate: hit-rate minus an_z standard errors must beat 50%
   int    an_veto;           // 1 = skip setups that a confident pattern match contradicts
   // opening range breakout (ported from GOLD_ORB, distances scaled to ATR)
   double orb_start_hour;    // hour of the daily open on the SERVER clock (New-York-close servers: 1.0)
   int    orb_range_min;     // minutes that form the initial range
   int    orb_settle_min;    // quiet minutes before a side of the range is final
   double orb_wick_atr;      // a wick longer than this many ATR is ignored (the body edge is used instead)
   int    orb_solo;          // 1 = an opening-range breakout alone is a signal (GOLD_ORB mode)
   int    orb_need_bias;     // 1 = solo ORB only in the direction of the higher-timeframe trend

   // trade plan
   double sl_atr_min, sl_atr_max, sl_buffer_atr;
   int    sl_lookback;
   double tp1_r, tp2_r, partial_pct, trail_atr;
   int    max_hold_bars;     // 0 = derive from hold_minutes
   int    hold_minutes;
   int    min_hold_bars;
   double cost_price;        // round-turn spread+slippage in price units (simulation, and the cost guard below)
   double min_stop_cost;     // cost guard: skip setups whose stop is shorter than this many round-trip costs (0 = off)
   double dip_gmt_lo, dip_gmt_hi;   // dip strategies enter only in this GMT window on charts up to H1 (lo < 0 = all day)
   double swap_long, swap_short;   // overnight cost per unit (oz) per server night in price units (positive = you pay)
   int    swap_triple_dow;   // server weekday whose night is charged three times (3 = Wednesday, -1 = none)
   int    d1_mode;           // daily trend filter: 0 off, 1 trade only in the daily trend's direction, 2 buys only while the daily trend is up
   int    d1_sma;            // daily trend = last completed daily close above / below its d1_sma-day mean
   int    path_mode;         // 1 = a bar that touches stop and target is resolved by its likely path (O-L-H-C / O-H-L-C); 0 = always the stop

   // forecast
   double fc_drift, fc_decay, fc_mr;

   void Defaults()
   {
      gmt_offset_sec = 0;   dst_mode = 0;   london_sessions = true;   day_roll_hour = 22;
      asia_start = 0.0;     asia_end = 7.0;
      trade_start = 7.0;    trade_end = 20.0;   fri_cutoff = 19.0;
      use_session_filter = true;
      base_sec = 900;       htf_sec = 3600;     warmup = 250;

      ema1 = 21; ema2 = 50; ema3 = 200; atr_p = 14; rsi_p = 14; adx_p = 14; bb_p = 20; don_p = 20;
      htf_adx_min = 15.0;  pb_adx_min = 18.0;

      w[XM_PULLBACK] = 1.0;  w[XM_SWEEP] = 1.0;   w[XM_BREAKOUT] = 0.8; w[XM_SQUEEZE] = 0.6;
      w[XM_VWAP]     = 0.5;  w[XM_DIVERGE] = 0.5; w[XM_FVG] = 0.6;      w[XM_ROUND] = 0.3;  w[XM_ORB] = 0.9;
      for(int m = 0; m < XM_COUNT; m++) en[m] = 1;
      w_htf = 0.8;  w_inter = 0.3;
      score_min = 1.7;  min_confluence = 2;  min_margin = 0.5;  min_grade = 1;
      grade_a_add = 0.6;  grade_ap_add = 1.2;

      atr_ratio_min = 0.6;  atr_ratio_max = 2.6;  min_atr_price = 0.0;
      asia_compress = 0.7;  round_step = 10.0;
      adr_block = 0.90;  regime_on = 0;  er_lo = 0.20;  er_hi = 0.45;  reg_trend_lo = 0.5;  reg_mr_hi = 0.5;  fc_er_min = 0.12;
      an_conf = 0.62;  an_edge = 0.10;  an_z = 0.5;  an_veto = 0;
      orb_start_hour = 1.0;  orb_range_min = 60;  orb_settle_min = 180;  orb_wick_atr = 0.5;  orb_solo = 0;  orb_need_bias = 0;

      sl_atr_min = 0.9;  sl_atr_max = 2.6;  sl_buffer_atr = 0.15;  sl_lookback = 3;
      tp1_r = 1.0;  tp2_r = 2.5;  partial_pct = 0.5;  trail_atr = 2.0;
      max_hold_bars = 0;  hold_minutes = 480;  min_hold_bars = 8;
      cost_price = 0.30;  path_mode = 1;  min_stop_cost = 20.0;
      dip_gmt_lo = -1.0;  dip_gmt_hi = 24.0;
      d1_mode = 0;  d1_sma = 200;
      swap_long = 0.0;  swap_short = 0.0;  swap_triple_dow = 3;

      fc_drift = 0.10;  fc_decay = 0.93;  fc_mr = 0.03;
   }
};

//+------------------------------------------------------------------+
//| result structures                                                |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| exit profile                                                     |
//+------------------------------------------------------------------+
struct XExit
{
   int    id;
   double tp1_r;       // first target in R (0 = none)
   double part;        // share closed at the first target (1 = all)
   double tp2_r;       // final target in R (0 = none)
   double be_lock_r;   // after the first target the stop moves to entry + be_lock_r x R
   double trail_atr;   // ATR trail on the rest after the first target (0 = off)
   int    mr_exit;     // 1 = close when a candle closes back across the 5-bar mean
   int    max_hold;    // bars (0 = the configured time stop)
   double sl_min_atr, sl_max_atr;
};

string XExitName(const int p)
{
   switch(p)
   {
      case XP_CLASSIC: return "Classic 1R+runner";
      case XP_HIGHHIT: return "High-hit 0.5R";
      case XP_QUICK:   return "Quick 0.6R";
      case XP_MEANREV: return "Mean-revert exit";
      case XP_RIDER:   return "Trend rider (days)";
      case XP_SWING:   return "Swing 3 days";
   }
   return "?";
}

// short form for tables that must fit MT5's 63-character label limit
string XExitShort(const int p)
{
   switch(p)
   {
      case XP_CLASSIC: return "Classic";
      case XP_HIGHHIT: return "High-hit";
      case XP_QUICK:   return "Quick";
      case XP_MEANREV: return "Mean-rev";
      case XP_RIDER:   return "Rider";
      case XP_SWING:   return "Swing";
   }
   return "?";
}

void XMakeExit(const int p, const XConfig &c, XExit &x)
{
   x.id = p;
   x.tp1_r = c.tp1_r; x.part = c.partial_pct; x.tp2_r = c.tp2_r; x.be_lock_r = 0.0; x.trail_atr = c.trail_atr;
   x.mr_exit = 0; x.max_hold = 0; x.sl_min_atr = c.sl_atr_min; x.sl_max_atr = c.sl_atr_max;
   if(p == XP_HIGHHIT) { x.tp1_r = 0.5; x.part = 0.7; x.tp2_r = 1.5; x.trail_atr = 1.5; }
   else if(p == XP_QUICK) { x.tp1_r = 0.6; x.part = 1.0; x.tp2_r = 0.0; x.trail_atr = 0.0; }
   else if(p == XP_MEANREV)
   {
      x.tp1_r = 0.0; x.part = 0.0; x.tp2_r = 0.0; x.trail_atr = 0.0; x.mr_exit = 1;
      x.max_hold = 12; x.sl_min_atr = 1.5; x.sl_max_atr = 3.2;
   }
   else if(p == XP_RIDER || p == XP_SWING)
   {
      // multi-day holds (round 10): the time stop is counted in days, whatever the chart
      const int bs = (c.base_sec > 0) ? c.base_sec : 900;
      if(p == XP_RIDER) { x.tp1_r = 1.0; x.part = 0.33; x.tp2_r = 0.0; x.trail_atr = 3.0; x.max_hold = XMaxI(8, 5 * 86400 / bs); }
      else               x.max_hold = XMaxI(8, 3 * 86400 / bs);
   }
}

struct XSignal
{
   int    dir;        // +1 buy, -1 sell, 0 none
   int    grade;      // 1=B 2=A 3=A+
   int    n_agree;    // modules voting for the winning side
   int    primary;    // strongest voting module, -1 if none
   int    mask;       // bitmask of agreeing modules
   int    reason;     // XR_* when dir == 0
   double score;      // winning-side score
   double score_opp;  // opposing-side score
   double entry, sl, tp1, tp2, risk, atr;

   void Reset()
   {
      dir = 0; grade = 0; n_agree = 0; primary = -1; mask = 0; reason = XR_NOSETUP;
      score = 0.0; score_opp = 0.0; entry = 0.0; sl = 0.0; tp1 = 0.0; tp2 = 0.0; risk = 0.0; atr = 0.0;
   }
};

struct XTradeResult
{
   bool   ok;          // simulated at all
   bool   closed;      // resolved (false = still open at last_idx)
   int    dir;
   int    entry_idx, exit_idx, bars, stage, exit_kind;
   bool   tp1_hit;
   int    bars_to_tp1;
   double entry, risk;
   double r_net;       // realised R after costs (closed trades)
   double float_r;     // current R incl. banked partials (open trades)
   double mfe_r, mae_r;
   double cur_sl;      // active stop price
   void Reset()
   {
      ok = false; closed = false; dir = 0; entry_idx = -1; exit_idx = -1; bars = 0; stage = 0; exit_kind = XE_NONE;
      tp1_hit = false; bars_to_tp1 = 0; entry = 0.0; risk = 0.0; r_net = 0.0; float_r = 0.0;
      mfe_r = 0.0; mae_r = 0.0; cur_sl = 0.0;
   }
};

struct XStats
{
   int    n, wins, losses, scratch, tp1_hits, nh_all, nh_win;
   double sum_r, sum_r2, sum_win, sum_loss, sum_mfe;
   int    hold_all[XHOLD_MAX];
   int    hold_win[XHOLD_MAX];

   void Reset()
   {
      n = 0; wins = 0; losses = 0; scratch = 0; tp1_hits = 0; nh_all = 0; nh_win = 0;
      sum_r = 0.0; sum_r2 = 0.0; sum_win = 0.0; sum_loss = 0.0; sum_mfe = 0.0;
   }
   void Add(const XTradeResult &r)
   {
      n++;
      sum_r += r.r_net;
      sum_r2 += r.r_net * r.r_net;
      sum_mfe += r.mfe_r;
      if(r.tp1_hit) tp1_hits++;
      const bool win = (r.r_net > 0.05);
      if(win)                      { wins++;   sum_win += r.r_net; }
      else if(r.r_net < -0.05)     { losses++; sum_loss += -r.r_net; }
      else                         { scratch++; }
      if(nh_all < XHOLD_MAX) { hold_all[nh_all] = r.bars; nh_all++; }
      if(win && nh_win < XHOLD_MAX)
      {
         hold_win[nh_win] = (r.bars_to_tp1 > 0) ? r.bars_to_tp1 : r.bars;
         nh_win++;
      }
   }
   double WinRate()      const { return (n > 0) ? 100.0 * wins / n : 0.0; }
   double Expectancy()   const { return (n > 0) ? sum_r / n : 0.0; }
   double ProfitFactor() const { return (sum_loss > 1e-9) ? sum_win / sum_loss : ((sum_win > 0.0) ? 99.0 : 0.0); }
   double ExpStdErr()    const
   {
      if(n < 2) return 0.0;
      const double m = sum_r / n;
      const double var = (sum_r2 - n * m * m) / (n - 1);
      return MathSqrt(XMax(var, 0.0) / n);
   }
   double Tp1Rate()      const { return (n > 0) ? 100.0 * tp1_hits / n : 0.0; }

   // percentile (0..1) of holding time in bars; winners = time to first target, else whole trade
   int HoldPct(const bool winners, const double pct) const
   {
      const int cnt = winners ? nh_win : nh_all;
      if(cnt <= 0) return 0;
      int tmp[XHOLD_MAX];
      for(int i = 0; i < cnt; i++) tmp[i] = winners ? hold_win[i] : hold_all[i];
      for(int i = 1; i < cnt; i++)
      {
         const int key = tmp[i];
         int j = i - 1;
         while(j >= 0 && tmp[j] > key) { tmp[j + 1] = tmp[j]; j--; }
         tmp[j + 1] = key;
      }
      int idx = (int)MathFloor(pct * (cnt - 1) + 0.5);
      if(idx < 0) idx = 0;
      if(idx > cnt - 1) idx = cnt - 1;
      return tmp[idx];
   }
};

// one (strategy, exit profile) combination put on trial
struct XLabCell
{
   XStats all;         // every simulated trade on the loaded history (in-sample for the auto-pick)
   XStats recent;      // the last 40% of the history
   bool   qualified;   // meets the win-rate target with positive expectancy on the whole history
   double score;
   void Reset() { all.Reset(); recent.Reset(); qualified = false; score = -1e9; }
};

struct XTrial
{
   XStats all;
   XStats mod[XM_COUNT];
   XStats grade[4];
   void Reset()
   {
      all.Reset();
      for(int m = 0; m < XM_COUNT; m++) mod[m].Reset();
      for(int g = 0; g < 4; g++) grade[g].Reset();
   }
};

struct XAnalog
{
   bool   ok;
   int    k;
   int    dir1, dir4;            // +1 up, -1 down, 0 undecided (sign of the neighbours' median move)
   double conf1, conf4;          // share of neighbours agreeing with that sign (0.5 .. 1)
   double med1, med4, med8;      // median cumulative move in ATR units after 1, 4, 8 bars
   double atr;                   // ATR of the query bar
   double cq_lo[XA_H];           // 20th percentile of the cumulative move per step (ATR units)
   double cq_md[XA_H];           // median
   double cq_hi[XA_H];           // 80th percentile
   int    medoid;                // bar index of the most typical neighbour
   double mean_dist;
   void Reset()
   {
      ok = false; k = 0; dir1 = 0; dir4 = 0; conf1 = 0.5; conf4 = 0.5; med1 = 0.0; med4 = 0.0; med8 = 0.0;
      atr = 0.0; medoid = -1; mean_dist = 0.0;
      for(int s = 0; s < XA_H; s++) { cq_lo[s] = 0.0; cq_md[s] = 0.0; cq_hi[s] = 0.0; }
   }
};

struct XAnalogAudit
{
   int n1, hit1, nc1, hitc1;     // next bar: all calls / confident calls
   int n4, hit4, nc4, hitc4;     // 4 bars ahead
   void Reset() { n1 = 0; hit1 = 0; nc1 = 0; hitc1 = 0; n4 = 0; hit4 = 0; nc4 = 0; hitc4 = 0; }
   double Rate(const int hit, const int nn) const { return (nn > 0) ? (double)hit / nn : 0.0; }
   // hit-rate minus z standard errors: a deliberately cautious estimate of real skill
   double LowerBound(const int hit, const int nn, const double z) const
   {
      if(nn < 1) return 0.0;
      const double p = (double)hit / nn;
      return p - z * MathSqrt(0.25 / nn);
   }
};

//+------------------------------------------------------------------+
//| generic indicator helpers                                        |
//+------------------------------------------------------------------+
void XCalcEMA(XCD(src), XD(dst), const int cnt, const int period)
{
   if(cnt <= 0) return;
   const double a = 2.0 / (period + 1.0);
   dst[0] = src[0];
   for(int i = 1; i < cnt; i++) dst[i] = dst[i - 1] + a * (src[i] - dst[i - 1]);
}

void XCalcATR(XCD(h), XCD(l), XCD(c), XD(atr), const int cnt, const int p)
{
   if(cnt <= 0) return;
   atr[0] = h[0] - l[0];
   for(int i = 1; i < cnt; i++)
   {
      double tr = h[i] - l[i];
      tr = XMax(tr, XAbs(h[i] - c[i - 1]));
      tr = XMax(tr, XAbs(l[i] - c[i - 1]));
      atr[i] = (atr[i - 1] * (p - 1) + tr) / p;
   }
}

void XCalcRSI(XCD(c), XD(rsi), const int cnt, const int p)
{
   if(cnt <= 0) return;
   double ag = 0.0, al = 0.0;
   rsi[0] = 50.0;
   for(int i = 1; i < cnt; i++)
   {
      const double ch = c[i] - c[i - 1];
      const double g = (ch > 0.0) ? ch : 0.0;
      const double ls = (ch < 0.0) ? -ch : 0.0;
      if(i <= p)
      {
         ag += g / p;
         al += ls / p;
         rsi[i] = 50.0;
         if(i < p) continue;
      }
      else
      {
         ag = (ag * (p - 1) + g) / p;
         al = (al * (p - 1) + ls) / p;
      }
      rsi[i] = (al < 1e-12) ? 100.0 : 100.0 - 100.0 / (1.0 + ag / al);
   }
}

void XCalcADX(XCD(h), XCD(l), XCD(c), XD(pdi), XD(mdi), XD(adx), const int cnt, const int p)
{
   double smtr = 0.0, smp = 0.0, smm = 0.0, dxsum = 0.0, av = 0.0;
   for(int i = 0; i < cnt; i++) { pdi[i] = 0.0; mdi[i] = 0.0; adx[i] = 0.0; }
   for(int i = 1; i < cnt; i++)
   {
      const double up = h[i] - h[i - 1];
      const double dn = l[i - 1] - l[i];
      const double pdm = (up > dn && up > 0.0) ? up : 0.0;
      const double mdm = (dn > up && dn > 0.0) ? dn : 0.0;
      double tr = h[i] - l[i];
      tr = XMax(tr, XAbs(h[i] - c[i - 1]));
      tr = XMax(tr, XAbs(l[i] - c[i - 1]));
      if(i <= p) { smtr += tr; smp += pdm; smm += mdm; }
      else       { smtr = smtr - smtr / p + tr; smp = smp - smp / p + pdm; smm = smm - smm / p + mdm; }
      if(i < p) continue;
      if(smtr < 1e-12) continue;
      pdi[i] = 100.0 * smp / smtr;
      mdi[i] = 100.0 * smm / smtr;
      const double den = pdi[i] + mdi[i];
      const double dx = (den < 1e-12) ? 0.0 : 100.0 * XAbs(pdi[i] - mdi[i]) / den;
      if(i < 2 * p - 1)      { dxsum += dx; }
      else if(i == 2 * p - 1) { dxsum += dx; av = dxsum / p; adx[i] = av; }
      else                   { av = (av * (p - 1) + dx) / p; adx[i] = av; }
   }
}

// map every base bar to the latest COMPLETED higher-TF bar (or -1)
void XMapTF(XCT(bt), const int bn, const int base_sec, XCT(ht), const int hn, const int htf_sec, XI(map))
{
   int j = -1;
   for(int i = 0; i < bn; i++)
   {
      const datetime close_t = bt[i] + base_sec;
      while(j + 1 < hn && ht[j + 1] + htf_sec <= close_t) j++;
      map[i] = j;
   }
}

//--- calendar maths for daylight saving (Howard Hinnant's civil-date algorithms)
long XDaysFromCivil(const int y0, const int m, const int d)
{
   const long y = (m <= 2) ? y0 - 1 : y0;
   const long era = ((y >= 0) ? y : y - 399) / 400;
   const long yoe = y - era * 400;
   const long mp = (m > 2) ? m - 3 : m + 9;
   const long doy = (153 * mp + 2) / 5 + d - 1;
   const long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
   return era * 146097 + doe - 719468;
}

int XYearOfDays(const long z0)
{
   const long z = z0 + 719468;
   const long era = ((z >= 0) ? z : z - 146096) / 146097;
   const long doe = z - era * 146097;
   const long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
   long y = yoe + era * 400;
   const long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
   const long mp = (5 * doy + 2) / 153;
   const long m = (mp < 10) ? mp + 3 : mp - 9;
   if(m <= 2) y++;
   return (int)y;
}

// days-since-epoch of the n-th Sunday (n>=1) of a month
long XNthSunday(const int y, const int m, const int n)
{
   const long first = XDaysFromCivil(y, m, 1);
   const long dow = (first + 4) % 7;                 // 0 = Sunday
   return first + (7 - dow) % 7 + 7 * (n - 1);
}

long XLastSunday(const int y, const int m)
{
   const long next = (m == 12) ? XDaysFromCivil(y + 1, 1, 1) : XDaysFromCivil(y, m + 1, 1);
   const long last = next - 1;
   const long dow = (last + 4) % 7;
   return last - dow;
}

// US daylight time: 2nd Sunday of March 07:00 UTC .. 1st Sunday of November 06:00 UTC
bool XUsDst(const long gmt_sec)
{
   const int y = XYearOfDays(gmt_sec / 86400);
   const long a = XNthSunday(y, 3, 2) * 86400 + 7 * 3600;
   const long b = XNthSunday(y, 11, 1) * 86400 + 6 * 3600;
   return (gmt_sec >= a && gmt_sec < b);
}

// EU/UK summer time: last Sunday of March 01:00 UTC .. last Sunday of October 01:00 UTC
bool XEuDst(const long gmt_sec)
{
   const int y = XYearOfDays(gmt_sec / 86400);
   const long a = XLastSunday(y, 3) * 86400 + 3600;
   const long b = XLastSunday(y, 10) * 86400 + 3600;
   return (gmt_sec >= a && gmt_sec < b);
}

// Server-time minus GMT that applied at server timestamp t.
int XOffsetAt(const XConfig &c, const datetime t)
{
   int off = c.gmt_offset_sec;
   if(c.dst_mode == 0) return off;
   const long g = (long)t - c.gmt_offset_sec;
   if(c.dst_mode == 1 && XUsDst(g)) off += 3600;
   else if(c.dst_mode == 2 && XEuDst(g)) off += 3600;
   return off;
}

double XHourGmt(const datetime t, const int gmt_offset_sec)
{
   long s = ((long)t - gmt_offset_sec) % 86400;
   if(s < 0) s += 86400;
   return (double)s / 3600.0;
}

// 0 = Sunday ... 5 = Friday, 6 = Saturday (GMT calendar)
int XWeekdayGmt(const datetime t, const int gmt_offset_sec)
{
   long d = ((long)t - gmt_offset_sec) / 86400;
   return (int)((d + 4) % 7);
}

//+------------------------------------------------------------------+
//| the engine                                                       |
//+------------------------------------------------------------------+
class CXauEngine
{
public:
   XConfig cfg;
   int     n, hn, in_n;
   bool    inter_invert;

   // base series
   XTARR(m_t); XDARR(m_o); XDARR(m_h); XDARR(m_l); XDARR(m_c); XDARR(m_v);
   // base indicators
   XDARR(m_ema1); XDARR(m_ema2); XDARR(m_ema3); XDARR(m_atr); XDARR(m_atrref);
   XDARR(m_sma5); XDARR(m_rsi2);   // fast mean and 2-period RSI (short-term mean reversion)
   XDARR(m_rsi); XDARR(m_adx); XDARR(m_pdi); XDARR(m_mdi);
   XDARR(m_bbw); XDARR(m_bbp); XDARR(m_donh); XDARR(m_donl); XDARR(m_vavg);
   XDARR(m_vwap); XDARR(m_vsd); XDARR(m_hour);
   XIARR(m_daybars); XIARR(m_asiaok); XDARR(m_asiahi); XDARR(m_asialo);
   XDARR(m_pdh); XDARR(m_pdl); XDARR(m_adr); XDARR(m_adru); XDARR(m_er);
   // higher timeframe
   XTARR(m_ht); XDARR(m_hc); XDARR(m_hh); XDARR(m_hl); XDARR(m_hema2); XDARR(m_hema3);
   XDARR(m_hpdi); XDARR(m_hmdi); XDARR(m_hadx0); XIARR(m_hbias0);
   XIARR(m_hmap); XIARR(m_bias); XDARR(m_hadx);
   // daily series (for the daily trend filter)
   int     d1n;
   XTARR(m_dt); XDARR(m_dc); XIARR(m_dreg);
   // intermarket proxy
   XTARR(m_it); XDARR(m_ic); XDARR(m_iema1); XDARR(m_iema2); XIARR(m_idir0); XIARR(m_imap); XIARR(m_inter);
   // votes and scores
   XDARR(m_vote);
   XDARR(m_orbhi); XDARR(m_orblo); XDARR(m_orbv); XIARR(m_orbst); XTARR(m_orbt0);   // opening range: levels, vote, state (0 none 1 building 2 settling 3 final), session start
   XDARR(m_scl); XDARR(m_scs); XIARR(m_nal); XIARR(m_nas); XIARR(m_mkl); XIARR(m_mks); XDARR(m_snet);
   // analog forecaster data
   XDARR(m_feat);    // n * XA_F situation descriptors
   XDARR(m_fut);     // n * XA_H * 4 relative future candles (o,h,l,c) in ATR units
   XDARR(m_aw);      // squared feature weights
   // seasonality (mean range by GMT hour, normalised)
   double  season[24];
   // forecast output
   int     fc_n;
   XTARR(fc_t); XDARR(fc_o); XDARR(fc_h); XDARR(fc_l); XDARR(fc_c); XDARR(fc_up); XDARR(fc_dn);
   double  fc_drift_atr;
   // calibrated projection (research/sim/forecast.cpp): cone from past standardised moves, candle size from
   // ATR x hour-of-day profile with a median correction. On real XAUUSD the 20-80% cone held the price 59-61% of
   // the time (the pattern-match cone: 51-55%) and the candle-size error fell 14-19%.
   double  fcz_lo[XA_H], fcz_md[XA_H], fcz_hi[XA_H];   // percentiles 20 / 50 / 80 of standardised s-step moves (index s-1)
   double  fc_krange;         // median of real high-low / (ATR x hour profile)
   bool    fc_cal_ok;
   int     rg_n;
   XTARR(rg_t); XDARR(rg_mid); XDARR(rg_up); XDARR(rg_dn); XDARR(rg_size);
   double  fc_rmse;      // realised one-step error of the drift model (calibrates the cone)
   bool    fc_nomap;     // choppy / spiking market: show range only, no directional path

   CXauEngine() { cfg.Defaults(); n = 0; hn = 0; in_n = 0; d1n = 0; fc_cal_ok = false; fc_krange = 1.0; rg_n = 0; inter_invert = false; fc_n = 0; fc_drift_atr = 0.0; fc_rmse = 0.0; fc_nomap = false;
                  lab_buffer = 3.0; lab_window = 0; lab_recent = 1; lab_se_k = 1.0; lab_k = 0; lab_pick_s = -1; lab_pick_p = -1; lab_qualified = 0;
                  lab_auto_folds = 0; lab_first = 0; lab_last = 0; lab_target = 60.0; }

   //--- data loading ------------------------------------------------
   bool SetBase(XCRATES(r), const int cnt)
   {
      if(cnt < 1) return false;
      n = cnt;
      ArrayResize(m_t, n); ArrayResize(m_o, n); ArrayResize(m_h, n);
      ArrayResize(m_l, n); ArrayResize(m_c, n); ArrayResize(m_v, n);
      for(int i = 0; i < n; i++)
      {
         m_t[i] = r[i].time; m_o[i] = r[i].open; m_h[i] = r[i].high;
         m_l[i] = r[i].low;  m_c[i] = r[i].close; m_v[i] = (double)r[i].tick_volume;
      }
      return true;
   }
   bool SetHTF(XCRATES(r), const int cnt)
   {
      hn = (cnt < 0) ? 0 : cnt;
      ArrayResize(m_ht, hn); ArrayResize(m_hc, hn); ArrayResize(m_hh, hn); ArrayResize(m_hl, hn);
      for(int i = 0; i < hn; i++) { m_ht[i] = r[i].time; m_hc[i] = r[i].close; m_hh[i] = r[i].high; m_hl[i] = r[i].low; }
      return hn > 0;
   }
   // Optional daily bars for the daily trend filter (cfg.d1_mode). Without them the filter is off.
   bool SetDaily(XCRATES(r), const int cnt)
   {
      d1n = (cnt < 0) ? 0 : cnt;
      ArrayResize(m_dt, d1n); ArrayResize(m_dc, d1n);
      for(int i = 0; i < d1n; i++) { m_dt[i] = r[i].time; m_dc[i] = r[i].close; }
      return d1n > 0;
   }
   // Optional proxy series (e.g. DXY or EURUSD) on the SAME timeframe as the base.
   // invert = true when the proxy moves opposite to gold (DXY), false for EURUSD-like.
   bool SetInter(XCRATES(r), const int cnt, const bool invert)
   {
      in_n = (cnt < 0) ? 0 : cnt;
      inter_invert = invert;
      ArrayResize(m_it, in_n); ArrayResize(m_ic, in_n);
      for(int i = 0; i < in_n; i++) { m_it[i] = r[i].time; m_ic[i] = r[i].close; }
      return in_n > 0;
   }

   //--- derived helpers ---------------------------------------------
   int MaxHold() const
   {
      if(cfg.max_hold_bars > 0) return cfg.max_hold_bars;
      const int b = (cfg.hold_minutes * 60) / (cfg.base_sec > 0 ? cfg.base_sec : 900);
      return XMaxI(b, cfg.min_hold_bars);
   }
   double LowestLow(const int a, const int b) const
   {
      double x = m_l[a];
      for(int k = a + 1; k <= b; k++) if(m_l[k] < x) x = m_l[k];
      return x;
   }
   double HighestHigh(const int a, const int b) const
   {
      double x = m_h[a];
      for(int k = a + 1; k <= b; k++) if(m_h[k] > x) x = m_h[k];
      return x;
   }
   double MinRsi(const int a, const int b) const
   {
      double x = m_rsi[a];
      for(int k = a + 1; k <= b; k++) if(m_rsi[k] < x) x = m_rsi[k];
      return x;
   }
   double MaxRsi(const int a, const int b) const
   {
      double x = m_rsi[a];
      for(int k = a + 1; k <= b; k++) if(m_rsi[k] > x) x = m_rsi[k];
      return x;
   }
   bool Spike(const int i) const { return m_vavg[i] > 0.0 && m_v[i] >= 1.3 * m_vavg[i]; }

   double SeasonAt(const datetime t) const
   {
      int h = (int)XHourGmt(t, XOffsetAt(cfg, t));
      if(h < 0) h = 0;
      if(h > 23) h = 23;
      return season[h];
   }

   //--- main computation --------------------------------------------
   bool Compute()
   {
      if(n < cfg.warmup + 60) return false;
      SizeArrays();
      ComputeBaseIndicators();
      ComputeSessionLevels();
      ComputeHTF();
      ComputeDaily();
      ComputeOrb();
      ComputeVotes();
      ComputeScores();
      ComputeAnalog();
      return true;
   }

   // Re-derive scores after cfg weights / enable flags changed.
   void ComputeScores()
   {
      for(int i = 0; i < n; i++)
      {
         double sl = 0.0, ss = 0.0;
         int nl = 0, ns = 0, ml = 0, ms = 0;
         if(i >= cfg.warmup)
         {
            for(int m = 0; m < XM_COUNT; m++)
            {
               if(cfg.en[m] == 0) continue;
               const double v = m_vote[i * XM_COUNT + m];
               double wm = cfg.w[m];
               if(cfg.regime_on == 1)
               {
                  const bool trend_mod = (m == XM_PULLBACK || m == XM_BREAKOUT || m == XM_SQUEEZE);
                  const bool mr_mod = (m == XM_VWAP || m == XM_DIVERGE);
                  if(trend_mod && m_er[i] < cfg.er_lo) wm *= cfg.reg_trend_lo;
                  if(mr_mod && m_er[i] > cfg.er_hi) wm *= cfg.reg_mr_hi;
               }
               if(v > 0.0)      { sl += wm * v;  nl++; ml |= (1 << m); }
               else if(v < 0.0) { ss += wm * -v; ns++; ms |= (1 << m); }
            }
            const double b = (double)m_bias[i];
            sl += cfg.w_htf * b;  ss -= cfg.w_htf * b;
            const double x = (double)m_inter[i];
            sl += cfg.w_inter * x;  ss -= cfg.w_inter * x;
         }
         m_scl[i] = sl; m_scs[i] = ss; m_nal[i] = nl; m_nas[i] = ns; m_mkl[i] = ml; m_mks[i] = ms;
         m_snet[i] = sl - ss;
      }
   }

   //--- filters -------------------------------------------------------
   int FilterReason(const int i) const
   {
      if(i < cfg.warmup || i >= n) return XR_WARMUP;
      const double a = m_atr[i];
      if(a < cfg.min_atr_price) return XR_VOL_LOW;
      if(m_atrref[i] > 0.0)
      {
         const double ratio = a / m_atrref[i];
         if(ratio < cfg.atr_ratio_min) return XR_VOL_LOW;
         if(ratio > cfg.atr_ratio_max) return XR_VOL_HIGH;
      }
      if(cfg.use_session_filter && cfg.base_sec <= 7200)
      {
         double hrn = m_hour[i] + cfg.base_sec / 3600.0;      // the next bar's open (GMT), where we would enter
         const int off = XOffsetAt(cfg, m_t[i]);
         if(cfg.london_sessions && XEuDst((long)m_t[i] - off)) hrn += 1.0;   // London local clock
         if(hrn >= 24.0) hrn -= 24.0;
         if(!(hrn >= cfg.trade_start && hrn < cfg.trade_end)) return XR_SESSION;
         if(XWeekdayGmt(m_t[i], off) == 5 && hrn >= cfg.fri_cutoff) return XR_FRIDAY;
      }
      return XR_OK;
   }

   //--- signal ------------------------------------------------------
   // returns true when a tradable signal exists at closed bar i
   bool Evaluate(const int i, XSignal &s) const
   {
      s.Reset();
      if(i < 0 || i >= n) return false;
      const int fr = FilterReason(i);
      if(fr != XR_OK) { s.reason = fr; return false; }

      if(cfg.orb_solo == 1)
      {
         // GOLD_ORB mode: a settled opening-range breakout is the whole strategy
         const double v = m_vote[i * XM_COUNT + XM_ORB];
         if(cfg.en[XM_ORB] == 0 || v == 0.0) { s.reason = XR_NOSETUP; return false; }
         const int d = (v > 0.0) ? 1 : -1;
         if(cfg.orb_need_bias == 1 && m_bias[i] * d <= 0) { s.reason = XR_NOSETUP; return false; }
         s.dir = d;
         s.n_agree = 1; s.primary = XM_ORB; s.mask = (1 << XM_ORB);
         s.grade = (XAbs(v) >= 0.85) ? 2 : 1;
         s.score = cfg.score_min + ((s.grade == 2) ? cfg.grade_a_add : 0.0);
         if(s.grade < cfg.min_grade) { s.dir = 0; s.reason = XR_GRADE; return false; }
         if(cfg.an_veto == 1)
         {
            XAnalog an0;
            if(AnalogQuery(i, an0) && AnalogConfident(an0) && an0.dir4 != d) { s.dir = 0; s.reason = XR_ANALOG; return false; }
         }
         if(!BuildPlan(i, d, s)) { s.dir = 0; if(s.reason != XR_COST) s.reason = XR_SL_WIDE; return false; }
         s.reason = XR_OK;
         return true;
      }

      const double sl = m_scl[i], ss = m_scs[i];
      int dir = 0;
      if(sl >= cfg.score_min && m_nal[i] >= cfg.min_confluence && (sl - ss) >= cfg.min_margin) dir = 1;
      else if(ss >= cfg.score_min && m_nas[i] >= cfg.min_confluence && (ss - sl) >= cfg.min_margin) dir = -1;
      if(dir == 0) { s.reason = XR_NOSETUP; s.score = XMax(sl, ss); return false; }

      s.dir = dir;
      s.score     = (dir > 0) ? sl : ss;
      s.score_opp = (dir > 0) ? ss : sl;
      s.n_agree   = (dir > 0) ? m_nal[i] : m_nas[i];
      s.mask      = (dir > 0) ? m_mkl[i] : m_mks[i];
      double best = 0.0;
      for(int m = 0; m < XM_COUNT; m++)
      {
         if((s.mask & (1 << m)) == 0) continue;
         const double v = XAbs(m_vote[i * XM_COUNT + m]) * cfg.w[m];
         if(v > best) { best = v; s.primary = m; }
      }
      s.grade = 1;
      if(s.score >= cfg.score_min + cfg.grade_a_add) s.grade = 2;
      if(s.score >= cfg.score_min + cfg.grade_ap_add && s.n_agree >= 3) s.grade = 3;
      if(s.grade < cfg.min_grade) { s.dir = 0; s.reason = XR_GRADE; return false; }
      if(cfg.an_veto == 1)
      {
         XAnalog an;
         if(AnalogQuery(i, an) && AnalogConfident(an) && an.dir4 != dir) { s.dir = 0; s.reason = XR_ANALOG; return false; }
      }
      if(!BuildPlan(i, dir, s)) { s.dir = 0; if(s.reason != XR_COST) s.reason = XR_SL_WIDE; return false; }
      s.reason = XR_OK;
      return true;
   }

   // Structural stop, then TP levels in R multiples.
   bool BuildPlan(const int i, const int dir, XSignal &s) const
   {
      return BuildPlanEx(i, dir, s, cfg.sl_atr_min, cfg.sl_atr_max, cfg.tp1_r, cfg.tp2_r);
   }

   bool BuildPlanEx(const int i, const int dir, XSignal &s, const double slmin, const double slmax,
                    const double tp1_r, const double tp2_r) const
   {
      const double a = m_atr[i];
      if(a <= 0.0) return false;
      const double entry = m_c[i];
      const int lb = XMaxI(1, cfg.sl_lookback);
      double sl, dist;
      if(dir > 0)
      {
         sl = LowestLow(i - lb + 1, i) - cfg.sl_buffer_atr * a;
         dist = entry - sl;
         if(dist < slmin * a) { sl = entry - slmin * a; dist = entry - sl; }
      }
      else
      {
         sl = HighestHigh(i - lb + 1, i) + cfg.sl_buffer_atr * a;
         dist = sl - entry;
         if(dist < slmin * a) { sl = entry + slmin * a; dist = sl - entry; }
      }
      if(dist > slmax * a) return false;
      // cost guard: on real data a stop shorter than 20 round-trip costs lost money on every timeframe tested
      // (docs/REAL_DATA.md, section 7): the spread alone takes 5%+ of every trade
      if(cfg.min_stop_cost > 0.0 && dist < cfg.min_stop_cost * cfg.cost_price) { s.reason = XR_COST; return false; }
      s.entry = entry; s.sl = sl; s.risk = dist; s.atr = a;
      s.tp1 = (tp1_r > 0.0) ? entry + dir * tp1_r * dist : 0.0;
      s.tp2 = (tp2_r > 0.0) ? entry + dir * tp2_r * dist : 0.0;
      return true;
   }

   //--- bar-based trade simulator ------------------------------------
   bool SimulateTrade(const int i, const int dir, const double sl_price, const int last_idx, XTradeResult &r) const
   {
      XExit x;
      XMakeExit(XP_CLASSIC, cfg, x);
      return SimulateTradeEx(i, dir, sl_price, last_idx, x, r);
   }

   // Entry at the OPEN of bar i+1; bars up to last_idx may be used.
   // path_mode 1: inside a bar price is assumed to travel O-L-H-C (bullish bar) or O-H-L-C (bearish bar),
   // so a bar that touches both levels is resolved in that order. path_mode 0: the stop always wins.
   // Gaps through a level fill at the open. The trail moves at bar closes only.
   bool SimulateTradeEx(const int i, const int dir, const double sl_price, const int last_idx, const XExit &x, XTradeResult &r) const
   {
      if(i + 1 >= n) { r.Reset(); return false; }
      return SimulateTradeAt(i, i + 1, m_o[i + 1], false, dir, sl_price, last_idx, x, r);
   }

   // Entry at `entry` during bar e (signal bar i). limit_fill = a limit order filled inside bar e: the bar's open is
   // not a gap through the stop, and only the part of the bar after the fill counts (fill -> low/high -> close).
   bool SimulateTradeAt(const int i, const int e, const double entry, const bool limit_fill, const int dir, const double sl_price,
                        const int last_idx, const XExit &x, XTradeResult &r) const
   {
      r.Reset();
      if(e > last_idx || e >= n || dir == 0 || i < 0) return false;
      const double a = m_atr[i];
      const double risk = (dir > 0) ? (entry - sl_price) : (sl_price - entry);
      if(risk < 0.4 * a || risk <= 0.0) return false;

      const int maxh = (x.max_hold > 0) ? x.max_hold : MaxHold();
      const int jend = XMinI(last_idx, e + maxh - 1);
      const bool has_tp1 = (x.tp1_r > 0.0 && x.part > 0.0);
      const double tp1f = x.tp1_r * risk;
      const double tp2f = (x.tp2_r > 0.0) ? x.tp2_r * risk : 1e300;
      double stopf = -risk;
      double rem = 1.0, real = 0.0, ext = 0.0, mfe = 0.0, mae = 0.0, lastfcl = 0.0;
      int stage = 0;
      bool closed = false;
      int exit_idx = jend;
      int ek = XE_NONE;
      double pf[4];

      r.ok = true; r.dir = dir; r.entry_idx = e; r.entry = entry; r.risk = risk;

      for(int j = e; j <= jend && !closed; j++)
      {
         const double fo = dir * (m_o[j] - entry);
         const double fhi = (dir > 0) ? (m_h[j] - entry) : (entry - m_l[j]);
         const double flo = (dir > 0) ? (m_l[j] - entry) : (entry - m_h[j]);
         const double fcl = dir * (m_c[j] - entry);
         lastfcl = fcl;
         if(fhi > mfe) mfe = fhi;
         if(flo < mae) mae = flo;

         const bool fillbar = (limit_fill && j == e);
         // gap through a level at the open
         if(!fillbar && fo <= stopf) { real += rem * (fo / risk); rem = 0.0; closed = true; exit_idx = j; ek = (stage == 0) ? XE_STOP : XE_TRAIL; break; }

         if(cfg.path_mode == 1)
         {
            const bool bull_path = ((m_c[j] >= m_o[j]) == (dir > 0));   // favourable extreme comes second
            pf[0] = fo;
            pf[1] = bull_path ? flo : fhi;
            pf[2] = bull_path ? fhi : flo;
            pf[3] = fcl;
            if(fillbar)
            {
               // filled on the way to the adverse extreme: fill -> adverse extreme -> (favourable extreme if it comes later) -> close
               pf[0] = 0.0;
               pf[1] = flo;
               pf[2] = bull_path ? fhi : fcl;
               pf[3] = fcl;
            }
            for(int k = 1; k <= 3 && !closed; k++)
            {
               const double fa = pf[k - 1], fb = pf[k];
               if(fb < fa)
               {
                  if(fb <= stopf) { real += rem * (stopf / risk); rem = 0.0; closed = true; exit_idx = j; ek = (stage == 0) ? XE_STOP : XE_TRAIL; }
               }
               else if(fb > fa)
               {
                  if(stage == 0 && has_tp1 && fb >= tp1f)
                  {
                     const double fill = XMax(tp1f, fa);
                     real += x.part * (fill / risk);
                     rem = 1.0 - x.part;
                     stage = 1; stopf = x.be_lock_r * risk; ext = fb;
                     r.tp1_hit = true; r.bars_to_tp1 = j - e + 1;
                     if(rem <= 1e-9) { rem = 0.0; closed = true; exit_idx = j; ek = XE_TP1_FULL; }
                  }
                  if(!closed && (stage == 1 || !has_tp1) && fb >= tp2f)
                  {
                     const double fill = XMax(tp2f, fa);
                     real += rem * (fill / risk); rem = 0.0; closed = true; exit_idx = j; ek = XE_TP2;
                  }
               }
            }
         }
         else
         {
            if(flo <= stopf) { real += rem * (stopf / risk); rem = 0.0; closed = true; exit_idx = j; ek = (stage == 0) ? XE_STOP : XE_TRAIL; break; }
            if(fillbar) { /* the rest of the fill bar is unknown: stop only */ }
            else if(stage == 0 && has_tp1 && fhi >= tp1f)
            {
               real += x.part * x.tp1_r;
               rem = 1.0 - x.part;
               stage = 1; stopf = x.be_lock_r * risk; ext = fhi;
               r.tp1_hit = true; r.bars_to_tp1 = j - e + 1;
               if(rem <= 1e-9) { rem = 0.0; closed = true; exit_idx = j; ek = XE_TP1_FULL; break; }
               if(flo <= stopf) { real += rem * (stopf / risk); rem = 0.0; closed = true; exit_idx = j; ek = XE_TRAIL; break; }
            }
            else if((stage == 1 || !has_tp1) && fhi >= tp2f) { real += rem * x.tp2_r; rem = 0.0; closed = true; exit_idx = j; ek = XE_TP2; break; }
         }
         if(closed) break;

         // after the bar: trail, mean-reversion exit, time stop
         if(stage == 1)
         {
            if(fhi > ext) ext = fhi;
            if(x.trail_atr > 0.0)
            {
               const double tr = ext - x.trail_atr * a;
               if(tr > stopf) stopf = tr;
            }
         }
         if(x.mr_exit == 1 && ((dir > 0 && m_c[j] > m_sma5[j]) || (dir < 0 && m_c[j] < m_sma5[j])))
         { real += rem * (fcl / risk); rem = 0.0; closed = true; exit_idx = j; ek = XE_MR; break; }
         if(j - e + 1 >= maxh) { real += rem * (fcl / risk); rem = 0.0; closed = true; exit_idx = j; ek = XE_TIME; break; }
      }

      r.stage = stage;
      r.exit_kind = ek;
      r.bars = exit_idx - e + 1;
      r.exit_idx = exit_idx;
      r.mfe_r = mfe / risk;
      r.mae_r = mae / risk;
      r.cur_sl = entry + dir * stopf;
      if(closed)
      {
         r.closed = true;
         r.r_net = real - cfg.cost_price / risk - SwapNights(e, exit_idx) * ((dir > 0) ? cfg.swap_long : cfg.swap_short) / risk;
         r.float_r = r.r_net;
      }
      else
      {
         r.closed = false;
         r.float_r = real + rem * (lastfcl / risk);
      }
      return true;
   }

   // Server nights a position opened at bar e and closed at bar x is held over (the night after the triple-swap
   // weekday counts three times). Server time: a night = a change of the server date.
   int SwapNights(const int e, const int x) const
   {
      if(e < 0 || x <= e || x >= n) return 0;
      const long d0 = (long)m_t[e] / 86400, d1 = (long)m_t[x] / 86400;
      int nights = 0;
      for(long d = d0; d < d1; d++)
      {
         const int dow = (int)((d + 4) % 7);                 // weekday of the server date being left (0 Sunday)
         if(dow == 6 || dow == 0) continue;                  // weekend dates have no bars and no swap of their own
         nights += (cfg.swap_triple_dow >= 0 && dow == cfg.swap_triple_dow) ? 3 : 1;
      }
      return nights;
   }

   //--- historical trial ----------------------------------------------
   // One trade at a time per stream. Only resolved trades are counted.
   void RunTrial(const int from_i, const int last_closed, XTrial &tr) const
   {
      tr.Reset();
      int busy_all = -1;
      int busy_m[XM_COUNT];
      for(int m = 0; m < XM_COUNT; m++) busy_m[m] = -1;
      const int start = XMaxI(from_i, cfg.warmup);
      XSignal s;
      XTradeResult r;
      for(int i = start; i < last_closed; i++)
      {
         // composite strategy
         if(i > busy_all && Evaluate(i, s))
         {
            if(SimulateTrade(i, s.dir, s.sl, last_closed, r))
            {
               busy_all = r.exit_idx;
               if(r.closed) { tr.all.Add(r); tr.grade[s.grade].Add(r); }
            }
         }
         // each module on its own (never against the higher-timeframe trend)
         if(FilterReason(i) != XR_OK) continue;
         for(int m = 0; m < XM_COUNT; m++)
         {
            const double v = m_vote[i * XM_COUNT + m];
            if(v == 0.0 || i <= busy_m[m]) continue;
            const int d = (v > 0.0) ? 1 : -1;
            if(m_bias[i] * d < 0) continue;
            XSignal p;
            p.Reset();
            if(!BuildPlan(i, d, p)) continue;
            if(SimulateTrade(i, d, p.sl, last_closed, r))
            {
               busy_m[m] = r.exit_idx;
               if(r.closed) tr.mod[m].Add(r);
            }
         }
      }
   }

   // Switch off modules whose own trial shows a clearly negative expectancy.
   // Returns the number of modules disabled.
   int ApplyGating(const XTrial &tr, const int min_trades, const double min_exp_r)
   {
      int off = 0;
      for(int m = 0; m < XM_COUNT; m++)
      {
         cfg.en[m] = 1;
         if(tr.mod[m].n >= min_trades && tr.mod[m].Expectancy() < min_exp_r) { cfg.en[m] = 0; off++; }
      }
      ComputeScores();
      return off;
   }

   //--- complete strategies ---------------------------------------------
   // Trend used by the dip strategies: price on the right side of the 200 EMA and a higher timeframe that does not disagree.
   int TrendDir(const int i) const
   {
      if(m_c[i] > m_ema3[i] && m_bias[i] >= 0) return 1;
      if(m_c[i] < m_ema3[i] && m_bias[i] <= 0) return -1;
      return 0;
   }

   // Daily trend for every base bar: +1 / -1 when the last daily bar COMPLETED by the close of bar i closed above /
   // below its d1_sma-day mean, 0 when unknown (not enough daily history).
   void ComputeDaily()
   {
      ArrayResize(m_dreg, n);
      for(int i = 0; i < n; i++) m_dreg[i] = 0;
      const int L = XMaxI(cfg.d1_sma, 2);
      if(d1n < L + 1) return;
      XDARR(sm);
      ArrayResize(sm, d1n);
      double sum = 0.0;
      for(int k = 0; k < d1n; k++)
      {
         sum += m_dc[k];
         if(k >= L) sum -= m_dc[k - L];
         sm[k] = (k >= L - 1) ? sum / L : 0.0;
      }
      int j = -1;
      for(int i = 0; i < n; i++)
      {
         const datetime done = m_t[i] + (datetime)cfg.base_sec;
         while(j + 1 < d1n && m_dt[j + 1] + 86400 <= done) j++;
         if(j >= L - 1) m_dreg[i] = (m_dc[j] > sm[j]) ? 1 : -1;
      }
   }

   // True when a dip strategy may enter after bar i: inside the configured GMT window (charts up to H1 only).
   bool DipWindowOk(const int i) const
   {
      if(cfg.dip_gmt_lo < 0.0 || cfg.base_sec > 3600) return true;
      double h = m_hour[i] + cfg.base_sec / 3600.0;           // entry = the next bar's open, GMT clock
      if(h >= 24.0) h -= 24.0;
      if(cfg.dip_gmt_lo <= cfg.dip_gmt_hi) return (h >= cfg.dip_gmt_lo && h < cfg.dip_gmt_hi);
      return (h >= cfg.dip_gmt_lo || h < cfg.dip_gmt_hi);   // window across midnight
   }

   // Direction strategy s wants to trade after closed bar i (0 = nothing), after the optional filters.
   int StrategyDir(const int st, const int i) const
   {
      const int d = StrategyDirRaw(st, i);
      if(d == 0) return 0;
      if(cfg.d1_mode > 0 && d1n > 0 && i < ArraySize(m_dreg))
      {
         const int r = m_dreg[i];
         if(cfg.d1_mode == 1 && r != d) return 0;
         if(cfg.d1_mode == 2 && !(d > 0 && r > 0)) return 0;
      }
      return d;
   }

   // Direction strategy s wants to trade after closed bar i (0 = nothing). Uses data <= i only.
   int StrategyDirRaw(const int st, const int i) const
   {
      if(i < cfg.warmup + 10 || i >= n) return 0;
      const int o = i * XM_COUNT;
      const int t = TrendDir(i);
      if((st == XS_DIP || st == XS_DOUBLE7 || st == XS_IBS) && !DipWindowOk(i)) return 0;
      switch(st)
      {
         case XS_CONFLUENCE:
         {
            const double sl = m_scl[i], ss = m_scs[i];
            if(sl >= cfg.score_min && m_nal[i] >= cfg.min_confluence && (sl - ss) >= cfg.min_margin) return 1;
            if(ss >= cfg.score_min && m_nas[i] >= cfg.min_confluence && (ss - sl) >= cfg.min_margin) return -1;
            return 0;
         }
         case XS_ORB:
         {
            if(cfg.en[XM_ORB] == 0) return 0;
            const double v = m_vote[o + XM_ORB];
            const int d = (v > 0.0) ? 1 : ((v < 0.0) ? -1 : 0);
            return (d != 0 && (cfg.orb_need_bias == 0 || m_bias[i] * d > 0) && t != -d) ? d : 0;
         }
         case XS_DIP:
            if(t > 0 && m_rsi2[i] < 10.0) return 1;
            if(t < 0 && m_rsi2[i] > 90.0) return -1;
            return 0;
         case XS_DOUBLE7:
         {
            double lo = m_c[i - 1], hi = m_c[i - 1];
            for(int k = i - 6; k < i; k++) { if(m_c[k] < lo) lo = m_c[k]; if(m_c[k] > hi) hi = m_c[k]; }
            if(t > 0 && m_c[i] < lo) return 1;
            if(t < 0 && m_c[i] > hi) return -1;
            return 0;
         }
         case XS_IBS:
         {
            const double rng = m_h[i] - m_l[i];
            if(rng <= 0.0 || rng < 0.5 * m_atr[i]) return 0;
            const double ibs = (m_c[i] - m_l[i]) / rng;
            if(t > 0 && ibs < 0.15 && m_c[i] < m_c[i - 1]) return 1;
            if(t < 0 && ibs > 0.85 && m_c[i] > m_c[i - 1]) return -1;
            return 0;
         }
         case XS_SWEEP:
         {
            const double v = m_vote[o + XM_SWEEP];
            const int d = (v > 0.0) ? 1 : ((v < 0.0) ? -1 : 0);
            return (d != 0 && t == d) ? d : 0;
         }
         case XS_PULLBACK:
         {
            const double v = m_vote[o + XM_PULLBACK];
            return (v > 0.0) ? 1 : ((v < 0.0) ? -1 : 0);
         }
         case XS_SQUEEZE:
         {
            double v = m_vote[o + XM_SQUEEZE];
            if(v == 0.0) v = m_vote[o + XM_BREAKOUT];
            const int d = (v > 0.0) ? 1 : ((v < 0.0) ? -1 : 0);
            return (d != 0 && t != -d) ? d : 0;
         }
      }
      return 0;
   }

   // Full signal for strategy st at closed bar i with exit profile x: filters, direction, stop, targets.
   bool StrategySignal(const int st, const int i, const XExit &x, XSignal &sig) const
   {
      sig.Reset();
      if(i < 0 || i >= n) return false;
      const int fr = FilterReason(i);
      if(fr != XR_OK) { sig.reason = fr; return false; }
      const int d = StrategyDir(st, i);
      if(d == 0) { sig.reason = (cfg.d1_mode > 0 && StrategyDirRaw(st, i) != 0) ? XR_D1 : XR_NOSETUP; return false; }
      sig.dir = d;
      sig.primary = -1;
      sig.n_agree = (d > 0) ? m_nal[i] : m_nas[i];
      sig.mask = (d > 0) ? m_mkl[i] : m_mks[i];
      sig.score = (d > 0) ? m_scl[i] : m_scs[i];
      sig.score_opp = (d > 0) ? m_scs[i] : m_scl[i];
      sig.grade = 1;
      if(sig.score >= cfg.score_min + cfg.grade_a_add) sig.grade = 2;
      if(sig.score >= cfg.score_min + cfg.grade_ap_add && sig.n_agree >= 3) sig.grade = 3;
      if(!BuildPlanEx(i, d, sig, x.sl_min_atr, x.sl_max_atr, x.tp1_r, (x.tp2_r > 0.0) ? x.tp2_r : ((x.part >= 0.999) ? x.tp1_r : 0.0)))
      { sig.dir = 0; if(sig.reason != XR_COST) sig.reason = XR_SL_WIDE; return false; }
      sig.reason = XR_OK;
      return true;
   }

   //--- Strategy Lab ----------------------------------------------------
   // Every (strategy, exit profile) pair is traded through the loaded history, one trade at a time.
   // The auto-pick is chosen WALK-FORWARD: for each of the later folds it is chosen using only the folds
   // before it, and only its trades inside that later fold are counted. lab_auto is therefore an honest,
   // out-of-sample record of "let the lab choose", not the flattering record of the best cell.
   XLabCell lab[XLAB_CELLS];
   XStats   lab_auto;          // walk-forward record of the auto-pick process
   int      lab_auto_folds;    // folds in which a qualified pick existed
   int      lab_pick_s, lab_pick_p;   // current pick (-1 = nothing qualified)
   int      lab_qualified;     // cells that qualify on the whole history
   int      lab_first, lab_last;
   double   lab_target;        // win-rate target in % used for the last run
   // selection rules (tested variants: see research/results)
   double   lab_buffer;        // in-sample win rate must beat the target by this many points (room for out-of-sample decay)
   int      lab_window;        // folds of history the choice looks at (0 = everything before)
   int      lab_recent;        // 1 = the cell must also be profitable in the most recent fold
   double   lab_se_k;          // expectancy must stay positive after subtracting this many standard errors
   int      lab_bounds[16];
   int      lab_k;
   XIARR(m_lt_e); XDARR(m_lt_r); XIARR(m_lt_b); XIARR(m_lt_cnt);

   bool LabQualifies(const XStats &st, const double win_target, const int min_trades) const
   {
      if(st.n < min_trades) return false;
      if(st.WinRate() < win_target) return false;
      return (st.Expectancy() - lab_se_k * st.ExpStdErr()) > 0.0;
   }

   double LabScore(const XStats &st) const { return st.Expectancy() - lab_se_k * st.ExpStdErr(); }

   void RunLab(const int from_i, const int last_closed, const double win_target, const int min_trades, const int folds)
   {
      lab_target = win_target;
      lab_auto.Reset(); lab_auto_folds = 0; lab_pick_s = -1; lab_pick_p = -1; lab_qualified = 0;
      const int start = XMaxI(from_i, cfg.warmup + 10);
      lab_first = start; lab_last = last_closed;
      ArrayResize(m_lt_e, XLAB_CELLS * XLAB_MAXTR);
      ArrayResize(m_lt_r, XLAB_CELLS * XLAB_MAXTR);
      ArrayResize(m_lt_b, XLAB_CELLS * XLAB_MAXTR);
      ArrayResize(m_lt_cnt, XLAB_CELLS);
      const int recent_from = start + (int)(0.6 * (last_closed - start));
      XSignal sg;
      XTradeResult r;
      for(int c = 0; c < XLAB_CELLS; c++)
      {
         lab[c].Reset();
         m_lt_cnt[c] = 0;
         const int st = c / XP_COUNT, pr = c % XP_COUNT;
         XExit x;
         XMakeExit(pr, cfg, x);
         int busy = -1;
         for(int i = start; i < last_closed; i++)
         {
            if(i <= busy) continue;
            if(StrategyDir(st, i) == 0) continue;               // cheap test first
            if(!StrategySignal(st, i, x, sg)) continue;
            if(!SimulateTradeEx(i, sg.dir, sg.sl, last_closed, x, r)) continue;
            busy = r.exit_idx;
            if(!r.closed) continue;
            lab[c].all.Add(r);
            if(i >= recent_from) lab[c].recent.Add(r);
            if(m_lt_cnt[c] < XLAB_MAXTR)
            {
               const int k = c * XLAB_MAXTR + m_lt_cnt[c];
               m_lt_e[k] = i; m_lt_r[k] = r.r_net; m_lt_b[k] = r.bars;
               m_lt_cnt[c]++;
            }
         }
         lab[c].score = LabScore(lab[c].all);
      }
      // walk-forward record of the auto-pick
      const int K = XClampI(folds, 2, 15);
      lab_k = K;
      for(int k = 0; k <= K; k++) lab_bounds[k] = start + (int)((double)k * (last_closed - start) / K);
      // PASS = eligible for the live pick right now (same rule as the pick, so PASS and PROVEN always agree)
      for(int c = 0; c < XLAB_CELLS; c++)
      {
         double sc0;
         lab[c].qualified = CellEligible(c, K, win_target, min_trades, sc0);
         if(lab[c].qualified) lab_qualified++;
      }
      for(int k = 1; k < K; k++)
      {
         const int f0 = lab_bounds[k];
         const int f1 = lab_bounds[k + 1];
         const int best = LabPickFold(k, win_target, min_trades);
         if(best < 0) continue;
         lab_auto_folds++;
         for(int q = 0; q < m_lt_cnt[best]; q++)
         {
            const int kk = best * XLAB_MAXTR + q;
            if(m_lt_e[kk] < f0 || m_lt_e[kk] >= f1) continue;
            XTradeResult t;
            t.Reset();
            t.r_net = m_lt_r[kk]; t.bars = m_lt_b[kk]; t.mfe_r = 0.0;
            lab_auto.Add(t);
         }
      }
      // the pick for live trading: same rule, with everything up to now
      const int now = LabPickFold(K, win_target, min_trades);
      if(now >= 0) { lab_pick_s = now / XP_COUNT; lab_pick_p = now % XP_COUNT; }
   }

   // Best qualifying cell for trading fold k, looking only at trades that ENTERED before fold k starts
   // (k = lab_k means "now"). -1 when nothing qualifies.
   int LabPickFold(const int k, const double win_target, const int min_trades) const
   {
      int best = -1;
      double best_sc = -1e9;
      for(int c = 0; c < XLAB_CELLS; c++)
      {
         double sc;
         if(!CellEligible(c, k, win_target, min_trades, sc)) continue;
         if(sc > best_sc) { best_sc = sc; best = c; }
      }
      return best;
   }

   // Could cell c be picked for fold k (k = lab_k: now)? Uses trades that entered before the fold only.
   bool CellEligible(const int c, const int k, const double win_target, const int min_trades, double &sc) const
   {
      sc = -1e9;
      const int before = (k >= lab_k) ? lab_last + 1 : lab_bounds[k];
      const int from = (lab_window > 0) ? lab_bounds[XMaxI(0, k - lab_window)] : lab_bounds[0];
      const int rec_from = lab_bounds[XMaxI(0, k - 1)];
      XStats st, rc;
      st.Reset(); rc.Reset();
      for(int q = 0; q < m_lt_cnt[c]; q++)
      {
         const int kk = c * XLAB_MAXTR + q;
         if(m_lt_e[kk] >= before) break;
         if(m_lt_e[kk] < from) continue;
         XTradeResult t;
         t.Reset();
         t.r_net = m_lt_r[kk]; t.bars = m_lt_b[kk];
         st.Add(t);
         if(m_lt_e[kk] >= rec_from) rc.Add(t);
      }
      if(!LabQualifies(st, win_target + lab_buffer, min_trades)) return false;
      if(lab_recent == 1 && rc.n >= 5 && rc.Expectancy() <= 0.0) return false;
      sc = LabScore(st);
      return true;
   }

   // The cell the tools should use. proven = it passed the lab. Otherwise the best cell that at least reaches the
   // win-rate target (or simply the best cell) is returned as UNPROVEN. -1 = nothing has enough trades yet.
   int LabActiveCell(const int min_trades, bool &proven) const
   {
      proven = false;
      if(lab_pick_s >= 0) { proven = true; return lab_pick_s * XP_COUNT + lab_pick_p; }
      int best = -1;
      double sc = -1e9;
      for(int c = 0; c < XLAB_CELLS; c++)
         if(lab[c].all.n >= min_trades && lab[c].all.WinRate() >= lab_target && lab[c].score > sc) { sc = lab[c].score; best = c; }
      if(best >= 0) return best;
      for(int c = 0; c < XLAB_CELLS; c++)
         if(lab[c].all.n >= min_trades && lab[c].score > sc) { sc = lab[c].score; best = c; }
      return best;
   }

   // k-th cell of the leaderboard (0 = best): the live pick first, then qualified cells, then by score.
   int LabRanked(const int k) const
   {
      bool used[XLAB_CELLS];
      for(int c = 0; c < XLAB_CELLS; c++) used[c] = false;
      int pick = (lab_pick_s >= 0) ? lab_pick_s * XP_COUNT + lab_pick_p : -1;
      int res = -1;
      for(int r = 0; r <= k; r++)
      {
         res = -1;
         double best = -1e18;
         for(int c = 0; c < XLAB_CELLS; c++)
         {
            if(used[c] || lab[c].all.n < 1) continue;
            double key = lab[c].score + (lab[c].qualified ? 1000.0 : 0.0) + ((c == pick) ? 1e6 : 0.0);
            if(key > best) { best = key; res = c; }
         }
         if(res < 0) return -1;
         used[res] = true;
      }
      return res;
   }

   // Median bars a trade of cell c lasted (for "how long to stay").
   int LabHoldMedian(const int c) const
   {
      if(c < 0 || c >= XLAB_CELLS) return 0;
      return lab[c].all.HoldPct(false, 0.5);
   }

   //--- forecast --------------------------------------------------------
   // Expected-value path for the next `steps` bars, starting at start_price.
   // ref_i = last CLOSED bar whose indicators/score seed the drift.
   void Forecast(const int ref_i, const double start_price, const datetime t_first, const int steps)
   {
      fc_n = 0;
      if(ref_i < cfg.warmup || ref_i >= n || steps < 1) return;
      ArrayResize(fc_t, steps); ArrayResize(fc_o, steps); ArrayResize(fc_h, steps);
      ArrayResize(fc_l, steps); ArrayResize(fc_c, steps); ArrayResize(fc_up, steps); ArrayResize(fc_dn, steps);
      const double a = m_atr[ref_i];
      const double e = m_ema1[ref_i];
      // calibrate the cone on how wrong this very drift model has been over the last 100 bars
      double se = 0.0;
      int ne = 0;
      for(int k = XMaxI(cfg.warmup, ref_i - 100); k < ref_i; k++)
      {
         const double ex = m_atr[k] * XClamp(m_snet[k] / 3.0, -1.0, 1.0) * cfg.fc_drift;
         const double er1 = (m_c[k + 1] - m_c[k]) - ex;
         se += er1 * er1;
         ne++;
      }
      fc_rmse = (ne >= 20) ? MathSqrt(se / ne) : 0.63 * a;
      fc_nomap = (m_er[ref_i] < cfg.fc_er_min) || (m_atrref[ref_i] > 0.0 && a / m_atrref[ref_i] > cfg.atr_ratio_max);
      const double dir_s = fc_nomap ? 0.0 : XClamp(m_snet[ref_i] / 3.0, -1.0, 1.0);
      fc_drift_atr = dir_s * cfg.fc_drift;
      const double mr = fc_nomap ? 0.0 : ((m_adx[ref_i] < 20.0) ? cfg.fc_mr : cfg.fc_mr * 0.4);
      double px = start_price;
      double decay = 1.0;
      for(int j = 0; j < steps; j++)
      {
         const datetime tj = t_first + (datetime)j * cfg.base_sec;
         const double sea = SeasonAt(tj);
         const double move = a * (fc_drift_atr * decay) - mr * (px - e);
         const double o = px;
         const double c = px + move;
         const double rng = XMax(a * sea, XAbs(c - o));
         const double wick = XMax(0.5 * (rng - XAbs(c - o)), 0.1 * rng);
         fc_t[j] = tj;
         fc_o[j] = o;
         fc_c[j] = c;
         fc_h[j] = XMax(o, c) + wick;
         fc_l[j] = XMin(o, c) - wick;
         const double sigma = fc_rmse * sea * MathSqrt((double)(j + 1));
         fc_up[j] = c + sigma;
         fc_dn[j] = c - sigma;
         px = c;
         decay *= cfg.fc_decay;
      }
      fc_n = steps;
   }

   //--- calibrated projection ---------------------------------------------
   // Learn, from the `lookback` bars that closed before last_closed, how far price really moved s bars ahead
   // (in units of ATR x hour profile) and how big candles really were compared with ATR x hour profile.
   void CalibrateForecast(const int last_closed, const int lookback)
   {
      fc_cal_ok = false;
      const int from = XMaxI(cfg.warmup + 1, last_closed - lookback - XA_H);
      const int cnt = last_closed - XA_H - from;
      if(cnt < 300) return;
      XDARR(v);
      ArrayResize(v, cnt);
      for(int s = 1; s <= XA_H; s++)
      {
         int m = 0;
         for(int i = from; i < last_closed - XA_H && m < cnt; i++)
         {
            double pv = 0.0;
            for(int k = 1; k <= s; k++) { const double se = SeasonAt(m_t[i + k]); pv += se * se; }
            v[m++] = (m_c[i + s] - m_c[i]) / (XMax(m_atr[i], 1e-9) * MathSqrt(pv));
         }
         ArrayResize(v, m);
         ArraySort(v);
         fcz_lo[s - 1] = v[(int)(0.2 * (m - 1))];
         fcz_md[s - 1] = v[m / 2];
         fcz_hi[s - 1] = v[(int)(0.8 * (m - 1))];
         ArrayResize(v, cnt);
      }
      int m = 0;
      for(int i = from; i < last_closed && m < cnt; i++)
      {
         const double d = XMax(m_atr[i], 1e-9) * SeasonAt(m_t[i + 1]);
         v[m++] = (m_h[i + 1] - m_l[i + 1]) / d;
      }
      ArrayResize(v, m);
      ArraySort(v);
      fc_krange = XClamp(v[m / 2], 0.3, 3.0);
      fc_cal_ok = true;
   }

   // Calibrated projection for `steps` bars after the live price: median path, 20-80% cone and expected
   // high-low of each bar. ref_i = last closed bar (its ATR scales everything).
   void ForecastRange(const int ref_i, const double price_now, const datetime t_first, const int steps)
   {
      rg_n = 0;
      if(!fc_cal_ok || ref_i < 0 || ref_i >= n || steps < 1) return;
      const int cnt = XMinI(steps, XA_H);
      ArrayResize(rg_t, cnt); ArrayResize(rg_mid, cnt); ArrayResize(rg_up, cnt); ArrayResize(rg_dn, cnt); ArrayResize(rg_size, cnt);
      const double a = m_atr[ref_i];
      double pv = 0.0;
      for(int j = 0; j < cnt; j++)
      {
         const datetime tj = t_first + (datetime)j * cfg.base_sec;
         const double se = SeasonAt(tj);
         pv += se * se;
         const double sc = a * MathSqrt(pv);
         rg_t[j] = tj;
         rg_mid[j] = price_now + fcz_md[j] * sc;
         rg_up[j] = price_now + fcz_hi[j] * sc;
         rg_dn[j] = price_now + fcz_lo[j] * sc;
         rg_size[j] = a * se * fc_krange;
      }
      rg_n = cnt;
   }

   //--- analog forecaster ------------------------------------------------
   // Describe the situation at closed bar i as XA_F numbers. Uses only data <= i.
   void ComputeAnalog()
   {
      ArrayResize(m_feat, n * XA_F);
      ArrayResize(m_fut, n * XA_H * 4);
      ArrayResize(m_aw, XA_F);
      ArrayInitialize(m_feat, 0.0);
      ArrayInitialize(m_fut, 0.0);
      // weights (squared below): candle shape recent > older, context 1, votes strongest
      for(int f = 0; f < XA_F; f++) m_aw[f] = 1.0;
      for(int k = 0; k < 3; k++)
      {
         const double wk = (k == 0) ? 0.6 : ((k == 1) ? 0.4 : 0.3);
         m_aw[k * 4 + 0] = wk; m_aw[k * 4 + 1] = wk; m_aw[k * 4 + 2] = wk * 0.6; m_aw[k * 4 + 3] = wk * 0.6;
      }
      m_aw[14] = 0.6; m_aw[20] = 0.6; m_aw[22] = 0.6; m_aw[23] = 0.7; m_aw[24] = 0.7; m_aw[26] = 0.5; m_aw[27] = 0.6; m_aw[28] = 0.6;
      for(int f = 29; f < XA_F; f++) m_aw[f] = 1.2;
      for(int f = 0; f < XA_F; f++) m_aw[f] = m_aw[f] * m_aw[f];

      for(int i = cfg.warmup; i < n; i++)
      {
         const double a = m_atr[i];
         if(a <= 0.0) continue;
         const int b = i * XA_F;
         for(int k = 0; k < 3; k++)
         {
            const int x = i - k;
            const double rng = m_h[x] - m_l[x];
            m_feat[b + k * 4 + 0] = XClamp((m_c[x] - m_o[x]) / a, -2.0, 2.0);
            if(rng > 0.0)
            {
               m_feat[b + k * 4 + 1] = 2.0 * (m_c[x] - m_l[x]) / rng - 1.0;
               m_feat[b + k * 4 + 2] = (m_h[x] - XMax(m_o[x], m_c[x])) / rng;
               m_feat[b + k * 4 + 3] = (XMin(m_o[x], m_c[x]) - m_l[x]) / rng;
            }
         }
         m_feat[b + 12] = XClamp((m_c[i] - m_ema1[i]) / a, -4.0, 4.0) / 2.0;
         m_feat[b + 13] = XClamp((m_c[i] - m_ema2[i]) / a, -6.0, 6.0) / 3.0;
         m_feat[b + 14] = XClamp((m_c[i] - m_ema3[i]) / a, -12.0, 12.0) / 6.0;
         m_feat[b + 15] = XClamp((m_ema1[i] - m_ema1[i - 5]) / a, -2.0, 2.0);
         m_feat[b + 16] = (m_rsi[i] - 50.0) / 25.0;
         m_feat[b + 17] = m_er[i] * 2.0;
         m_feat[b + 18] = XClamp(m_adx[i] / 40.0, 0.0, 1.5);
         m_feat[b + 19] = (m_atrref[i] > 0.0) ? XClamp(a / m_atrref[i], 0.0, 3.0) - 1.0 : 0.0;
         m_feat[b + 20] = m_bbp[i];
         m_feat[b + 21] = (m_daybars[i] >= 15) ? XClamp((m_c[i] - m_vwap[i]) / a, -4.0, 4.0) / 2.0 : 0.0;
         m_feat[b + 22] = XClamp(m_adru[i], 0.0, 1.5);
         const double ang = 6.283185307179586 * m_hour[i] / 24.0;
         m_feat[b + 23] = MathSin(ang);
         m_feat[b + 24] = MathCos(ang);
         m_feat[b + 25] = (double)m_bias[i];
         m_feat[b + 26] = (double)m_inter[i];
         m_feat[b + 27] = (m_pdh[i] > 0.0) ? XClamp((m_pdh[i] - m_c[i]) / a, -3.0, 6.0) / 3.0 : 2.0;
         m_feat[b + 28] = (m_pdl[i] > 0.0) ? XClamp((m_c[i] - m_pdl[i]) / a, -3.0, 6.0) / 3.0 : 2.0;
         for(int m = 0; m < XM_COUNT; m++) m_feat[b + 29 + m] = m_vote[i * XM_COUNT + m];
         // what happened next, in ATR units relative to this bar's close (only where the future exists)
         if(i + XA_H < n)
         {
            for(int s = 1; s <= XA_H; s++)
            {
               const int x = i + s;
               const int o = (i * XA_H + (s - 1)) * 4;
               m_fut[o + 0] = (m_o[x] - m_c[i]) / a;
               m_fut[o + 1] = (m_h[x] - m_c[i]) / a;
               m_fut[o + 2] = (m_l[x] - m_c[i]) / a;
               m_fut[o + 3] = (m_c[x] - m_c[i]) / a;
            }
         }
      }
   }

   // Find the XA_K past situations most similar to closed bar q and summarise what followed.
   // Only situations whose future is fully known BEFORE q are eligible (no look-ahead).
   bool AnalogQuery(const int q, XAnalog &a) const
   {
      a.Reset();
      const int lib_first = cfg.warmup;
      const int lib_last = q - XA_H;
      if(q < 0 || q >= n || lib_last - lib_first < 250) return false;
      const int qb = q * XA_F;
      int bi[XA_K];
      double bd[XA_K];
      int cnt = 0;
      double worst = 1e300;
      for(int j = lib_first; j <= lib_last; j++)
      {
         const int jb = j * XA_F;
         double acc = 0.0;
         bool skip = false;
         for(int f = 0; f < XA_F; f++)
         {
            const double d = m_feat[jb + f] - m_feat[qb + f];
            acc += m_aw[f] * d * d;
            if(cnt == XA_K && acc >= worst) { skip = true; break; }
         }
         if(skip) continue;
         int pos = (cnt < XA_K) ? cnt : XA_K - 1;
         if(cnt < XA_K) cnt++;
         while(pos > 0 && bd[pos - 1] > acc) { bd[pos] = bd[pos - 1]; bi[pos] = bi[pos - 1]; pos--; }
         bd[pos] = acc; bi[pos] = j;
         if(cnt == XA_K) worst = bd[XA_K - 1];
      }
      if(cnt < XA_K) return false;

      double dsum = 0.0;
      for(int k = 0; k < cnt; k++) dsum += MathSqrt(bd[k]);
      a.mean_dist = dsum / cnt;
      a.k = cnt;
      a.atr = m_atr[q];
      double med[XA_H];
      for(int st = 0; st < XA_H; st++)
      {
         double v[XA_K];
         for(int k = 0; k < cnt; k++) v[k] = m_fut[(bi[k] * XA_H + st) * 4 + 3];
         for(int x = 1; x < cnt; x++)
         {
            const double key = v[x];
            int y = x - 1;
            while(y >= 0 && v[y] > key) { v[y + 1] = v[y]; y--; }
            v[y + 1] = key;
         }
         a.cq_lo[st] = v[(int)MathFloor(0.2 * (cnt - 1) + 0.5)];
         a.cq_md[st] = v[cnt / 2];
         a.cq_hi[st] = v[(int)MathFloor(0.8 * (cnt - 1) + 0.5)];
         med[st] = a.cq_md[st];
      }
      a.med1 = med[0]; a.med4 = med[3]; a.med8 = med[XA_H - 1];
      a.dir1 = (a.med1 > 0.0) ? 1 : ((a.med1 < 0.0) ? -1 : 0);
      a.dir4 = (a.med4 > 0.0) ? 1 : ((a.med4 < 0.0) ? -1 : 0);
      int ag1 = 0, ag4 = 0;
      for(int k = 0; k < cnt; k++)
      {
         const double m1 = m_fut[(bi[k] * XA_H + 0) * 4 + 3];
         const double m4 = m_fut[(bi[k] * XA_H + 3) * 4 + 3];
         if((m1 > 0.0 ? 1 : (m1 < 0.0 ? -1 : 0)) == a.dir1) ag1++;
         if((m4 > 0.0 ? 1 : (m4 < 0.0 ? -1 : 0)) == a.dir4) ag4++;
      }
      a.conf1 = (double)ag1 / cnt;
      a.conf4 = (double)ag4 / cnt;
      // most typical neighbour = the one whose path is closest to the median path
      double best = 1e300;
      for(int k = 0; k < cnt; k++)
      {
         double dev = 0.0;
         for(int st = 0; st < XA_H; st++) dev += XAbs(m_fut[(bi[k] * XA_H + st) * 4 + 3] - med[st]);
         if(dev < best) { best = dev; a.medoid = bi[k]; }
      }
      a.ok = true;
      return true;
   }

   bool AnalogConfident(const XAnalog &a) const
   {
      return a.ok && a.dir4 != 0 && a.conf4 >= cfg.an_conf && XAbs(a.med4) >= cfg.an_edge;
   }

   // Walk-forward audit: at each sampled past bar b, forecast using ONLY situations known before b,
   // then compare with what really happened. Tells the user how much to trust the picture.
   void AnalogAudit(const int q, const int span, const int stride, XAnalogAudit &r) const
   {
      r.Reset();
      const int b0 = XMaxI(cfg.warmup + XA_H + 260, q - span);
      XAnalog a;
      for(int b = b0; b + 4 <= q; b += stride)
      {
         if(!AnalogQuery(b, a)) continue;
         const double d1 = m_c[b + 1] - m_c[b];
         const double d4 = m_c[b + 4] - m_c[b];
         if(a.dir1 != 0 && d1 != 0.0)
         {
            r.n1++;
            const bool h1 = ((d1 > 0.0) == (a.dir1 > 0));
            if(h1) r.hit1++;
            if(a.conf1 >= cfg.an_conf) { r.nc1++; if(h1) r.hitc1++; }
         }
         if(a.dir4 != 0 && d4 != 0.0)
         {
            r.n4++;
            const bool h4 = ((d4 > 0.0) == (a.dir4 > 0));
            if(h4) r.hit4++;
            if(AnalogConfident(a)) { r.nc4++; if(h4) r.hitc4++; }
         }
      }
   }

   // Ghost candles = the real future candles of the most typical neighbour, scaled to today's ATR and
   // re-anchored on the current price (step 1 is the still-forming bar, so drawing starts at step 2).
   // The cone is the 20-80% spread of all neighbours.
   void ForecastAnalog(const XAnalog &a, const double price_now, const datetime t_first, const int steps)
   {
      fc_n = 0;
      if(!a.ok || a.medoid < 0 || steps < 1) return;
      const int cnt = XMinI(steps, XA_H - 1);
      ArrayResize(fc_t, cnt); ArrayResize(fc_o, cnt); ArrayResize(fc_h, cnt);
      ArrayResize(fc_l, cnt); ArrayResize(fc_c, cnt); ArrayResize(fc_up, cnt); ArrayResize(fc_dn, cnt);
      const double sc = a.atr;
      const int mo = a.medoid * XA_H;
      const double c1 = m_fut[(mo + 0) * 4 + 3];
      const double m1 = a.cq_md[0];
      for(int j = 0; j < cnt; j++)
      {
         const int st = j + 1;                          // 0-based step index (step 2 is the first future bar)
         const int o = (mo + st) * 4;
         const double base = price_now - c1 * sc;       // anchor so that step 1 ends at the live price
         fc_t[j] = t_first + (datetime)j * cfg.base_sec;
         fc_o[j] = base + m_fut[o + 0] * sc;
         fc_c[j] = base + m_fut[o + 3] * sc;
         fc_h[j] = XMax(base + m_fut[o + 1] * sc, XMax(fc_o[j], fc_c[j]));
         fc_l[j] = XMin(base + m_fut[o + 2] * sc, XMin(fc_o[j], fc_c[j]));
         fc_up[j] = price_now + (a.cq_hi[st] - m1) * sc;
         fc_dn[j] = price_now + (a.cq_lo[st] - m1) * sc;
      }
      fc_n = cnt;
   }

   // How often did the sign of the score predict the direction `horizon` bars later?
   void ForecastAudit(const int horizon, const double min_abs_score, const int from_i, const int last_closed,
                      int &n_tot, int &n_hit) const
   {
      n_tot = 0; n_hit = 0;
      const int start = XMaxI(from_i, cfg.warmup);
      for(int i = start; i + horizon <= last_closed; i++)
      {
         const double s = m_snet[i];
         if(XAbs(s) < min_abs_score) continue;
         const double mv = m_c[i + horizon] - m_c[i];
         if(mv == 0.0) continue;
         n_tot++;
         if((s > 0.0) == (mv > 0.0)) n_hit++;
      }
   }

private:
   void SizeArrays()
   {
      ArrayResize(m_ema1, n); ArrayResize(m_ema2, n); ArrayResize(m_ema3, n);
      ArrayResize(m_atr, n);  ArrayResize(m_atrref, n);
      ArrayResize(m_sma5, n); ArrayResize(m_rsi2, n);
      ArrayResize(m_rsi, n);  ArrayResize(m_adx, n);  ArrayResize(m_pdi, n); ArrayResize(m_mdi, n);
      ArrayResize(m_bbw, n);  ArrayResize(m_bbp, n);  ArrayResize(m_donh, n); ArrayResize(m_donl, n);
      ArrayResize(m_vavg, n); ArrayResize(m_vwap, n); ArrayResize(m_vsd, n);  ArrayResize(m_hour, n);
      ArrayResize(m_daybars, n); ArrayResize(m_asiaok, n); ArrayResize(m_asiahi, n); ArrayResize(m_asialo, n);
      ArrayResize(m_pdh, n);  ArrayResize(m_pdl, n);  ArrayResize(m_adr, n);  ArrayResize(m_adru, n);  ArrayResize(m_er, n);
      ArrayResize(m_hmap, n); ArrayResize(m_bias, n); ArrayResize(m_hadx, n);
      ArrayResize(m_imap, n); ArrayResize(m_inter, n);
      ArrayResize(m_vote, n * XM_COUNT);
      ArrayResize(m_orbhi, n); ArrayResize(m_orblo, n); ArrayResize(m_orbv, n); ArrayResize(m_orbst, n); ArrayResize(m_orbt0, n);
      ArrayResize(m_scl, n);  ArrayResize(m_scs, n);  ArrayResize(m_nal, n); ArrayResize(m_nas, n);
      ArrayResize(m_mkl, n);  ArrayResize(m_mks, n);  ArrayResize(m_snet, n);
   }

   void ComputeBaseIndicators()
   {
      XCalcEMA(m_c, m_ema1, n, cfg.ema1);
      XCalcEMA(m_c, m_ema2, n, cfg.ema2);
      XCalcEMA(m_c, m_ema3, n, cfg.ema3);
      XCalcATR(m_h, m_l, m_c, m_atr, n, cfg.atr_p);
      XCalcEMA(m_atr, m_atrref, n, 100);
      XCalcRSI(m_c, m_rsi, n, cfg.rsi_p);
      XCalcRSI(m_c, m_rsi2, n, 2);
      for(int i = 0; i < n; i++)
      {
         double sm = 0.0;
         const int a0 = XMaxI(0, i - 4);
         for(int k = a0; k <= i; k++) sm += m_c[k];
         m_sma5[i] = sm / (i - a0 + 1);
      }
      XCalcADX(m_h, m_l, m_c, m_pdi, m_mdi, m_adx, n, cfg.adx_p);

      // Bollinger bandwidth (relative) and its percentile over 100 bars
      for(int i = 0; i < n; i++)
      {
         m_bbw[i] = 0.0;
         if(i < cfg.bb_p - 1) continue;
         double sum = 0.0, sq = 0.0;
         for(int k = i - cfg.bb_p + 1; k <= i; k++) { sum += m_c[k]; sq += m_c[k] * m_c[k]; }
         const double mean = sum / cfg.bb_p;
         const double var = sq / cfg.bb_p - mean * mean;
         const double sd = MathSqrt(XMax(var, 0.0));
         m_bbw[i] = (mean > 0.0) ? 4.0 * sd / mean : 0.0;
      }
      for(int i = 0; i < n; i++)
      {
         const int a0 = XMaxI(0, i - 99);
         int below = 0, tot = 0;
         for(int k = a0; k <= i; k++) { tot++; if(m_bbw[k] <= m_bbw[i]) below++; }
         m_bbp[i] = (tot > 0) ? (double)below / tot : 0.5;
      }
      // Donchian (prior don_p bars, excluding the current bar) and average tick volume (prior 20)
      for(int i = 0; i < n; i++)
      {
         if(i < cfg.don_p) { m_donh[i] = m_h[i]; m_donl[i] = m_l[i]; }
         else
         {
            double hh = m_h[i - cfg.don_p], ll = m_l[i - cfg.don_p];
            for(int k = i - cfg.don_p + 1; k <= i - 1; k++) { if(m_h[k] > hh) hh = m_h[k]; if(m_l[k] < ll) ll = m_l[k]; }
            m_donh[i] = hh; m_donl[i] = ll;
         }
         if(i < 20) m_vavg[i] = 0.0;
         else
         {
            double sv = 0.0;
            for(int k = i - 20; k < i; k++) sv += m_v[k];
            m_vavg[i] = sv / 20.0;
         }
      }
      // Kaufman efficiency ratio: net move / path length over 30 bars (0 = pure chop, 1 = straight line)
      for(int i = 0; i < n; i++)
      {
         m_er[i] = 0.0;
         if(i < 30) continue;
         double path = 0.0;
         for(int k = i - 29; k <= i; k++) path += XAbs(m_c[k] - m_c[k - 1]);
         m_er[i] = (path > 0.0) ? XAbs(m_c[i] - m_c[i - 30]) / path : 0.0;
      }
      // intraday range seasonality by GMT hour
      double hs[24], hc[24];
      double allsum = 0.0; int allc = 0;
      for(int k = 0; k < 24; k++) { hs[k] = 0.0; hc[k] = 0.0; season[k] = 1.0; }
      if(cfg.base_sec <= 14400)
      {
         for(int i = 0; i < n; i++)
         {
            int hh = (int)XHourGmt(m_t[i], XOffsetAt(cfg, m_t[i]));
            if(hh < 0) hh = 0;
            if(hh > 23) hh = 23;
            hs[hh] += (m_h[i] - m_l[i]) / XMax(m_atrref[i], 1e-9);
            hc[hh] += 1.0;
            allsum += (m_h[i] - m_l[i]) / XMax(m_atrref[i], 1e-9); allc++;
         }
         const double gm = (allc > 0) ? allsum / allc : 1.0;
         for(int k = 0; k < 24; k++)
            if(hc[k] >= 5.0 && gm > 0.0) season[k] = XClamp((hs[k] / hc[k]) / gm, 0.5, 2.0);
      }
   }

   void ComputeSessionLevels()
   {
      long prev_day = -1, prev_cal = -1;
      double day_hi = 0.0, day_lo = 0.0, pdh_v = 0.0, pdl_v = 0.0;
      double a_hi = -1e18, a_lo = 1e18;
      int a_bars = 0;
      double ranges[14];
      int nr = 0, rpos = 0;
      double cpv = 0.0, cv = 0.0, cpp = 0.0;
      int bars_today = 0;
      const bool intraday = (cfg.base_sec <= 7200);
      for(int i = 0; i < n; i++)
      {
         const long tt = (long)m_t[i] - XOffsetAt(cfg, m_t[i]);
         const long day = (tt - (long)cfg.day_roll_hour * 3600) / 86400;
         const long cal = tt / 86400;
         long sec = tt % 86400;
         if(sec < 0) sec += 86400;
         const double hr = (double)sec / 3600.0;
         m_hour[i] = hr;

         if(day != prev_day)
         {
            if(prev_day != -1)
            {
               pdh_v = day_hi; pdl_v = day_lo;
               ranges[rpos] = day_hi - day_lo;
               rpos = (rpos + 1) % 14;
               if(nr < 14) nr++;
            }
            day_hi = m_h[i]; day_lo = m_l[i];
            cpv = 0.0; cv = 0.0; cpp = 0.0; bars_today = 0;
            prev_day = day;
         }
         else
         {
            if(m_h[i] > day_hi) day_hi = m_h[i];
            if(m_l[i] < day_lo) day_lo = m_l[i];
         }
         if(cal != prev_cal) { a_hi = -1e18; a_lo = 1e18; a_bars = 0; prev_cal = cal; }
         if(hr >= cfg.asia_start && hr < cfg.asia_end)
         {
            if(m_h[i] > a_hi) a_hi = m_h[i];
            if(m_l[i] < a_lo) a_lo = m_l[i];
            a_bars++;
         }
         m_asiaok[i] = (intraday && hr >= cfg.asia_end && a_bars >= 6) ? 1 : 0;
         m_asiahi[i] = a_hi; m_asialo[i] = a_lo;

         const double tp = (m_h[i] + m_l[i] + m_c[i]) / 3.0;
         const double vol = XMax(m_v[i], 1.0);
         cpv += tp * vol; cv += vol; cpp += tp * tp * vol; bars_today++;
         m_vwap[i] = cpv / cv;
         m_vsd[i] = MathSqrt(XMax(cpp / cv - m_vwap[i] * m_vwap[i], 0.0));
         m_daybars[i] = bars_today;

         m_pdh[i] = pdh_v; m_pdl[i] = pdl_v;
         double adr = 0.0;
         if(nr >= 5)
         {
            for(int k = 0; k < nr; k++) adr += ranges[k];
            adr /= nr;
         }
         m_adr[i] = adr;
         m_adru[i] = (adr > 0.0) ? (day_hi - day_lo) / adr : 0.0;
      }
   }

   void ComputeHTF()
   {
      // higher-timeframe bias
      if(hn > 0)
      {
         ArrayResize(m_hema2, hn); ArrayResize(m_hema3, hn);
         ArrayResize(m_hpdi, hn);  ArrayResize(m_hmdi, hn); ArrayResize(m_hadx0, hn); ArrayResize(m_hbias0, hn);
         XCalcEMA(m_hc, m_hema2, hn, cfg.ema2);
         XCalcEMA(m_hc, m_hema3, hn, cfg.ema3);
         XCalcADX(m_hh, m_hl, m_hc, m_hpdi, m_hmdi, m_hadx0, hn, cfg.adx_p);
         for(int j = 0; j < hn; j++)
         {
            int b = 0;
            if(j >= 220 && m_hadx0[j] >= cfg.htf_adx_min)
            {
               if(m_hema2[j] > m_hema3[j] && m_hc[j] > m_hema2[j]) b = 1;
               else if(m_hema2[j] < m_hema3[j] && m_hc[j] < m_hema2[j]) b = -1;
            }
            m_hbias0[j] = b;
         }
         XMapTF(m_t, n, cfg.base_sec, m_ht, hn, cfg.htf_sec, m_hmap);
         for(int i = 0; i < n; i++)
         {
            const int j = m_hmap[i];
            m_bias[i] = (j >= 0) ? m_hbias0[j] : 0;
            m_hadx[i] = (j >= 0) ? m_hadx0[j] : 0.0;
         }
      }
      else
      {
         for(int i = 0; i < n; i++) { m_hmap[i] = -1; m_bias[i] = 0; m_hadx[i] = 0.0; }
      }
      // intermarket proxy (optional)
      if(in_n > 60)
      {
         ArrayResize(m_iema1, in_n); ArrayResize(m_iema2, in_n); ArrayResize(m_idir0, in_n);
         XCalcEMA(m_ic, m_iema1, in_n, 20);
         XCalcEMA(m_ic, m_iema2, in_n, 50);
         for(int j = 0; j < in_n; j++)
         {
            int d = 0;
            if(j >= 60)
            {
               if(m_iema1[j] > m_iema2[j] && m_ic[j] > m_iema1[j]) d = 1;
               else if(m_iema1[j] < m_iema2[j] && m_ic[j] < m_iema1[j]) d = -1;
            }
            m_idir0[j] = inter_invert ? -d : d;
         }
         XMapTF(m_t, n, cfg.base_sec, m_it, in_n, cfg.base_sec, m_imap);
         for(int i = 0; i < n; i++) m_inter[i] = (m_imap[i] >= 0) ? m_idir0[m_imap[i]] : 0;
      }
      else
      {
         for(int i = 0; i < n; i++) { m_imap[i] = -1; m_inter[i] = 0; }
      }
   }

   //--- strategy modules -----------------------------------------------
   double VotePullback(const int i) const
   {
      const int b = m_bias[i];
      const double a = m_atr[i];
      const double rng = m_h[i] - m_l[i];
      if(b == 0 || a <= 0.0 || rng <= 0.0) return 0.0;
      if(m_adx[i] < cfg.pb_adx_min) return 0.0;
      double s = 0.55;
      if(m_adx[i] > 22.0) s += 0.15;
      if(m_hadx[i] > 25.0) s += 0.15;
      if(b > 0)
      {
         if(!(m_ema1[i] > m_ema2[i] && m_c[i] > m_ema3[i])) return 0.0;
         const double lo5 = LowestLow(i - 4, i);
         if(!(lo5 <= m_ema1[i] + 0.25 * a)) return 0.0;
         if(!(lo5 >= m_ema2[i] - 0.6 * a)) return 0.0;
         if(!(m_c[i] > m_ema1[i] && m_c[i] > m_o[i])) return 0.0;
         if(!(m_rsi[i] > m_rsi[i - 1] && MinRsi(i - 5, i) < 50.0 && m_rsi[i] < 68.0)) return 0.0;
         const double lw = XMin(m_o[i], m_c[i]) - m_l[i];
         if(!(lw >= 0.35 * rng || (m_c[i] - m_l[i]) >= 0.65 * rng)) return 0.0;
         if(lw >= 0.5 * rng) s += 0.15;
         return XMin(s, 1.0);
      }
      if(!(m_ema1[i] < m_ema2[i] && m_c[i] < m_ema3[i])) return 0.0;
      const double hi5 = HighestHigh(i - 4, i);
      if(!(hi5 >= m_ema1[i] - 0.25 * a)) return 0.0;
      if(!(hi5 <= m_ema2[i] + 0.6 * a)) return 0.0;
      if(!(m_c[i] < m_ema1[i] && m_c[i] < m_o[i])) return 0.0;
      if(!(m_rsi[i] < m_rsi[i - 1] && MaxRsi(i - 5, i) > 50.0 && m_rsi[i] > 32.0)) return 0.0;
      const double uw = m_h[i] - XMax(m_o[i], m_c[i]);
      if(!(uw >= 0.35 * rng || (m_h[i] - m_c[i]) >= 0.65 * rng)) return 0.0;
      if(uw >= 0.5 * rng) s += 0.15;
      return -XMin(s, 1.0);
   }

   double VoteSweep(const int i) const
   {
      const double a = m_atr[i];
      const double rng = m_h[i] - m_l[i];
      if(a <= 0.0 || rng <= 0.0) return 0.0;
      const double dl = 0.03 * a;
      // candidate levels below / above price
      double lo_lv[3], hi_lv[3];
      int nlo = 0, nhi = 0;
      if(m_pdl[i] > 0.0) { lo_lv[nlo] = m_pdl[i]; nlo++; }
      if(m_pdh[i] > 0.0) { hi_lv[nhi] = m_pdh[i]; nhi++; }
      if(m_asiaok[i] == 1) { lo_lv[nlo] = m_asialo[i]; nlo++; hi_lv[nhi] = m_asiahi[i]; nhi++; }
      lo_lv[nlo] = LowestLow(i - 30, i - 2);  nlo++;
      hi_lv[nhi] = HighestHigh(i - 30, i - 2); nhi++;

      int hits_l = 0, hits_s = 0;
      const double lw = XMin(m_o[i], m_c[i]) - m_l[i];
      const double uw = m_h[i] - XMax(m_o[i], m_c[i]);
      const double lo2 = XMin(m_l[i], m_l[i - 1]);
      const double hi2 = XMax(m_h[i], m_h[i - 1]);
      for(int k = 0; k < nlo; k++)
      {
         const double L = lo_lv[k];
         const bool one = (m_l[i] < L - dl && m_c[i] > L && lw >= 0.4 * rng);
         const bool two = (lo2 < L - dl && m_c[i - 1] <= L + 0.05 * a && m_c[i] > L && m_c[i] > m_o[i] && (m_c[i] - m_o[i]) >= 0.4 * a);
         if(one || two) hits_l++;
      }
      for(int k = 0; k < nhi; k++)
      {
         const double L = hi_lv[k];
         const bool one = (m_h[i] > L + dl && m_c[i] < L && uw >= 0.4 * rng);
         const bool two = (hi2 > L + dl && m_c[i - 1] >= L - 0.05 * a && m_c[i] < L && m_c[i] < m_o[i] && (m_o[i] - m_c[i]) >= 0.4 * a);
         if(one || two) hits_s++;
      }
      if(hits_l == 0 && hits_s == 0) return 0.0;
      const bool longside = (hits_l >= hits_s);
      const int hits = longside ? hits_l : hits_s;
      double s = 0.55;
      if(Spike(i)) s += 0.15;
      if((longside ? lw : uw) >= 0.55 * rng) s += 0.15;
      if(hits >= 2) s += 0.15;
      s = XMin(s, 1.0);
      return longside ? s : -s;
   }

   // state carried between bars: index of the first close outside the Asian range today
   double VoteBreakout(const int i, const int bk_up_bar, const int bk_dn_bar) const
   {
      if(m_asiaok[i] == 0 || m_adr[i] <= 0.0) return 0.0;
      const double a = m_atr[i];
      if(a <= 0.0) return 0.0;
      if(m_hour[i] >= cfg.trade_end) return 0.0;
      const double arange = m_asiahi[i] - m_asialo[i];
      if(arange > cfg.asia_compress * m_adr[i]) return 0.0;
      const double body = XAbs(m_c[i] - m_o[i]);
      const double rng = m_h[i] - m_l[i];
      if(rng <= 0.0 || body < 0.6 * a || body < 0.55 * rng) return 0.0;
      double s = 0.6;
      if(m_vavg[i] > 0.0 && m_v[i] > 1.5 * m_vavg[i]) s += 0.2;
      if(body >= 1.0 * a) s += 0.2;
      if(m_c[i] > m_asiahi[i] + 0.1 * a && m_c[i] > m_o[i] && bk_up_bar >= 0 && i - bk_up_bar <= 6) return s;
      if(m_c[i] < m_asialo[i] - 0.1 * a && m_c[i] < m_o[i] && bk_dn_bar >= 0 && i - bk_dn_bar <= 6) return -s;
      return 0.0;
   }

   double VoteSqueeze(const int i) const
   {
      const double a = m_atr[i];
      if(a <= 0.0) return 0.0;
      double mn = 1.0;
      for(int k = i - 6; k <= i - 1; k++) if(m_bbp[k] < mn) mn = m_bbp[k];
      if(mn > 0.25) return 0.0;
      if(!(m_adx[i] > m_adx[i - 1])) return 0.0;
      const double body = XAbs(m_c[i] - m_o[i]);
      if(body < 0.5 * a) return 0.0;
      double s = 0.55;
      if(m_adx[i] > 20.0) s += 0.2;
      if(Spike(i)) s += 0.25;
      s = XMin(s, 1.0);
      if(m_c[i] > m_donh[i] && m_c[i] > m_o[i]) return s;
      if(m_c[i] < m_donl[i] && m_c[i] < m_o[i]) return -s;
      return 0.0;
   }

   double VoteVwap(const int i) const
   {
      const double a = m_atr[i];
      const double rng = m_h[i] - m_l[i];
      if(a <= 0.0 || rng <= 0.0 || m_daybars[i] < 15 || m_vsd[i] <= 0.0) return 0.0;
      if(m_adx[i] >= 20.0) return 0.0;
      const double up = m_vwap[i] + 2.0 * m_vsd[i];
      const double dn = m_vwap[i] - 2.0 * m_vsd[i];
      const double uw = m_h[i] - XMax(m_o[i], m_c[i]);
      const double lw = XMin(m_o[i], m_c[i]) - m_l[i];
      if(m_h[i] > up && m_c[i] < m_o[i] && uw >= 0.35 * rng)
      {
         double s = 0.6;
         if(m_rsi[i] > 65.0) s += 0.2;
         if(m_c[i] < up) s += 0.2;
         return -XMin(s, 1.0);
      }
      if(m_l[i] < dn && m_c[i] > m_o[i] && lw >= 0.35 * rng)
      {
         double s = 0.6;
         if(m_rsi[i] < 35.0) s += 0.2;
         if(m_c[i] > dn) s += 0.2;
         return XMin(s, 1.0);
      }
      return 0.0;
   }

   double VoteRound(const int i) const
   {
      const double a = m_atr[i];
      const double rng = m_h[i] - m_l[i];
      if(a <= 0.0 || rng <= 0.0 || cfg.round_step <= 0.0) return 0.0;
      const double lw = XMin(m_o[i], m_c[i]) - m_l[i];
      const double uw = m_h[i] - XMax(m_o[i], m_c[i]);
      // long: wick pierces a round number from above and closes back over it
      double lv = MathFloor(m_l[i] / cfg.round_step + 0.5) * cfg.round_step;
      if(m_l[i] <= lv + 0.1 * a && m_l[i] >= lv - 0.35 * a && m_c[i] > lv && m_c[i] > m_o[i] && lw >= 0.4 * rng)
         return (MathMod(lv, 50.0) < 1e-6) ? 0.6 : 0.4;
      lv = MathFloor(m_h[i] / cfg.round_step + 0.5) * cfg.round_step;
      if(m_h[i] >= lv - 0.1 * a && m_h[i] <= lv + 0.35 * a && m_c[i] < lv && m_c[i] < m_o[i] && uw >= 0.4 * rng)
         return (MathMod(lv, 50.0) < 1e-6) ? -0.6 : -0.4;
      return 0.0;
   }

   //--- opening range breakout (port of GOLD_ORB) -------------------------
   // Range = first `orb_range_min` minutes after the daily open (server clock). Each side then stays
   // open for extension until it has been quiet for `orb_settle_min`; only a FINAL side can break.
   // Signal: a closed candle in the breakout direction whose close is beyond the final level;
   // at most one long and one short per session. Long wicks (> orb_wick_atr x ATR) are ignored.
   void ComputeOrb()
   {
      const int settle = XMaxI(1, (int)MathCeil(cfg.orb_settle_min * 60.0 / (cfg.base_sec > 0 ? cfg.base_sec : 900)));
      const long range_sec = (long)cfg.orb_range_min * 60;
      int phase = 0;
      datetime t0 = 0;
      double o_first = 0.0, c_last = 0.0, hh = 0.0, ll = 0.0;
      double hi_w = 0.0, hi_b = 0.0, lo_w = 0.0, lo_b = 0.0;
      int cnt_hi = 0, cnt_lo = 0;
      bool long_done = false, short_done = false;
      double prev_sh = -1.0;
      long prev_day = -1;
      const double eps = 0.1;
      for(int i = 0; i < n; i++)
      {
         m_orbv[i] = 0.0; m_orbhi[i] = 0.0; m_orblo[i] = 0.0; m_orbst[i] = 0; m_orbt0[i] = 0;
         const long tl = (long)m_t[i];
         const double sh = (double)(tl % 86400) / 3600.0;
         const long day = tl / 86400;
         const bool new_session = (cfg.base_sec <= 3600 * 4 && sh >= cfg.orb_start_hour && (day != prev_day || prev_sh < cfg.orb_start_hour));
         prev_sh = sh; prev_day = day;
         if(new_session)
         {
            phase = 1; t0 = m_t[i];
            o_first = m_o[i]; c_last = m_c[i]; hh = m_h[i]; ll = m_l[i];
            cnt_hi = 0; cnt_lo = 0; long_done = false; short_done = false;
         }
         else if(phase == 1)
         {
            if(tl < (long)t0 + range_sec) { if(m_h[i] > hh) hh = m_h[i]; if(m_l[i] < ll) ll = m_l[i]; c_last = m_c[i]; }
            else
            {
               const double wmax = cfg.orb_wick_atr * m_atr[XMaxI(i - 1, 0)];
               const double bhi = XMax(o_first, c_last), blo = XMin(o_first, c_last);
               hi_b = bhi; hi_w = (hh - bhi > wmax) ? bhi : hh;
               lo_b = blo; lo_w = (blo - ll > wmax) ? blo : ll;
               phase = 2; cnt_hi = 1; cnt_lo = 1;
            }
         }
         if(phase == 2 && !new_session)
         {
            const double a = m_atr[i];
            const double wmax = cfg.orb_wick_atr * a;
            const double bh = XMax(m_o[i], m_c[i]), bl = XMin(m_o[i], m_c[i]);
            const bool bull = (m_c[i] > m_o[i]);
            const bool bear = (m_c[i] < m_o[i]);
            if(cnt_hi <= settle)
            {
               if(m_h[i] > hi_w + eps && bh > hi_b + eps) { hi_b = bh; hi_w = (m_h[i] - bh > wmax) ? bh : m_h[i]; cnt_hi = 1; }
               else cnt_hi++;
            }
            if(cnt_lo <= settle)
            {
               if(m_l[i] < lo_w - eps && bl < lo_b - eps) { lo_b = bl; lo_w = (bl - m_l[i] > wmax) ? bl : m_l[i]; cnt_lo = 1; }
               else cnt_lo++;
            }
            const double body = bh - bl;
            double st = 0.65;
            if(a > 0.0 && body >= 1.0 * a) st += 0.2;
            if(Spike(i)) st += 0.15;
            st = XMin(st, 1.0);
            if(cnt_hi > settle && bull && bh > hi_w && !long_done)  { m_orbv[i] = st;  long_done = true; }
            else if(cnt_lo > settle && bear && bl < lo_w && !short_done) { m_orbv[i] = -st; short_done = true; }
         }
         if(phase >= 1)
         {
            m_orbt0[i] = t0;
            if(phase == 1) { m_orbst[i] = 1; m_orbhi[i] = hh; m_orblo[i] = ll; }
            else
            {
               m_orbhi[i] = hi_w; m_orblo[i] = lo_w;
               m_orbst[i] = (cnt_hi > settle && cnt_lo > settle) ? 3 : 2;
            }
         }
      }
   }

   void ComputeVotes()
   {
      ArrayInitialize(m_vote, 0.0);
      const int sp = 3;
      // FVG zones
      double bt_top[6], bt_bot[6], br_top[6], br_bot[6];
      int bt_n = 0, br_n = 0;
      int bt_age[6], br_age[6];
      // pivots: [0] older, [1] newer
      int pl_idx[2], ph_idx[2];
      double pl_px[2], pl_rsi[2], ph_px[2], ph_rsi[2];
      int pl_cnt = 0, ph_cnt = 0;
      for(int q = 0; q < 2; q++) { pl_idx[q] = 0; ph_idx[q] = 0; pl_px[q] = 0.0; pl_rsi[q] = 0.0; ph_px[q] = 0.0; ph_rsi[q] = 0.0; }
      int bull_arm = -1, bear_arm = -1;
      double bull_str = 0.0, bear_str = 0.0, bull_px = 0.0, bear_px = 0.0;
      long prev_cal = -1;
      int bk_up_bar = -1, bk_dn_bar = -1;

      for(int i = 0; i < n; i++)
      {
         const bool live = (i >= cfg.warmup);
         const double a = m_atr[i];

         // Asian-range break state (reset each GMT calendar day)
         const long cal = ((long)m_t[i] - XOffsetAt(cfg, m_t[i])) / 86400;
         if(cal != prev_cal) { prev_cal = cal; bk_up_bar = -1; bk_dn_bar = -1; }
         if(m_asiaok[i] == 1)
         {
            if(bk_up_bar < 0 && m_c[i] > m_asiahi[i] + 0.1 * a) bk_up_bar = i;
            if(bk_dn_bar < 0 && m_c[i] < m_asialo[i] - 0.1 * a) bk_dn_bar = i;
         }

         // pivots confirmed sp bars after the fact
         const int k = i - sp;
         if(k >= sp + 1)
         {
            bool isPL = true, isPH = true;
            for(int q = 1; q <= sp; q++)
            {
               if(!(m_l[k] < m_l[k - q]))  isPL = false;
               if(!(m_l[k] <= m_l[k + q])) isPL = false;
               if(!(m_h[k] > m_h[k - q]))  isPH = false;
               if(!(m_h[k] >= m_h[k + q])) isPH = false;
            }
            if(isPL)
            {
               pl_idx[0] = pl_idx[1]; pl_px[0] = pl_px[1]; pl_rsi[0] = pl_rsi[1];
               pl_idx[1] = k; pl_px[1] = m_l[k]; pl_rsi[1] = m_rsi[k];
               if(pl_cnt < 2) pl_cnt++;
               if(live && pl_cnt >= 2)
               {
                  const int gap = pl_idx[1] - pl_idx[0];
                  if(pl_px[1] < pl_px[0] - 0.1 * a && pl_rsi[1] > pl_rsi[0] + 3.0 && pl_rsi[0] < 45.0 && gap >= 5 && gap <= 80)
                  {
                     bull_arm = i + 4;
                     bull_str = 0.55 + (((pl_rsi[1] - pl_rsi[0]) >= 8.0) ? 0.25 : 0.0);
                     bull_px = pl_px[1];
                  }
               }
            }
            if(isPH)
            {
               ph_idx[0] = ph_idx[1]; ph_px[0] = ph_px[1]; ph_rsi[0] = ph_rsi[1];
               ph_idx[1] = k; ph_px[1] = m_h[k]; ph_rsi[1] = m_rsi[k];
               if(ph_cnt < 2) ph_cnt++;
               if(live && ph_cnt >= 2)
               {
                  const int gap = ph_idx[1] - ph_idx[0];
                  if(ph_px[1] > ph_px[0] + 0.1 * a && ph_rsi[1] < ph_rsi[0] - 3.0 && ph_rsi[0] > 55.0 && gap >= 5 && gap <= 80)
                  {
                     bear_arm = i + 4;
                     bear_str = 0.55 + (((ph_rsi[0] - ph_rsi[1]) >= 8.0) ? 0.25 : 0.0);
                     bear_px = ph_px[1];
                  }
               }
            }
         }

         double vdiv = 0.0;
         if(live)
         {
            if(bull_arm >= i)
            {
               if(m_l[i] < bull_px - 0.25 * a) bull_arm = -1;
               else if(m_c[i] > m_o[i] && m_c[i] > m_c[i - 1]) { vdiv = bull_str; bull_arm = -1; }
            }
            if(bear_arm >= i)
            {
               if(m_h[i] > bear_px + 0.25 * a) bear_arm = -1;
               else if(m_c[i] < m_o[i] && m_c[i] < m_c[i - 1]) { if(bear_str > XAbs(vdiv)) vdiv = -bear_str; bear_arm = -1; }
            }
         }

         // FVG: test existing zones first, then register a new one created on this bar
         double vfvg = 0.0;
         for(int z = 0; z < bt_n; )
         {
            bt_age[z]++;
            if(m_c[i] < bt_bot[z] || bt_age[z] > 40) { bt_n--; bt_top[z] = bt_top[bt_n]; bt_bot[z] = bt_bot[bt_n]; bt_age[z] = bt_age[bt_n]; continue; }
            if(live && m_l[i] <= bt_top[z] && m_l[i] >= bt_bot[z] - 0.2 * a && m_c[i] > 0.5 * (bt_top[z] + bt_bot[z]) && m_c[i] > m_o[i])
            {
               double s = 0.5;
               if(bt_top[z] - bt_bot[z] >= 0.5 * a) s += 0.25;
               if(Spike(i)) s += 0.25;
               if(s > vfvg) vfvg = s;
               bt_n--; bt_top[z] = bt_top[bt_n]; bt_bot[z] = bt_bot[bt_n]; bt_age[z] = bt_age[bt_n];
               continue;
            }
            z++;
         }
         for(int z = 0; z < br_n; )
         {
            br_age[z]++;
            if(m_c[i] > br_top[z] || br_age[z] > 40) { br_n--; br_top[z] = br_top[br_n]; br_bot[z] = br_bot[br_n]; br_age[z] = br_age[br_n]; continue; }
            if(live && m_h[i] >= br_bot[z] && m_h[i] <= br_top[z] + 0.2 * a && m_c[i] < 0.5 * (br_top[z] + br_bot[z]) && m_c[i] < m_o[i])
            {
               double s = 0.5;
               if(br_top[z] - br_bot[z] >= 0.5 * a) s += 0.25;
               if(Spike(i)) s += 0.25;
               if(s > XAbs(vfvg)) vfvg = -s;
               br_n--; br_top[z] = br_top[br_n]; br_bot[z] = br_bot[br_n]; br_age[z] = br_age[br_n];
               continue;
            }
            z++;
         }
         if(i >= 2 && a > 0.0)
         {
            if(m_l[i] > m_h[i - 2] && (m_l[i] - m_h[i - 2]) >= 0.2 * a && (m_c[i - 1] - m_o[i - 1]) >= 0.5 * a)
            {
               if(bt_n == 6) { for(int z = 1; z < 6; z++) { bt_top[z - 1] = bt_top[z]; bt_bot[z - 1] = bt_bot[z]; bt_age[z - 1] = bt_age[z]; } bt_n = 5; }
               bt_top[bt_n] = m_l[i]; bt_bot[bt_n] = m_h[i - 2]; bt_age[bt_n] = 0; bt_n++;
            }
            if(m_h[i] < m_l[i - 2] && (m_l[i - 2] - m_h[i]) >= 0.2 * a && (m_o[i - 1] - m_c[i - 1]) >= 0.5 * a)
            {
               if(br_n == 6) { for(int z = 1; z < 6; z++) { br_top[z - 1] = br_top[z]; br_bot[z - 1] = br_bot[z]; br_age[z - 1] = br_age[z]; } br_n = 5; }
               br_top[br_n] = m_l[i - 2]; br_bot[br_n] = m_h[i]; br_age[br_n] = 0; br_n++;
            }
         }

         if(!live) continue;
         const int o = i * XM_COUNT;
         m_vote[o + XM_PULLBACK] = VotePullback(i);
         m_vote[o + XM_SWEEP]    = VoteSweep(i);
         m_vote[o + XM_BREAKOUT] = VoteBreakout(i, bk_up_bar, bk_dn_bar);
         m_vote[o + XM_SQUEEZE]  = VoteSqueeze(i);
         m_vote[o + XM_VWAP]     = VoteVwap(i);
         m_vote[o + XM_DIVERGE]  = vdiv;
         m_vote[o + XM_FVG]      = vfvg;
         m_vote[o + XM_ROUND]    = VoteRound(i);
         m_vote[o + XM_ORB]      = m_orbv[i];
         // late in the day, after most of the average daily range is spent, continuation setups are usually exhaustion
         if(cfg.adr_block > 0.0 && m_adru[i] >= cfg.adr_block)
         {
            m_vote[o + XM_PULLBACK] = 0.0;
            m_vote[o + XM_BREAKOUT] = 0.0;
            m_vote[o + XM_SQUEEZE]  = 0.0;
         }
      }
   }
};

//+------------------------------------------------------------------+
//| paper-trade ledger (idea from GOLD_ORB's virtual environment)     |
//| While real trading is paused after a losing streak, the signals   |
//| the EA WOULD have taken are simulated bar by bar. Trading resumes |
//| when those paper trades recover.                                  |
//+------------------------------------------------------------------+
class CXPaper
{
public:
   datetime pt[32];
   int      pd[32];
   double   ps[32];
   int      pn;
   double   res[16];
   int      rn;

   CXPaper() { pn = 0; rn = 0; }
   void Reset() { pn = 0; rn = 0; }

   void Add(const datetime signal_bar_time, const int dir, const double sl)
   {
      for(int k = 0; k < pn; k++) if(pt[k] == signal_bar_time) return;
      if(pn >= 32)
      {
         for(int k = 1; k < pn; k++) { pt[k - 1] = pt[k]; pd[k - 1] = pd[k]; ps[k - 1] = ps[k]; }
         pn--;
      }
      pt[pn] = signal_bar_time; pd[pn] = dir; ps[pn] = sl; pn++;
   }

   // Resolve every pending paper trade that has finished on closed bars (managed with exit profile x).
   void Update(const CXauEngine &e, const XExit &x)
   {
      const int last = e.n - 2;
      for(int k = pn - 1; k >= 0; k--)
      {
         int idx = -1;
         for(int j = last; j >= 0 && j > last - 500; j--) if(e.m_t[j] == pt[k]) { idx = j; break; }
         bool drop = (idx < 0);
         if(!drop)
         {
            XTradeResult r;
            if(e.SimulateTradeEx(idx, pd[k], ps[k], last, x, r) && r.closed)
            {
               if(rn >= 16) { for(int q = 1; q < rn; q++) res[q - 1] = res[q]; rn--; }
               res[rn] = r.r_net; rn++;
               drop = true;
            }
         }
         if(drop)
         {
            for(int q = k + 1; q < pn; q++) { pt[q - 1] = pt[q]; pd[q - 1] = pd[q]; ps[q - 1] = ps[q]; }
            pn--;
         }
      }
   }

   // Recovered: at least two finished paper trades, and of the last three not all lost and their sum is positive.
   bool Recovered() const
   {
      if(rn < 2) return false;
      const int m = (rn < 3) ? rn : 3;
      double sum = 0.0;
      int losses = 0;
      for(int q = rn - m; q < rn; q++) { sum += res[q]; if(res[q] < -0.05) losses++; }
      return (sum > 0.0 && losses < m);
   }
};

