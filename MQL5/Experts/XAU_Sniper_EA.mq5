   #define XSARR(name)      string name[]
   #define XRATESARR(name)  MqlRates name[]
   #define XRATESOUT(name)  MqlRates &name[]
   #define XCALARR(name)    MqlCalendarValue name[]
#endif

//+------------------------------------------------------------------+
//| timeframes                                                       |
//+------------------------------------------------------------------+
ENUM_TIMEFRAMES XAutoHTF(const ENUM_TIMEFRAMES tf)
{
   switch(tf)
   {
      case PERIOD_M1:  case PERIOD_M2:  case PERIOD_M3:  case PERIOD_M4:                    return PERIOD_M15;
      case PERIOD_M5:  case PERIOD_M6:  case PERIOD_M10: case PERIOD_M12:                   return PERIOD_H1;
      case PERIOD_M15: case PERIOD_M20:                                                     return PERIOD_H1;
      case PERIOD_M30:                                                                      return PERIOD_H4;
      case PERIOD_H1:  case PERIOD_H2:  case PERIOD_H3:                                     return PERIOD_H4;
      case PERIOD_H4:  case PERIOD_H6:  case PERIOD_H8:  case PERIOD_H12:                   return PERIOD_D1;
      case PERIOD_D1:                                                                       return PERIOD_W1;
      default: break;
   }
   return PERIOD_MN1;
}

string XTfName(const ENUM_TIMEFRAMES tf)
{
   return StringSubstr(EnumToString(tf), 7);
}

//+------------------------------------------------------------------+
//| data                                                             |
//+------------------------------------------------------------------+
// user-facing strategy / exit choices (AUTO = let the Strategy Lab choose on this chart's own history)
enum ENUM_XAU_STRAT
{
   XAU_ST_AUTO       = -1,  // AUTO: the strategy that passed the Strategy Lab
   XAU_ST_CONFLUENCE = 0,   // Confluence of 9 modules
   XAU_ST_ORB        = 1,   // Opening-range breakout (GOLD_ORB)
   XAU_ST_DIP        = 2,   // RSI-2 dip in trend
   XAU_ST_DOUBLE7    = 3,   // Double-7 dip in trend
   XAU_ST_IBS        = 4,   // Weak-close dip in trend
   XAU_ST_SWEEP      = 5,   // Stop-hunt reversal
   XAU_ST_PULLBACK   = 6,   // EMA pullback
   XAU_ST_SQUEEZE    = 7    // Squeeze breakout
};

enum ENUM_XAU_EXIT
{
   XAU_EX_AUTO    = -1,     // AUTO: chosen together with the strategy
   XAU_EX_CLASSIC = 0,      // Classic: half at 1R, runner to 2.5R
   XAU_EX_HIGHHIT = 1,      // High-hit: 70% at 0.5R, runner to 1.5R
   XAU_EX_QUICK   = 2,      // Quick: all out at 0.6R
   XAU_EX_MEANREV = 3,      // Mean-revert: exit on the close back over the 5-bar mean
   XAU_EX_RIDER   = 4,      // Trend rider: a third at 1R, the rest trails 3 ATR for up to 5 days
   XAU_EX_SWING   = 5       // Swing: the classic exit held up to 3 days
};

// Resolve the user's choice against the lab. Returns the cell (strategy * XP_COUNT + exit) or -1.
int XResolveCell(const CXauEngine &le, const int user_s, const int user_p, const int min_trades, bool &proven)
{
   proven = false;
   if(user_s < 0 && user_p < 0) return le.LabActiveCell(min_trades, proven);
   int best = -1;
   double sc = -1e9;
   for(int c = 0; c < XLAB_CELLS; c++)
   {
      const int st = c / XP_COUNT, pr = c % XP_COUNT;
      if(user_s >= 0 && st != user_s) continue;
      if(user_p >= 0 && pr != user_p) continue;
      const double v = le.lab[c].score + (le.lab[c].qualified ? 1000.0 : 0.0);
      if(le.lab[c].all.n >= 1 && v > sc) { sc = v; best = c; }
   }
   if(best < 0) best = XMaxI(user_s, 0) * XP_COUNT + XMaxI(user_p, 0);
   proven = le.lab[best].qualified;
   return best;
}

// Overnight swap of this symbol as a COST per unit (1 oz for gold) per night, in price units (positive = you pay).
// MT5 reports swap in several modes; the common ones are converted, the rest fall back to 0 with a log line.
double XSwapCostPerUnit(const string sym, const bool is_buy)
{
   const double sw = SymbolInfoDouble(sym, is_buy ? SYMBOL_SWAP_LONG : SYMBOL_SWAP_SHORT);   // MT5: negative = charged
   const long mode = SymbolInfoInteger(sym, SYMBOL_SWAP_MODE);
   const double contract = SymbolInfoDouble(sym, SYMBOL_TRADE_CONTRACT_SIZE);
   const double price = SymbolInfoDouble(sym, SYMBOL_BID);
   double per_unit = 0.0;
   if(mode == SYMBOL_SWAP_MODE_POINTS) per_unit = sw * SymbolInfoDouble(sym, SYMBOL_POINT);
   else if(mode == SYMBOL_SWAP_MODE_CURRENCY_SYMBOL || mode == SYMBOL_SWAP_MODE_CURRENCY_DEPOSIT ||
           mode == SYMBOL_SWAP_MODE_CURRENCY_MARGIN || mode == SYMBOL_SWAP_MODE_CURRENCY_PROFIT)
      per_unit = (contract > 0.0) ? sw / contract : 0.0;                      // money per lot -> per unit (USD accounts)
   else if(mode == SYMBOL_SWAP_MODE_INTEREST_CURRENT || mode == SYMBOL_SWAP_MODE_INTEREST_OPEN)
      per_unit = price * sw / 100.0 / 360.0;                                  // annual percent of the price
   return -per_unit;
}

// How the tools choose and trade (round 10, docs/REAL_DATA.md section 10).
//   STEADY: one strategy, the Lab's best with at least 60% winners (high win-rate, about break-even on real gold)
//   TREND : every strategy that passes a 50% Lab target trades, each its own position (up to a cap), multi-day
//           exits allowed, H1 and above buy only in a daily uptrend. On real H1/H4 history: about +0.1R per trade.
enum ENUM_XAU_MODE
{
   XAU_MODE_AUTO   = -1,   // AUTO: TREND on H1 and H4, STEADY elsewhere
   XAU_MODE_STEADY = 0,    // STEADY: one strategy, 60%+ winners
   XAU_MODE_TREND  = 1     // TREND: all passing strategies, trend-riding exits
};

int XResolveMode(const int input_mode, const ENUM_TIMEFRAMES tf)
{
   if(input_mode >= 0) return input_mode;
   const int ps = PeriodSeconds(tf);
   return (ps == 3600 || ps == 14400) ? XAU_MODE_TREND : XAU_MODE_STEADY;
}

// "Today's plan" in one line for both panels: trade or stand aside, which direction, and today's expected range
// (CXauEngine::DayRangeForecast) against what the day has already made. go = true when the tools may trade today.
string XTodayPlan(const int mode, const int npass, const bool proven, const bool too_small, const int d1_mode, const int dreg,
                  const double day_fc, const double day_sofar, bool &go)
{
   go = false;
   string s = "TODAY: ";
   if(too_small)                       s += "watch only - trades on this chart are too big for the account";
   else if(d1_mode == 2 && dreg <= 0)  s += "stand aside - the daily trend is not up and this chart only buys";
   else if(d1_mode == 1 && dreg == 0)  s += "stand aside - no clear daily trend (the filter trades only with it)";
   else if((mode == XAU_MODE_TREND && npass == 0 && !proven) || (mode != XAU_MODE_TREND && !proven))
                                       s += "stand aside - no strategy passed the Lab here";
   else
   {
      go = true;
      string side = "both directions";
      if(d1_mode == 2) side = "buys only";
      else if(d1_mode == 1 && dreg > 0) side = "buys only (daily trend up)";
      else if(d1_mode == 1 && dreg < 0) side = "sells only (daily trend down)";
      s += "wait for a signal, " + side;
      if(mode == XAU_MODE_TREND && npass > 0) s += ", " + IntegerToString(npass) + " strateg" + (npass > 1 ? "ies" : "y") + " armed";
   }
   if(day_fc > 0.0)
   {
      s += ". Today's range: about " + DoubleToString(day_fc, 0) + " expected, " + DoubleToString(day_sofar, 0) + " so far";
      if(day_sofar >= 0.9 * day_fc) s += ": most of today's move is done";
   }
   return s;
}

// One row that says which entry checks pass right now, so "why is it not trading?" is answered at a glance.
string XCheckRow(const bool lab, const bool trend, const bool news, const bool spread, const bool margin, const bool size, const bool limits)
{
   const string ok = "ok", no = "NO";
   string s = "Checks: Lab ";
   s += lab ? ok : no;
   s += ", Trend ";  s += trend ? ok : no;
   s += ", News ";   s += news ? ok : no;
   s += ", Spread "; s += spread ? ok : no;
   s += ", Margin "; s += margin ? ok : no;
   s += ", Size ";   s += size ? ok : no;
   s += ", Limits "; s += limits ? ok : no;
   return s;
}

// Chance (0-1) that the next `trades` trades at `risk_pct` per trade dig a drawdown of `dd_pct` or more from the
// running peak, when trades win with probability win_p (average win avg_win_r R, average loss avg_loss_r R) and
// otherwise scratch at 0. Monte Carlo with a fixed-seed generator, so the same inputs always give the same answer.
double XDrawdownChance(const double win_p, const double loss_p, const double avg_win_r, const double avg_loss_r,
                       const double risk_pct, const int trades, const double dd_pct, const int paths)
{
   if(paths <= 0 || trades <= 0 || risk_pct <= 0.0) return 0.0;
   uint seed = 2463534242;
   int hit = 0;
   const double r = risk_pct / 100.0, lim = 1.0 - dd_pct / 100.0;
   for(int p = 0; p < paths; p++)
   {
      double eq = 1.0, peak = 1.0;
      for(int t = 0; t < trades; t++)
      {
         seed ^= (seed << 13); seed ^= (seed >> 17); seed ^= (seed << 5);
         const double u = (double)(seed % 1000000) / 1000000.0;
         if(u < win_p) eq *= 1.0 + r * avg_win_r;
         else if(u < win_p + loss_p) eq *= 1.0 - r * avg_loss_r;
         if(eq > peak) peak = eq;
         if(eq <= peak * lim) { hit++; break; }
      }
   }
   return (double)hit / paths;
}

// Live results that fall below what the Lab tested by more than bad luck explains (2 standard errors, 30+ trades)
// usually mean the broker's fills or spread differ from the test. Returns a warning, or "" when all is normal.
string XLiveDrift(const int live_n, const int live_wins, const double tested_win_pct)
{
   if(live_n < 30 || tested_win_pct <= 0.0) return "";
   const double p = tested_win_pct / 100.0;
   const double live = (double)live_wins / live_n;
   const double se = MathSqrt(p * (1.0 - p) / live_n);
   if(live >= p - 2.0 * se) return "";
   return "Live win-rate " + DoubleToString(100.0 * live, 0) + "% is below the tested " + DoubleToString(tested_win_pct, 0) +
          "% by more than luck explains: check spread and fills, or pause";
}

// Session clock for the panel: where the day is and what comes next (London local time; server midnight = daily break).
string XSessionLine(const XConfig &c, const datetime server_now)
{
   const int off = XOffsetAt(c, server_now);
   const long gmt = (long)server_now - off;
   const int lon_off = XEuDst(gmt) ? 3600 : 0;
   const long lon = gmt + lon_off;
   const int m = (int)((lon % 86400) / 60);                       // London minutes after midnight
   const int dow = (int)(((lon / 86400) + 4) % 7);
   if(dow == 6 || (dow == 0 && m < 23 * 60) || (dow == 5 && m >= 22 * 60)) return "Market closed for the weekend";
   string now_s = "Asia";
   if(m >= 8 * 60 && m < 13 * 60 + 30) now_s = "London";
   else if(m >= 13 * 60 + 30 && m < 16 * 60 + 30) now_s = "London + New York (busiest)";
   else if(m >= 16 * 60 + 30 && m < 22 * 60) now_s = "New York";
   else if(m >= 22 * 60 && m < 23 * 60) now_s = "daily break / thin";
   const int ev_min[4] = {8 * 60, 13 * 60 + 30, 14 * 60 + 30, 22 * 60};
   const string ev_nm[4] = {"London opens", "US data time", "New York opens", "daily break"};
   int best = -1, best_d = 100000;
   for(int k = 0; k < 4; k++)
   {
      int d = ev_min[k] - m;
      if(d <= 0) d += 1440;
      if(d < best_d) { best_d = d; best = k; }
   }
   string nxt = "";
   if(best >= 0) nxt = ev_nm[best] + " in " + IntegerToString(best_d / 60) + "h" + StringFormat("%02d", best_d % 60);
   return "Session: " + now_s + "   next: " + nxt;
}

// Daily trend filter (research/sim/drift.cpp, docs/REAL_DATA.md section 8). The daily trend is the last completed
// daily close above / below its 200-day mean.
enum ENUM_XAU_D1
{
   XAU_D1_AUTO = -1,   // AUTO: H1 and above buy only while the daily trend is up; M5-M30 unfiltered
   XAU_D1_OFF  = 0,    // off
   XAU_D1_WITH = 1,    // trade only in the daily trend's direction
   XAU_D1_LONG = 2     // buy only, and only while the daily trend is up
};

int XResolveD1Mode(const int input_mode, const ENUM_TIMEFRAMES tf)
{
   if(input_mode >= 0) return input_mode;
   return (PeriodSeconds(tf) >= 3600) ? XAU_D1_LONG : XAU_D1_OFF;
}

// Strategy Lab window: 0 = automatic (H1: 25,000 bars, about 4 years; everything else 10,000 bars).
int XResolveHistoryBars(const int input_bars, const ENUM_TIMEFRAMES tf)
{
   if(input_bars > 0) return input_bars;
   return (PeriodSeconds(tf) == 3600) ? 25000 : 10000;
}

// Daily bars needed to know the daily trend over `base_bars` bars of timeframe tf (plus the 200-day mean).
// What "the daily trend is up" means (round 11, docs/REAL_DATA.md section 11)
enum ENUM_XAU_D1DEF
{
   XAU_D1DEF_RISING = 1,   // close above its 200-day mean AND that mean rising (default since round 11)
   XAU_D1DEF_ABOVE  = 0,   // close above its 200-day mean (round 8-10)
   XAU_D1DEF_MOM12  = 2,   // close above the close of 12 months ago
   XAU_D1DEF_BOTH   = 3    // above the 200-day mean and above 12 months ago
};

// daily bars the chosen definition needs before it can say anything
int XDailyMinBars(const int d1_def)
{
   if(d1_def == XAU_D1DEF_RISING) return 225;
   if(d1_def == XAU_D1DEF_MOM12 || d1_def == XAU_D1DEF_BOTH) return 260;
   return 210;
}

int XDailyBarsNeeded(const int base_bars, const ENUM_TIMEFRAMES tf)
{
   return (int)((double)base_bars * PeriodSeconds(tf) / 86400.0 * 1.45) + 260;
}

enum ENUM_XAU_DST
{
   XAU_DST_FIXED = 0,   // server clock never changes
   XAU_DST_US    = 1,   // server follows US daylight time (typical "New York close" servers: GMT+2 / GMT+3)
   XAU_DST_EU    = 2    // server follows EU daylight time
};

// Server-time minus GMT in WINTER (standard) time, in seconds. With manual = true the value is the one you typed.
// Automatic: measure today's offset and, if the server is currently on summer time, remove the extra hour.
int XWinterOffsetSec(const bool manual, const double manual_hours, const int dst_mode)
{
   if(manual) return (int)MathRound(manual_hours * 3600.0);
   const double d = (double)(TimeTradeServer() - TimeGMT());
   int cur = (int)(MathRound(d / 1800.0) * 1800.0);
   const long g = (long)TimeGMT();
   if(dst_mode == XAU_DST_US && XUsDst(g)) cur -= 3600;
   if(dst_mode == XAU_DST_EU && XEuDst(g)) cur -= 3600;
   return cur;
}

// Loads the most recent `count` bars, oldest first (index count-1 = forming bar).
int XLoadRates(const string sym, const ENUM_TIMEFRAMES tf, const int count, XRATESOUT(out))
{
   ArraySetAsSeries(out, false);
   const int got = CopyRates(sym, tf, 0, count, out);
   return (got > 0) ? got : 0;
}

// Trend direction (+1/-1/0) and ADX on the last CLOSED bar of another timeframe.
int XTrendState(const string sym, const ENUM_TIMEFRAMES tf, double &adx_out)
{
   XRATESARR(r);
   adx_out = 0.0;
   const int got = XLoadRates(sym, tf, 450, r);
   if(got < 260) return 0;
   XDARR(c); XDARR(h); XDARR(l); XDARR(e50); XDARR(e200); XDARR(pdi); XDARR(mdi); XDARR(adx);
   ArrayResize(c, got); ArrayResize(h, got); ArrayResize(l, got);
   ArrayResize(e50, got); ArrayResize(e200, got); ArrayResize(pdi, got); ArrayResize(mdi, got); ArrayResize(adx, got);
   for(int i = 0; i < got; i++) { c[i] = r[i].close; h[i] = r[i].high; l[i] = r[i].low; }
   XCalcEMA(c, e50, got, 50);
   XCalcEMA(c, e200, got, 200);
   XCalcADX(h, l, c, pdi, mdi, adx, got, 14);
   const int k = got - 2;
   adx_out = adx[k];
   if(e50[k] > e200[k] && c[k] > e50[k]) return 1;
   if(e50[k] < e200[k] && c[k] < e50[k]) return -1;
   return 0;
}

// DXY-like symbol (gold moves against it) or EURUSD fallback (gold moves with it).
string XResolveInterSymbol(const string user_symbol, bool &invert)
{
   invert = false;
   if(StringLen(user_symbol) > 0)
   {
      invert = (StringFind(user_symbol, "EUR") < 0 && StringFind(user_symbol, "GBP") < 0 && StringFind(user_symbol, "AUD") < 0);
      if(SymbolSelect(user_symbol, true)) return user_symbol;
      return "";
   }
   string cand[5];
   cand[0] = "USDX"; cand[1] = "DXY"; cand[2] = "DX"; cand[3] = "USDIDX"; cand[4] = "DXY.cash";
   for(int i = 0; i < 5; i++)
      if(SymbolSelect(cand[i], true)) { invert = true; return cand[i]; }
   if(SymbolSelect("EURUSD", true)) { invert = false; return "EURUSD"; }
   return "";
}

//+------------------------------------------------------------------+
//| lot sizing                                                       |
//+------------------------------------------------------------------+
struct XLotPlan
{
   bool   ok;
   double lots;
   double risk_money;        // money lost if the stop is hit at `lots`
   double risk_pct;          // of the supplied equity
   double margin;
   double min_lot_risk_pct;  // what the smallest tradable lot would risk
   string note;
   string src_note;          // set when the broker's tick value was found to be wrong
};

double XTickValueLoss(const string sym)
{
   double v = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE_LOSS);
   if(v <= 0.0) v = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_VALUE);
   return v;
}

// Money lost by ONE lot if the stop (sl_dist away from price) is hit, in account currency.
// Some brokers report the XAUUSD tick value 10x too small, which would make every position 10x too big.
// The broker's own profit formula (OrderCalcProfit) is therefore the source of truth; the tick value and
// the contract size are only fallbacks. `note` explains when the sources disagreed.
double XLossPerLot(const string sym, const bool is_buy, const double price, const double sl_dist, string &note)
{
   note = "";
   if(sl_dist <= 0.0 || price <= 0.0) return 0.0;
   const ENUM_ORDER_TYPE ot = is_buy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   const double sl = is_buy ? price - sl_dist : price + sl_dist;
   double prof = 0.0, by_profit = 0.0;
   if(OrderCalcProfit(ot, sym, 1.0, price, sl, prof) && prof < 0.0) by_profit = -prof;
   const double ts = SymbolInfoDouble(sym, SYMBOL_TRADE_TICK_SIZE);
   const double tv = XTickValueLoss(sym);
   const double by_tick = (ts > 0.0 && tv > 0.0) ? sl_dist / ts * tv : 0.0;
   double by_contract = 0.0;
   if(SymbolInfoString(sym, SYMBOL_CURRENCY_PROFIT) == AccountInfoString(ACCOUNT_CURRENCY))
      by_contract = sl_dist * SymbolInfoDouble(sym, SYMBOL_TRADE_CONTRACT_SIZE);
   if(by_profit > 0.0)
   {
      if(by_tick > 0.0 && MathAbs(by_tick - by_profit) > 0.2 * by_profit)
         note = "broker tick value is off by x" + DoubleToString(by_profit / by_tick, 1) + "; using the broker's profit formula";
      return by_profit;
   }
   if(by_contract > 0.0)
   {
      if(by_tick > 0.0 && MathAbs(by_tick - by_contract) > 0.2 * by_contract) note = "tick value disagrees with contract size; using contract size";
      return by_contract;
   }
   return by_tick;
}

// Sizes a trade so that hitting the stop costs `risk_pct` of equity. Never rounds UP past
// the requested risk; if even the minimum lot risks more than overrun_factor x the request,
// the trade is refused (ok=false) instead of silently over-risking a small account.
void XPlanLots(const string sym, const double equity, const double risk_pct, const double sl_dist,
               const bool is_buy, const double price, const double overrun_factor,
               const double lot_cap, const double free_margin, const double margin_use_frac,
               XLotPlan &p)
{
   p.ok = false; p.lots = 0.0; p.risk_money = 0.0; p.risk_pct = 0.0; p.margin = 0.0;
   p.min_lot_risk_pct = 0.0; p.note = ""; p.src_note = "";
   const double vmin  = SymbolInfoDouble(sym, SYMBOL_VOLUME_MIN);
   const double vmax  = SymbolInfoDouble(sym, SYMBOL_VOLUME_MAX);
   const double vstep = SymbolInfoDouble(sym, SYMBOL_VOLUME_STEP);
   string src_note = "";
   const double loss_per_lot = XLossPerLot(sym, is_buy, price, sl_dist, src_note);
   p.src_note = src_note;
   if(equity <= 0.0 || sl_dist <= 0.0 || loss_per_lot <= 0.0 || vstep <= 0.0)
   {
      p.note = "symbol data unavailable";
      return;
   }
   const double risk_money = equity * risk_pct / 100.0;
   double lots = XNormLotsDown(risk_money / loss_per_lot, vmin, vmax, vstep);
   p.min_lot_risk_pct = 100.0 * vmin * loss_per_lot / equity;
   if(lots <= 0.0)
   {
      if(vmin * loss_per_lot <= risk_money * overrun_factor) lots = vmin;
      else
      {
         p.note = "account too small: min lot would risk " + DoubleToString(p.min_lot_risk_pct, 1) + "%";
         return;
      }
   }
   if(lot_cap > 0.0 && lots > lot_cap) lots = XNormLotsDown(lot_cap, vmin, vmax, vstep);
   if(lots <= 0.0) { p.note = "lot cap below minimum lot"; return; }

   double margin = 0.0;
   const ENUM_ORDER_TYPE ot = is_buy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   if(free_margin <= 0.0)
   {
      // report the size anyway (the indicator shows it), but it cannot be opened
      p.lots = lots; p.risk_money = lots * loss_per_lot; p.risk_pct = 100.0 * p.risk_money / equity;
      p.note = "no free margin left: open trades are using all of it";
      return;
   }
   if(OrderCalcMargin(ot, sym, lots, price, margin) && margin > 0.0)
   {
      const double allowed = free_margin * margin_use_frac;
      if(margin > allowed)
      {
         const double lots_before = lots;
         lots = XNormLotsDown(lots * allowed / margin, vmin, vmax, vstep);
         if(lots <= 0.0) { p.note = "not enough free margin"; return; }
         double margin2 = 0.0;
         if(OrderCalcMargin(ot, sym, lots, price, margin2) && margin2 > 0.0) margin = margin2;
         else margin = margin * lots / lots_before;   // recalculation failed: scale the earlier figure proportionally
      }
   }
   p.lots = lots;
   p.margin = margin;
   p.risk_money = lots * loss_per_lot;
   p.risk_pct = 100.0 * p.risk_money / equity;
   p.ok = true;
}

//+------------------------------------------------------------------+
//| economic calendar filter                                         |
//+------------------------------------------------------------------+
class CXauNews
{
private:
   XTARR(m_t);
   XSARR(m_name);
   XIARR(m_imp);
   int      m_n;
   datetime m_last;
   bool     m_cal_ok;
public:
   int    before_min;
   int    after_min;
   int    min_importance;    // 1 low, 2 medium, 3 high
   bool   fallback_static;   // when the calendar is unavailable (e.g. Strategy Tester)
   int    gmt_offset_sec;
   string currency;

   CXauNews()
   {
      m_n = 0; m_last = 0; m_cal_ok = false;
      before_min = 30; after_min = 30; min_importance = 3;
      fallback_static = true; gmt_offset_sec = 0; currency = "USD";
   }
   bool CalendarAvailable() const { return m_cal_ok; }

   void Refresh(const datetime now)
   {
      if(m_last != 0 && now - m_last < 900 && now >= m_last) return;
      m_last = now;
      m_n = 0;
      m_cal_ok = false;
      XCALARR(vals);
      ResetLastError();
      if(!CalendarValueHistory(vals, now - 3 * 3600, now + 3 * 86400, NULL, currency)) return;
      const int got = ArraySize(vals);
      if(got <= 0) return;
      m_cal_ok = true;
      ArrayResize(m_t, got); ArrayResize(m_name, got); ArrayResize(m_imp, got);
      for(int i = 0; i < got; i++)
      {
         MqlCalendarEvent ev;
         if(!CalendarEventById(vals[i].event_id, ev)) continue;
         const int imp = (int)ev.importance;
         if(imp < min_importance) continue;
         m_t[m_n] = vals[i].time;
         m_name[m_n] = ev.name;
         m_imp[m_n] = imp;
         m_n++;
      }
   }

   // true when trading should pause; `why` explains
   bool Blocked(const datetime now, string &why) const
   {
      why = "";
      for(int i = 0; i < m_n; i++)
      {
         if(now >= m_t[i] - before_min * 60 && now <= m_t[i] + after_min * 60)
         {
            why = m_name[i] + " " + TimeToString(m_t[i], TIME_MINUTES);
            return true;
         }
      }
      if(!m_cal_ok && fallback_static)
      {
         // US data prints at 08:30 ET = 12:30 or 13:30 GMT. Without a calendar, stay out of both.
         const double hr = XHourGmt(now, gmt_offset_sec);
         const int wd = XWeekdayGmt(now, gmt_offset_sec);
         if(wd >= 1 && wd <= 5)
         {
            if((hr >= 12.25 && hr <= 12.75) || (hr >= 13.25 && hr <= 13.75))
            {
               why = "US data window (static)";
               return true;
            }
         }
      }
      return false;
   }

   // e.g. "NFP in 42m" for the panel; empty when nothing is near
   string NextText(const datetime now) const
   {
      datetime best = 0; int bi = -1;
      for(int i = 0; i < m_n; i++)
         if(m_t[i] >= now - after_min * 60 && (bi < 0 || m_t[i] < best)) { best = m_t[i]; bi = i; }
      if(bi < 0) return m_cal_ok ? "no high-impact USD news soon" : "calendar unavailable";
      const long mins = ((long)best - (long)now) / 60;
      string nm = m_name[bi];
      if(StringLen(nm) > 22) nm = StringSubstr(nm, 0, 22);
      if(mins >= 0) return nm + " in " + IntegerToString(mins) + "m";
      return nm + " " + IntegerToString(-mins) + "m ago";
   }
};

//+------------------------------------------------------------------+
//| drawing helpers                                                  |
//+------------------------------------------------------------------+
color XRGB(const int r, const int g, const int b)
{
   return (color)((b << 16) | (g << 8) | r);
}

void XObjLabel(const string name, const int x, const int y, const string text, const color clr,
               const int fsize, const string font, const ENUM_BASE_CORNER corner)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_ANCHOR, ANCHOR_LEFT_UPPER);
      ObjectSetString(0, name, OBJPROP_FONT, font);
   }
   ObjectSetInteger(0, name, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fsize);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
}

void XObjRectLabel(const string name, const int x, const int y, const int w, const int h,
                   const color bg, const color border, const ENUM_BASE_CORNER corner)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   }
   ObjectSetInteger(0, name, OBJPROP_CORNER, corner);
   ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bg);
   ObjectSetInteger(0, name, OBJPROP_COLOR, border);
}

void XObjTrend(const string name, const datetime t1, const double p1, const datetime t2, const double p2,
               const color clr, const ENUM_LINE_STYLE style, const int width, const bool ray_right)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_TREND, 0, t1, p1, t2, p2);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
   }
   else
   {
      ObjectMove(0, name, 0, t1, p1);
      ObjectMove(0, name, 1, t2, p2);
   }
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_STYLE, style);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, width);
   ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, ray_right);
}

void XObjRect(const string name, const datetime t1, const double p1, const datetime t2, const double p2,
              const color clr, const bool fill)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_RECTANGLE, 0, t1, p1, t2, p2);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
   }
   else
   {
      ObjectMove(0, name, 0, t1, p1);
      ObjectMove(0, name, 1, t2, p2);
   }
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_FILL, fill);
}

void XObjText(const string name, const datetime t, const double p, const string text, const color clr, const int fsize)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_TEXT, 0, t, p);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_ANCHOR, ANCHOR_LEFT);
      ObjectSetString(0, name, OBJPROP_FONT, "Consolas");
   }
   else ObjectMove(0, name, 0, t, p);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fsize);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
}

void XObjVLine(const string name, const datetime t, const color clr)
{
   if(ObjectFind(0, name) < 0)
   {
      ObjectCreate(0, name, OBJ_VLINE, 0, t, 0.0);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);
      ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_DOT);
   }
   else ObjectMove(0, name, 0, t, 0.0);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
}

void XObjDelete(const string name)
{
   if(ObjectFind(0, name) >= 0) ObjectDelete(0, name);
}

//+------------------------------------------------------------------+
//| panel: lines are collected, then drawn in a box that fits them   |
//+------------------------------------------------------------------+
enum ENUM_XAU_PANEL_POS
{
   XAU_PANEL_TOP_LEFT    = 0,   // top left
   XAU_PANEL_BOTTOM_LEFT = 1,   // bottom left
   XAU_PANEL_TOP_RIGHT   = 2,   // top right (left of the price scale)
   XAU_PANEL_BOTTOM_RIGHT = 3   // bottom right
};

int XTextWidth(const string text, const string font, const int size)
{
   uint w = 0, h = 0;
   if(TextSetFont(font, -size * 10, 0, 0) && TextGetSize(text, w, h) && w > 0) return (int)w;
   return (int)(StringLen(text) * size * 0.8);
}

class CXPanel
{
private:
   string m_text[48];
   color  m_clr[48];
   int    m_extra[48];
   int    m_rows, m_drawn;
public:
   string prefix;
   string font;
   int    x, y, fs, min_w;
   ENUM_XAU_PANEL_POS pos;
   color  bg, border;

   CXPanel() { m_rows = 0; m_drawn = 0; prefix = "XP_"; font = "Consolas"; x = 12; y = 24; fs = 10; min_w = 300;
               pos = XAU_PANEL_TOP_LEFT; bg = XRGB(16, 20, 28); border = XRGB(58, 68, 88); }
   void Begin() { m_rows = 0; }
   // MT5 cuts a text label after 63 characters, so longer lines are wrapped at a space
   void Line(const string text, const color clr, const int extra = 0)
   {
      string rest = text;
      bool first = true;
      while(m_rows < 48)
      {
         string part = rest;
         const int lim = first ? 62 : 60;
         if(StringLen(rest) > lim)
         {
            int cut = lim;
            while(cut > 20 && StringGetCharacter(rest, cut) != ' ') cut--;
            if(cut <= 20) cut = lim;
            part = StringSubstr(rest, 0, cut);
            rest = StringSubstr(rest, cut);
            while(StringLen(rest) > 0 && StringGetCharacter(rest, 0) == ' ') rest = StringSubstr(rest, 1);
         }
         else rest = "";
         m_text[m_rows] = first ? part : "  " + part;
         m_clr[m_rows] = clr; m_extra[m_rows] = extra; m_rows++;
         first = false;
         if(StringLen(rest) == 0) break;
      }
   }
   int Rows() const { return m_rows; }
   string Text(const int k) const { return (k >= 0 && k < m_rows) ? m_text[k] : ""; }
   // measured size of the collected lines
   void Measure(int &w, int &h) const
   {
      w = min_w; h = 16;
      for(int k = 0; k < m_rows; k++)
      {
         const int fsz = fs + m_extra[k];
         const int tw = XTextWidth(m_text[k], font, fsz) + 24;
         if(tw > w) w = tw;
         h += fsz + 8;
      }
   }
   void End()
   {
      int w, h;
      Measure(w, h);
      const int ch = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
      const int cw = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int top = y, left = x;
      if(pos == XAU_PANEL_BOTTOM_LEFT) top = XMaxI(4, ch - h - y);
      if(pos == XAU_PANEL_TOP_RIGHT || pos == XAU_PANEL_BOTTOM_RIGHT) left = XMaxI(4, cw - w - x - 70);
      if(pos == XAU_PANEL_BOTTOM_RIGHT) top = XMaxI(4, ch - h - y - 20);
      XObjRectLabel(prefix + "BG", left, top, w, h, bg, border, CORNER_LEFT_UPPER);
      int py = top + 8;
      for(int k = 0; k < m_rows; k++)
      {
         const int fsz = fs + m_extra[k];
         XObjLabel(prefix + IntegerToString(k), left + 12, py, m_text[k], m_clr[k], fsz, font, CORNER_LEFT_UPPER);
         py += fsz + 8;
      }
      for(int k = m_rows; k < m_drawn; k++) XObjDelete(prefix + IntegerToString(k));
      m_drawn = m_rows;
   }
   void Clear()
   {
      for(int k = 0; k < 48; k++) XObjDelete(prefix + IntegerToString(k));
      XObjDelete(prefix + "BG");
      m_drawn = 0;
   }
};

//+------------------------------------------------------------------+
//| account health: things that can blow an account up               |
//+------------------------------------------------------------------+
string XAccountWarning(const string sym)
{
   int naked = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != sym) continue;
      if(PositionGetDouble(POSITION_SL) <= 0.0) naked++;
   }
   string w = "";
   if(naked > 0) w = IntegerToString(naked) + " open trade" + (naked > 1 ? "s have" : " has") + " NO stop loss";
   const double ml = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
   if(ml > 0.0 && ml < 200.0)
   {
      string so = "";
      if(AccountInfoInteger(ACCOUNT_MARGIN_SO_MODE) == ACCOUNT_STOPOUT_MODE_PERCENT)
         so = " (broker closes trades at " + DoubleToString(AccountInfoDouble(ACCOUNT_MARGIN_SO_SO), 0) + "%)";
      if(StringLen(w) > 0) w += "; ";
      w += "margin level " + DoubleToString(ml, 0) + "%" + so;
   }
   return w;
}

// Your own (manual, magic 0) trades on this symbol in one line: size, stop and what the stop really risks.
// plan_stop / plan_dir: the indicator's plan for the current setup (0 = none); a stop moved further away than the
// plan's is flagged, because widening a stop after entry is how small losses become large ones.
string XOpenTradeLine(const string sym, const double plan_stop, const int plan_dir)
{
   string s = "";
   int cnt = 0;
   const double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != sym || PositionGetInteger(POSITION_MAGIC) != 0) continue;
      cnt++;
      if(cnt > 1) continue;
      const bool buy = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      const double op = PositionGetDouble(POSITION_PRICE_OPEN), sl = PositionGetDouble(POSITION_SL), vol = PositionGetDouble(POSITION_VOLUME);
      const int dg = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);
      const string side = buy ? "BUY " : "SELL ";
      s = "Your trade: " + side + DoubleToString(vol, 2) + " @" + DoubleToString(op, dg);
      if(sl <= 0.0) { s += ", NO STOP"; continue; }
      const double dist = buy ? (op - sl) : (sl - op);
      s += ", stop " + DoubleToString(sl, dg);
      if(dist <= 0.0) { s += " (locked in, no risk left)"; continue; }
      string note = "";
      const double money = vol * XLossPerLot(sym, buy, op, dist, note);
      s += ": risk " + DoubleToString(money, 2) + " " + AccountInfoString(ACCOUNT_CURRENCY);
      if(eq > 0.0) s += " (" + DoubleToString(100.0 * money / eq, 1) + "% of the account)";
      if(plan_dir != 0 && plan_stop > 0.0 && (buy == (plan_dir > 0)) && (buy ? (sl < plan_stop - 1e-9) : (sl > plan_stop + 1e-9)))
         s += " - further away than the plan's stop " + DoubleToString(plan_stop, dg) + ": that raises the loss";
   }
   if(cnt > 1) s += " (+" + IntegerToString(cnt - 1) + " more)";
   return s;
}

//+------------------------------------------------------------------+
//| daily Strategy Lab on a fixed data window                         |
//| Both the indicator and the EA run the lab on exactly the same     |
//| bars (N closed bars ending before today's server midnight), so    |
//| they always choose the same strategy on the same day.             |
//+------------------------------------------------------------------+
datetime XServerDayStart(const datetime t)
{
   return t - (t % 86400);
}

bool XRunDailyLab(CXauEngine &le, const string sym, const ENUM_TIMEFRAMES tf, const ENUM_TIMEFRAMES htf,
                  const int bars, const string inter_sym, const bool inter_invert,
                  const double win_target, const int min_trades, const int folds, const datetime day_start)
{
   XRATESARR(b);
   XRATESARR(h);
   XRATESARR(x);
   ArraySetAsSeries(b, false);
   ArraySetAsSeries(h, false);
   ArraySetAsSeries(x, false);
   const datetime upto = day_start - 1;
   const int gb = CopyRates(sym, tf, upto, bars, b);
   if(gb < 600) return false;
   const int need_h = (int)((double)gb * PeriodSeconds(tf) / PeriodSeconds(htf)) + 320;
   const int gh = CopyRates(sym, htf, upto, need_h, h);
   if(gh < 300) return false;
   le.SetBase(b, gb);
   le.SetHTF(h, gh);
   XRATESARR(d);
   ArraySetAsSeries(d, false);
   int gd = 0;
   if(le.cfg.d1_mode > 0)
   {
      gd = CopyRates(sym, PERIOD_D1, upto, XDailyBarsNeeded(gb, tf), d);
      if(gd < XDailyMinBars(le.cfg.d1_def)) return false;   // daily history still loading: retry, never test the filter blind
   }
   le.SetDaily(d, gd);
   if(StringLen(inter_sym) > 0)
   {
      const int gx = CopyRates(inter_sym, tf, upto, gb + 50, x);
      if(gx > 100) le.SetInter(x, gx, inter_invert);
   }
   if(!le.Compute()) return false;
   le.RunLab(le.cfg.warmup, le.n - 1, win_target, min_trades, folds);
   return true;
}

#endif // XAU_PLATFORM_MQH

//==== end XAU_Platform.mqh ====

// Hard ceiling for risk per trade (percent of equity). Guard against typos and against chasing a
// "double every month" target: see docs/RISK_MATH.md before raising it.
#define XS_MAX_RISK_PCT 5.0

// How the EA behaves on a DEMO account. Real accounts always use the real-account rules.
enum ENUM_XAU_DEMO
{
   XAU_DEMO_REHEARSAL = 0,   // Rehearsal: exactly the real-account rules (the demo proves what a real account would do)
   XAU_DEMO_FREE      = 1    // Free run: protections only warn, more trades (not a preview of a real account)
};

//--- inputs -----------------------------------------------------------
input group "=== What to trade ==="
input ENUM_XAU_MODE  InpMode         = XAU_MODE_AUTO; // Mode (AUTO: TREND on H1/H4, STEADY elsewhere)
input double InpTrendWinTarget       = 50.0;   // TREND mode: Lab target (% winners); multi-day exits win less often but more
input int    InpTrendMaxPositions    = 3;      // TREND mode: open positions at once (one per passing strategy)
input double InpMaxOpenRiskPct       = 3.0;    // TREND mode: total risk of all open positions (% of equity)
input ENUM_XAU_STRAT InpStrategy     = XAU_ST_AUTO;  // Strategy (AUTO = the one that passed the Strategy Lab here)
input ENUM_XAU_EXIT  InpExit         = XAU_EX_AUTO;  // Exit style (AUTO = chosen together with the strategy)
input double InpWinTarget            = 60.0;   // Strategy Lab: minimum % of winning trades
input int    InpLabMinTrades         = 50;     // Strategy Lab: minimum trades before a strategy can qualify
input int    InpLabFolds             = 5;      // Strategy Lab: walk-forward folds
input int    InpHistoryBars          = 0;      // Bars the lab tests (0 = auto: 25,000 on H1, else 10,000; keep equal to the indicator)
input ENUM_XAU_D1 InpDailyTrend      = XAU_D1_AUTO;  // Daily trend filter (AUTO: H1 and above buy only in a daily uptrend)
input ENUM_XAU_D1DEF InpDailyTrendDef = XAU_D1DEF_RISING; // What "daily trend up" means (keep equal to the indicator)
input int    InpSignalBars           = 3000;   // Bars used for live signals (faster; same signals, tested)

input group "=== Risk ==="
input double InpRiskPct         = 1.0;    // Risk per trade, % of equity (hard ceiling 5)
input double InpStreakScale     = 0.5;    // Risk multiplier after 2+ consecutive losses
input bool   InpD1Scale         = true;   // Halve risk when the daily trend opposes the trade
input double InpMaxLots         = 0.0;    // Absolute lot cap (0 = none)
input double InpMarginUsePct    = 50.0;   // Max % of free margin one trade may use
input double InpMaxRiskOverrun  = 1.5;    // Refuse trade if min lot risks more than this x requested

input group "=== Demo accounts ==="
input ENUM_XAU_DEMO InpDemoMode = XAU_DEMO_FREE;  // FREE RUN = trade every signal for data (default since round 14); REHEARSAL = real-account rules. Ignored on real accounts
input bool   InpDemoUnproven    = true;   // Free run only: also trade the closest strategy when none passed the lab (lost on real data; on for data collection)
input double InpDemoMaxRiskPct  = 50.0;   // Free run only: skip a trade when even the smallest lot risks more than this % of equity
input int    InpDemoMaxPositions = 5;     // Free run only: simultaneous EA trades

input group "=== Your own trades ==="
input bool   InpProtectManual   = false;  // Add a stop to ANY position on this symbol that has none (your manual trades too)
input double InpProtectPct      = 5.0;    // ...placed where that position would lose this % of equity (from now if it is already losing)

input group "=== Account protection ==="
input double InpDailyLossPct    = 0.0;    // Stop for the day at this equity loss (0 = off; off by default since round 14, set 3 for a real account)
input double InpWeeklyLossPct   = 0.0;    // Stop for the week at this equity loss (0 = off; set 6 for a real account)
input double InpMaxDDPct        = 0.0;    // Kill-switch: drawdown from peak equity (0 = off; set 15 for a real account)
input bool   InpKillFlatten     = true;   // Kill-switch also closes open EA positions
input bool   InpResetKill       = false;  // Set true for one start to clear a kill-switch / reset peak
input bool   InpLimitsOwnTradesOnly = false; // Loss limits count only this EA's trades (your manual trades on the account do not stop it)
input int    InpMaxConsecLosses = 0;      // Pause after N losses in a row (0 = off; set 3 for a real account)
input bool   InpPaperResume     = true;   // During that pause, paper-trade the signals and resume as soon as they recover
input int    InpMaxTradesPerDay = 0;      // Entries per day (0 = no limit)
input int    InpMaxPositions    = 1;      // Simultaneous EA positions
input int    InpCooldownBars    = 0;      // Bars to wait after a losing trade (0 = none)
input bool   InpOneTradePerSymbol = false;// true = never open while ANY position (manual trades too) exists on this symbol
input bool   InpDailyLossRealized = false;// Daily limit counts closed trades only (default: equity incl. floating)

input group "=== Filters (London local clock) ==="
input bool   InpSessionFilter = true;
input double InpTradeStartGMT = 7.0;
input double InpTradeEndGMT   = 20.0;
input double InpFridayCutGMT  = 19.0;     // No new entries after this on Fridays
input bool   InpFridayFlatten = true;
input double InpFlattenGMT    = 20.5;     // Friday: close everything at this time
input int    InpMaxSpreadPts  = 60;       // Points (XAUUSD 2-digit: 60 = 0.60)
input double InpMaxSpreadATR  = 12.0;     // ...and at most this % of ATR
input bool   InpUseNews       = true;
input int    InpNewsBefore    = 30;
input int    InpNewsAfter     = 30;
input bool   InpManualGmt     = false;
input double InpGmtOffsetHrs  = 2.0;              // Broker server time minus GMT in WINTER (hours)
input ENUM_XAU_DST InpServerDst = XAU_DST_US;     // Server clock daylight-saving behaviour
input bool   InpLondonSessions = true;            // Session hours are London local time (follow UK DST)
input double InpOrbStartHour  = 1.0;              // Daily open on the SERVER clock (New-York-close brokers: 1)

input group "=== Engine details (advanced) ==="
input ENUM_TIMEFRAMES InpHTF    = PERIOD_CURRENT; // Higher timeframe for the trend (CURRENT = automatic)
input double InpScoreMin        = 1.7;    // Confluence strategy: score needed
input int    InpMinConfluence   = 2;      // Confluence strategy: agreeing modules needed
input double InpAdrBlock        = 0.90;   // No trend-continuation setups after this share of the daily range
input int    InpOrbRangeMin     = 60;     // Opening range: minutes that form it
input int    InpOrbSettleMin    = 180;    // Opening range: quiet minutes before it is final
input bool   InpOrbSolo         = false;  // Force the opening-range strategy (GOLD_ORB mode)
input double InpTP1_R           = 1.0;    // Classic exit: first target (R)
input double InpTP2_R           = 2.5;    // Classic exit: runner target (R)
input double InpPartialPct      = 50.0;   // Classic exit: % closed at the first target
input double InpTrailATR        = 2.0;    // Classic exit: trail distance (ATR)
input double InpSLMinATR        = 0.9;    // Minimum stop distance (ATR)
input double InpSLMaxATR        = 2.6;    // Skip setups needing a wider stop (ATR)
input int    InpHoldMinutes     = 480;    // Time stop for trades that go nowhere
input double InpCostPrice       = 0.35;   // Round-trip spread + slippage charged per tested trade (price units; keep equal to the indicator)
input double InpMinStopCosts    = 20.0;   // Skip setups whose stop is shorter than this many round-trip costs (0 = off; keep equal to the indicator)
input string InpInterSymbol     = "";     // DXY-like symbol (blank = auto / EURUSD fallback)

input group "=== Execution ==="
input long   InpMagic         = 20260901;
input int    InpSlippagePts   = 50;
input string InpComment       = "XAUS";

input group "=== Phone notifications (set your MetaQuotes ID in Tools > Options > Notifications) ==="
input bool   InpPushTrades    = false;    // Push every trade the EA opens and closes to your phone
input bool   InpPushDaily     = false;    // Push a short summary when the server day ends

input group "=== Data for improving the EA ==="
input bool   InpJournal       = true;     // Write every trade and every skipped signal to MQL5/Files/XAU_Export/XAU_Sniper_journal_<symbol>.csv

input group "=== Display ==="
input bool   InpShowPanel     = true;
input ENUM_XAU_PANEL_POS InpPanelPos = XAU_PANEL_BOTTOM_LEFT;   // Panel position (the indicator uses the top left)
input int    InpFontSize      = 10;

//--- position bookkeeping ----------------------------------------------
#define XS_MAXPOS 16
ulong   g_st_ticket[XS_MAXPOS];
double  g_st_r0[XS_MAXPOS];       // initial risk distance (price)
double  g_st_vol0[XS_MAXPOS];
int     g_st_stage[XS_MAXPOS];    // 0 = before the first target, 1 = after
double  g_st_ext[XS_MAXPOS];      // best favourable excursion (price distance)
double  g_st_atr[XS_MAXPOS];      // ATR at entry (trail distance)
int     g_st_prof[XS_MAXPOS];     // exit profile the trade was opened with
int     g_st_n = 0;

//--- state ----------------------------------------------------------------
CXauEngine g_eng;        // live signals
CXauEngine g_lab;        // daily Strategy Lab (same window as the indicator)
CXauNews   g_news;
CTrade     g_trade;
CXPaper    g_paper;      // paper trades while a loss-streak pause is active
CXPanel    g_panel;
XRATESARR(g_rates);
XRATESARR(g_hrates);
XRATESARR(g_irates);
XRATESARR(g_drates);
int      g_hist = 10000;          // Strategy Lab window (resolved from InpHistoryBars)
int      g_mode = XAU_MODE_STEADY;  // resolved InpMode
int      g_pass[XLAB_CELLS];      // TREND mode: passing cells, best first
int      g_npass = 0;
ENUM_TIMEFRAMES g_htf = PERIOD_H1;
string   g_inter_sym = "";
bool     g_inter_invert = false;
datetime g_last_bar = 0;
bool     g_engine_ok = false;
XSignal  g_last_sig;
int      g_last_reason = XR_WARMUP;
string   g_skip_note = "";
bool     g_small = false;        // the last sized signal was refused: the account is too small for the smallest lot
string   g_small_note = "";
datetime g_last_loss_bar = 0;

// strategy in use
datetime g_lab_day = 0;
bool     g_lab_ok = false;
int      g_cell = -1;
bool     g_proven = false;
int      g_act_s = -1;
int      g_act_p = XP_CLASSIC;
XExit    g_act_x;

// risk state
double   g_day_start_eq = 0.0, g_week_start_eq = 0.0, g_peak_eq = 0.0;
long     g_day_id = -1, g_week_id = -1;
double   g_ea_base = 0.0;            // own-trades-only limits: equity when counting started, plus this EA's P/L since then
datetime g_ea_base_t = 0;
double   g_ea_closed = 0.0;
double   g_dd_chance = -1.0;         // chance of a 20% drawdown in the next 100 trades (cached per Lab result and risk)
int      g_dd_key = -1;
double   g_dd_risk = -1.0;
bool     g_kill = false, g_day_block = false, g_week_block = false;
string   g_block_note = "";

// stats from deal history
bool     g_stats_dirty = true;
int      g_consec_losses = 0, g_trades_today = 0;
int      g_tot_n = 0, g_tot_win = 0;
double   g_tot_gross_win = 0.0, g_tot_gross_loss = 0.0, g_tot_profit = 0.0;
double   g_day_pl = 0.0;

string   g_news_note = "";
bool     g_news_blocked = false;

void DrawPanel();
void Journal(const string event, const ulong pos_id, const int st, const int pr, const int dir, const double lots, const double price,
             const double sl, const double tp, const double risk_pct, const double atr, const double pl, const int proven, const string note);

//+------------------------------------------------------------------+
string GvName(const string tag)
{
   return "XS_" + IntegerToString((long)AccountInfoInteger(ACCOUNT_LOGIN)) + "_" + IntegerToString(InpMagic) + "_" + tag;
}

// peak and kill-switch are kept separately for own-trades-only limits
string GvLim(const string tag)
{
   return GvName(InpLimitsOwnTradesOnly ? tag + "O" : tag);
}

// The equity the loss limits watch: the whole account, or (InpLimitsOwnTradesOnly) the account as it was when
// counting started plus only this EA's closed and open results since then.
double RiskEquity()
{
   if(!InpLimitsOwnTradesOnly) return AccountInfoDouble(ACCOUNT_EQUITY);
   double fl = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      fl += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
   }
   return g_ea_base + g_ea_closed + fl;
}

// this EA's closed results (profit, swap, commission) since own-trades-only counting started
void RecomputeOwnClosed()
{
   g_ea_closed = 0.0;
   if(!InpLimitsOwnTradesOnly || g_ea_base_t == 0) return;
   if(!HistorySelect(g_ea_base_t, TimeCurrent() + 3600)) return;
   const int total = HistoryDealsTotal();
   for(int i = 0; i < total; i++)
   {
      const ulong d = HistoryDealGetTicket(i);
      if(d == 0) continue;
      if(HistoryDealGetInteger(d, DEAL_MAGIC) != InpMagic || HistoryDealGetString(d, DEAL_SYMBOL) != _Symbol) continue;
      g_ea_closed += HistoryDealGetDouble(d, DEAL_PROFIT) + HistoryDealGetDouble(d, DEAL_SWAP) + HistoryDealGetDouble(d, DEAL_COMMISSION);
   }
}

// Why the EA stopped, in numbers
string KillText()
{
   const double eq = RiskEquity();
   const double dd = (g_peak_eq > 0.0) ? 100.0 * (g_peak_eq - eq) / g_peak_eq : 0.0;
   string s = (InpLimitsOwnTradesOnly ? "this EA's results are " : "the account is ") + DoubleToString(dd, 1) + "% below its peak of " +
              DoubleToString(g_peak_eq, 2) + " (limit " + DoubleToString(InpMaxDDPct, 0) + "%)";
   if(!InpLimitsOwnTradesOnly) s += "; your own trades count too (InpLimitsOwnTradesOnly = true counts only the EA's)";
   return s + ". InpResetKill = true for one start resumes";
}

string GvPos(const ulong ticket, const string tag)
{
   return "XSP_" + IntegerToString((long)ticket) + "_" + tag;
}

bool IsDemo()
{
   return AccountInfoInteger(ACCOUNT_TRADE_MODE) == ACCOUNT_TRADE_MODE_DEMO;
}

// True only on a DEMO account set to free run. Real accounts (and demo rehearsal) keep every protection.
bool DemoFree()
{
   return InpDemoMode == XAU_DEMO_FREE && IsDemo();
}

double LabTarget()
{
   return (g_mode == XAU_MODE_TREND) ? InpTrendWinTarget : InpWinTarget;
}

int MaxPositions()
{
   if(DemoFree()) return XMaxI(1, InpDemoMaxPositions);
   return (g_mode == XAU_MODE_TREND) ? XMaxI(1, InpTrendMaxPositions) : XMaxI(1, InpMaxPositions);
}

// exit profiles that hold for days: not closed by the Friday flatten (they were tested holding over weekends)
bool MultiDayProfile(const int p)
{
   return (p == XP_RIDER || p == XP_SWING);
}

// Risk still open in all EA positions, % of equity (distance from the open price to the current stop).
double OpenRiskPct()
{
   const double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   if(eq <= 0.0) return 0.0;
   double money = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      const double sl = PositionGetDouble(POSITION_SL);
      const double op = PositionGetDouble(POSITION_PRICE_OPEN);
      const bool buy = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      const double dist = buy ? (op - sl) : (sl - op);
      if(sl <= 0.0 || dist <= 0.0) continue;                  // stop at or past entry: nothing left at risk
      string note = "";
      money += PositionGetDouble(POSITION_VOLUME) * XLossPerLot(_Symbol, buy, op, dist, note);
   }
   return 100.0 * money / eq;
}

// Is a position from this Lab combination already open?
bool CellOpen(const int cell)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      const string gv = GvPos(t, "C");
      if(GlobalVariableCheck(gv) && (int)GlobalVariableGet(gv) == cell) return true;
   }
   return false;
}

double RiskCapped()
{
   return XClamp(InpRiskPct, 0.05, XS_MAX_RISK_PCT);
}

string StratCode(const int s)
{
   switch(s)
   {
      case XS_CONFLUENCE: return "CONF";
      case XS_ORB:        return "ORB";
      case XS_DIP:        return "DIP";
      case XS_DOUBLE7:    return "D7";
      case XS_IBS:        return "IBS";
      case XS_SWEEP:      return "SWP";
      case XS_PULLBACK:   return "PB";
      case XS_SQUEEZE:    return "SQZ";
   }
   return "?";
}

//+------------------------------------------------------------------+
void FillConfig(XConfig &c, const ENUM_TIMEFRAMES tf)
{
   c.Defaults();
   c.base_sec = PeriodSeconds(tf);
   c.htf_sec = PeriodSeconds(g_htf);
   c.dst_mode = (int)InpServerDst;
   c.gmt_offset_sec = XWinterOffsetSec(InpManualGmt, InpGmtOffsetHrs, c.dst_mode);
   c.london_sessions = InpLondonSessions;
   c.use_session_filter = InpSessionFilter;
   c.trade_start = InpTradeStartGMT;
   c.trade_end = InpTradeEndGMT;
   c.fri_cutoff = InpFridayCutGMT;
   c.score_min = InpScoreMin;
   c.min_confluence = InpMinConfluence;
   c.adr_block = InpAdrBlock;
   c.orb_start_hour = InpOrbStartHour;
   c.orb_range_min = InpOrbRangeMin;
   c.orb_settle_min = InpOrbSettleMin;
   c.tp1_r = InpTP1_R;
   c.tp2_r = XMax(InpTP2_R, InpTP1_R + 0.1);
   c.partial_pct = XClamp(InpPartialPct / 100.0, 0.0, 1.0);
   c.trail_atr = InpTrailATR;
   c.sl_atr_min = InpSLMinATR;
   c.sl_atr_max = XMax(InpSLMaxATR, InpSLMinATR + 0.1);
   c.hold_minutes = InpHoldMinutes;
   // a fixed cost (not the spread of the moment) so the EA and the indicator test and choose alike
   c.cost_price = XMax(InpCostPrice, 0.01);
   c.min_stop_cost = XMax(InpMinStopCosts, 0.0);
   c.d1_mode = XResolveD1Mode((int)InpDailyTrend, tf);
   c.d1_def = (int)InpDailyTrendDef;
   // the broker's real overnight swap, so multi-day exits are tested with what holding really costs
   c.swap_long = XSwapCostPerUnit(_Symbol, true);
   c.swap_short = XSwapCostPerUnit(_Symbol, false);
}

//+------------------------------------------------------------------+
// MT5 keeps an EA's global variables when the chart's timeframe or symbol changes (OnDeinit + OnInit without
// unloading). Everything that belongs to the old timeframe must be cleared, or the EA keeps trading the old
// timeframe's Strategy Lab result.
void ResetState()
{
   g_lab_ok = false; g_lab_day = 0; g_cell = -1; g_proven = false; g_act_s = -1; g_act_p = XP_CLASSIC;
   g_last_bar = 0; g_engine_ok = false; g_last_reason = XR_WARMUP; g_skip_note = "";
   g_small = false; g_small_note = ""; g_stats_dirty = true; g_npass = 0;
   g_last_sig.Reset();
   g_paper.Reset();
}

int OnInit()
{
   ResetState();
   g_hist = XResolveHistoryBars(InpHistoryBars, (ENUM_TIMEFRAMES)_Period);
   g_mode = XResolveMode((int)InpMode, (ENUM_TIMEFRAMES)_Period);
   Print("XAU Sniper: mode ", (g_mode == XAU_MODE_TREND) ? "TREND (all passing strategies, trend-riding exits)" : "STEADY (one strategy, 60%+ winners)");
   g_htf = (InpHTF == PERIOD_CURRENT) ? XAutoHTF((ENUM_TIMEFRAMES)_Period) : InpHTF;
   if(PeriodSeconds(g_htf) <= PeriodSeconds((ENUM_TIMEFRAMES)_Period)) g_htf = XAutoHTF((ENUM_TIMEFRAMES)_Period);

   string up = _Symbol;
   StringToUpper(up);
   if(StringFind(up, "XAU") < 0 && StringFind(up, "GOLD") < 0)
      Print("XAU Sniper: WARNING - ", _Symbol, " does not look like gold. The engine is tuned for XAUUSD.");
   if(InpRiskPct > XS_MAX_RISK_PCT) Print("XAU Sniper: risk per trade capped at ", DoubleToString(XS_MAX_RISK_PCT, 1), "% (requested ", DoubleToString(InpRiskPct, 2), "%).");
   if(InpRiskPct > 2.0) Print("XAU Sniper: WARNING - risk above 2% per trade makes a losing streak very costly.");

   if(MQLInfoInteger(MQL_TESTER)) { GlobalVariablesDeleteAll("XS_"); GlobalVariablesDeleteAll("XSP_"); }
   g_trade.SetExpertMagicNumber((ulong)InpMagic);
   g_trade.SetDeviationInPoints((ulong)InpSlippagePts);
   g_trade.SetTypeFillingBySymbol(_Symbol);
   g_trade.SetAsyncMode(false);

   g_inter_sym = XResolveInterSymbol(InpInterSymbol, g_inter_invert);
   g_news.before_min = InpNewsBefore;
   g_news.after_min = InpNewsAfter;
   g_news.min_importance = 3;

   if(InpResetKill)
   {
      GlobalVariableDel(GvLim("KILL"));
      GlobalVariableDel(GvLim("PEAK"));
      GlobalVariableDel(GvName("EABASE"));
      GlobalVariableDel(GvName("EABASET"));
      Print("XAU Sniper: kill-switch and peak equity reset.");
   }
   // own-trades-only limits: remember where counting started (survives restarts)
   if(InpLimitsOwnTradesOnly)
   {
      if(!GlobalVariableCheck(GvName("EABASE")) || !GlobalVariableCheck(GvName("EABASET")))
      {
         GlobalVariableSet(GvName("EABASE"), AccountInfoDouble(ACCOUNT_EQUITY));
         GlobalVariableSet(GvName("EABASET"), (double)TimeCurrent());
      }
      g_ea_base = GlobalVariableGet(GvName("EABASE"));
      g_ea_base_t = (datetime)GlobalVariableGet(GvName("EABASET"));
      RecomputeOwnClosed();
   }
   const double eq = RiskEquity();
   if(DemoFree())
   {
      GlobalVariableDel(GvLim("KILL"));
      GlobalVariableDel(GvLim("PEAK"));
      Print("XAU Sniper: DEMO free run - guardrails are warnings only. This is not a preview of a real account.");
   }
   else if(IsDemo()) Print("XAU Sniper: DEMO rehearsal - the same rules as a real account (InpDemoMode).");
   g_kill = GlobalVariableCheck(GvLim("KILL"));
   g_peak_eq = GlobalVariableCheck(GvLim("PEAK")) ? GlobalVariableGet(GvLim("PEAK")) : eq;
   if(g_peak_eq < eq) g_peak_eq = eq;
   g_day_start_eq = eq; g_week_start_eq = eq;
   g_day_id = -1; g_week_id = -1;
   g_last_sig.Reset();
   g_st_n = 0;
   FillConfig(g_eng.cfg, (ENUM_TIMEFRAMES)_Period);
   XMakeExit(XP_CLASSIC, g_eng.cfg, g_act_x);

   g_panel.prefix = "XS_PN_"; g_panel.fs = InpFontSize; g_panel.pos = InpPanelPos; g_panel.x = 12; g_panel.y = 30; g_panel.min_w = 330;

   EventSetTimer(2);
   g_stats_dirty = true;
   if(!MQLInfoInteger(MQL_TESTER))
   {
      // one EA instance per symbol + magic: a second chart would double every trade
      const string lock = GvName("LOCK_" + _Symbol);
      if(GlobalVariableCheck(lock) && (double)TimeLocal() - GlobalVariableGet(lock) < 15.0)
      {
         Print("XAU Sniper: another instance is already running on ", _Symbol, " with magic ", InpMagic, ". Refusing to start.");
         return INIT_FAILED;
      }
      GlobalVariableSet(lock, (double)TimeLocal());
   }
   return INIT_SUCCEEDED;
}

void OnDeinit(const int reason)
{
   EventKillTimer();
   if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableDel(GvName("LOCK_" + _Symbol));
   if(MQLInfoInteger(MQL_TESTER)) { GlobalVariablesDeleteAll("XS_"); GlobalVariablesDeleteAll("XSP_"); }
   ObjectsDeleteAll(0, "XS_");
}

//+------------------------------------------------------------------+
//| position state                                                    |
//+------------------------------------------------------------------+
void StSave(const int k)
{
   const ulong t = g_st_ticket[k];
   GlobalVariableSet(GvPos(t, "R"), g_st_r0[k]);
   GlobalVariableSet(GvPos(t, "V"), g_st_vol0[k]);
   GlobalVariableSet(GvPos(t, "S"), (double)g_st_stage[k]);
   GlobalVariableSet(GvPos(t, "E"), g_st_ext[k]);
   GlobalVariableSet(GvPos(t, "A"), g_st_atr[k]);
   GlobalVariableSet(GvPos(t, "X"), (double)g_st_prof[k]);
}

int StIndex(const ulong ticket, const bool create)
{
   for(int i = 0; i < g_st_n; i++) if(g_st_ticket[i] == ticket) return i;
   if(!create || g_st_n >= XS_MAXPOS) return -1;
   const int k = g_st_n++;
   g_st_ticket[k] = ticket;
   g_st_prof[k] = GlobalVariableCheck(GvPos(ticket, "X")) ? (int)GlobalVariableGet(GvPos(ticket, "X")) : g_act_p;
   if(GlobalVariableCheck(GvPos(ticket, "R")))
   {
      g_st_r0[k]    = GlobalVariableGet(GvPos(ticket, "R"));
      g_st_vol0[k]  = GlobalVariableGet(GvPos(ticket, "V"));
      g_st_stage[k] = (int)GlobalVariableGet(GvPos(ticket, "S"));
      g_st_ext[k]   = GlobalVariableGet(GvPos(ticket, "E"));
      g_st_atr[k]   = GlobalVariableGet(GvPos(ticket, "A"));
   }
   else
   {
      const double open = PositionGetDouble(POSITION_PRICE_OPEN);
      const double sl = PositionGetDouble(POSITION_SL);
      g_st_r0[k] = (sl > 0.0) ? MathAbs(open - sl) : 0.0;
      g_st_vol0[k] = PositionGetDouble(POSITION_VOLUME);
      g_st_stage[k] = 0;
      g_st_ext[k] = 0.0;
      g_st_atr[k] = (g_engine_ok && g_eng.n > 2) ? g_eng.m_atr[g_eng.n - 2] : 0.0;
      StSave(k);
   }
   return k;
}

void StDrop(const int k)
{
   const ulong t = g_st_ticket[k];
   GlobalVariableDel(GvPos(t, "R")); GlobalVariableDel(GvPos(t, "V")); GlobalVariableDel(GvPos(t, "S"));
   GlobalVariableDel(GvPos(t, "E")); GlobalVariableDel(GvPos(t, "A")); GlobalVariableDel(GvPos(t, "X"));
   g_st_n--;
   if(k < g_st_n)
   {
      g_st_ticket[k] = g_st_ticket[g_st_n]; g_st_r0[k] = g_st_r0[g_st_n]; g_st_vol0[k] = g_st_vol0[g_st_n];
      g_st_stage[k] = g_st_stage[g_st_n]; g_st_ext[k] = g_st_ext[g_st_n]; g_st_atr[k] = g_st_atr[g_st_n];
      g_st_prof[k] = g_st_prof[g_st_n];
   }
}

int CountPositions()
{
   int c = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      c++;
   }
   return c;
}

// any position on this symbol at all (netting accounts merge positions)
bool AnyPositionOnSymbol()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol) return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| order helpers                                                     |
//+------------------------------------------------------------------+
bool RetOk(const uint rc)
{
   return (rc == TRADE_RETCODE_DONE || rc == TRADE_RETCODE_PLACED || rc == TRADE_RETCODE_DONE_PARTIAL);
}

bool RetRetry(const uint rc)
{
   return (rc == TRADE_RETCODE_REQUOTE || rc == TRADE_RETCODE_PRICE_CHANGED || rc == TRADE_RETCODE_PRICE_OFF);
}

bool ClosePart(const ulong ticket, const double volume)
{
   for(int a = 0; a < 3; a++)
   {
      bool ok;
      if(volume <= 0.0) ok = g_trade.PositionClose(ticket);
      else              ok = g_trade.PositionClosePartial(ticket, volume);
      const uint rc = g_trade.ResultRetcode();
      if(ok && RetOk(rc)) return true;
      if(!RetRetry(rc)) break;
      Sleep(150);
   }
   Print("XAU Sniper: close failed, retcode ", (int)g_trade.ResultRetcode(), " ", g_trade.ResultRetcodeDescription());
   return false;
}

void CloseAllOurs(const string why)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      Print("XAU Sniper: closing position ", (long)t, " - ", why);
      ClosePart(t, 0.0);
   }
}

//+------------------------------------------------------------------+
//| per-tick position management (each trade follows its exit style)  |
//+------------------------------------------------------------------+
void ManagePositions()
{
   if(PositionsTotal() == 0) { while(g_st_n > 0) StDrop(g_st_n - 1); return; }
   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick)) return;
   const double pt = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   const double vmin = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   const double vstep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   const double stops = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * pt;
   const double spread_px = tick.ask - tick.bid;
   const int period_sec = PeriodSeconds((ENUM_TIMEFRAMES)_Period);
   const datetime now = TimeCurrent();
   const int gmt_off = XOffsetAt(g_eng.cfg, now);

   bool seen[XS_MAXPOS];
   for(int q = 0; q < XS_MAXPOS; q++) seen[q] = false;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      const int k = StIndex(ticket, true);
      if(k < 0) continue;
      seen[k] = true;
      XExit x;
      XMakeExit(g_st_prof[k], g_eng.cfg, x);

      const bool buy = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      const int dir = buy ? 1 : -1;
      const double open = PositionGetDouble(POSITION_PRICE_OPEN);
      const double cur_sl = PositionGetDouble(POSITION_SL);
      const double cur_tp = PositionGetDouble(POSITION_TP);
      const double vol = PositionGetDouble(POSITION_VOLUME);
      const double px = buy ? tick.bid : tick.ask;
      const double fav = dir * (px - open);
      const double r0 = g_st_r0[k];
      if(fav > g_st_ext[k]) g_st_ext[k] = fav;

      // --- time stop and Friday flatten
      const int maxh = (x.max_hold > 0) ? x.max_hold : g_eng.MaxHold();
      const datetime opened = (datetime)PositionGetInteger(POSITION_TIME);
      // count bars (as the tests do), not calendar time, so weekends do not shorten multi-day holds
      const int held = iBarShift(_Symbol, (ENUM_TIMEFRAMES)_Period, opened, false);
      if((held >= 0 && held >= maxh) || (held < 0 && now - opened >= (datetime)(maxh * period_sec)))
      {
         Print("XAU Sniper: time stop on ", (long)ticket);
         ClosePart(ticket, 0.0);
         continue;
      }
      if(InpFridayFlatten && !MultiDayProfile(g_st_prof[k]) && XWeekdayGmt(now, gmt_off) == 5 && XHourGmt(now, gmt_off) + ((InpLondonSessions && XEuDst((long)now - gmt_off)) ? 1.0 : 0.0) >= InpFlattenGMT)
      {
         Print("XAU Sniper: Friday flatten on ", (long)ticket);
         ClosePart(ticket, 0.0);
         continue;
      }
      if(r0 <= 0.0) continue;

      // --- first target: bank the planned share, stop to break-even (or the profile's lock)
      if(g_st_stage[k] == 0 && x.tp1_r > 0.0 && x.part > 0.0 && fav >= x.tp1_r * r0)
      {
         const double vc = MathFloor(g_st_vol0[k] * x.part / vstep + 1e-9) * vstep;
         const bool close_all = (x.part >= 0.999) || (vc > 0.0 && (vol - vc) < vmin - 1e-9);
         if(close_all) { ClosePart(ticket, 0.0); continue; }
         if(vc >= vmin - 1e-9)
         {
            if(!ClosePart(ticket, vc)) continue;
         }
         const double be = NormalizeDouble(open + dir * (x.be_lock_r * r0 + spread_px), _Digits);
         const bool sl_ok = buy ? (be > cur_sl && (tick.bid - be) > stops)
                                : ((cur_sl == 0.0 || be < cur_sl) && (be - tick.ask) > stops);
         if(sl_ok) g_trade.PositionModify(ticket, be, cur_tp);
         g_st_stage[k] = 1;
         StSave(k);
         continue;
      }

      // --- after the first target: ATR trail on the best excursion
      if(g_st_stage[k] == 1 && x.trail_atr > 0.0 && g_st_atr[k] > 0.0)
      {
         double tsl = open + dir * (g_st_ext[k] - x.trail_atr * g_st_atr[k]);
         tsl = NormalizeDouble(tsl, _Digits);
         const double step = 2.0 * pt;
         const bool better = buy ? (tsl > cur_sl + step) : (cur_sl == 0.0 || tsl < cur_sl - step);
         const bool room = buy ? ((tick.bid - tsl) > stops) : ((tsl - tick.ask) > stops);
         if(better && room)
         {
            if(g_trade.PositionModify(ticket, tsl, cur_tp)) StSave(k);
         }
      }
   }
   for(int k = g_st_n - 1; k >= 0; k--) if(!seen[k]) StDrop(k);
}

// Mean-reversion exit, checked when a bar closes: price closed back across the 5-bar mean.
void CheckMeanExits()
{
   if(!g_engine_ok) return;
   const int i = g_eng.n - 2;
   for(int p = PositionsTotal() - 1; p >= 0; p--)
   {
      const ulong ticket = PositionGetTicket(p);
      if(ticket == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      const int k = StIndex(ticket, true);
      if(k < 0) continue;
      XExit x;
      XMakeExit(g_st_prof[k], g_eng.cfg, x);
      if(x.mr_exit != 1) continue;
      const bool buy = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      if((buy && g_eng.m_c[i] > g_eng.m_sma5[i]) || (!buy && g_eng.m_c[i] < g_eng.m_sma5[i]))
      {
         Print("XAU Sniper: mean-reversion exit on ", (long)ticket, " (close ", DoubleToString(g_eng.m_c[i], _Digits),
               " past the 5-bar mean ", DoubleToString(g_eng.m_sma5[i], _Digits), ")");
         ClosePart(ticket, 0.0);
      }
   }
}

//+------------------------------------------------------------------+
//| deal history: streaks, trades today, live statistics              |
//+------------------------------------------------------------------+
void RecomputeStats()
{
   g_stats_dirty = false;
   RecomputeOwnClosed();
   const datetime now = TimeCurrent();
   const long day_now = (long)TimeTradeServer() / 86400;
   if(!HistorySelect(now - 45 * 86400, now + 3600)) return;
   const int total = HistoryDealsTotal();

   ulong    pid[256];
   double   pl[256];
   datetime tlast[256];
   datetime tfirst[256];
   bool     has_out[256];
   int      cnt = 0;

   for(int i = 0; i < total; i++)
   {
      const ulong tk = HistoryDealGetTicket(i);
      if(tk == 0) continue;
      if(HistoryDealGetInteger(tk, DEAL_MAGIC) != InpMagic) continue;
      if(HistoryDealGetString(tk, DEAL_SYMBOL) != _Symbol) continue;
      const long entry = HistoryDealGetInteger(tk, DEAL_ENTRY);
      const long typ = HistoryDealGetInteger(tk, DEAL_TYPE);
      if(typ != DEAL_TYPE_BUY && typ != DEAL_TYPE_SELL) continue;
      const ulong id = (ulong)HistoryDealGetInteger(tk, DEAL_POSITION_ID);
      const datetime dt = (datetime)HistoryDealGetInteger(tk, DEAL_TIME);
      const double p = HistoryDealGetDouble(tk, DEAL_PROFIT) + HistoryDealGetDouble(tk, DEAL_SWAP) + HistoryDealGetDouble(tk, DEAL_COMMISSION);
      int k = -1;
      for(int j = 0; j < cnt; j++) if(pid[j] == id) { k = j; break; }
      if(k < 0)
      {
         if(cnt >= 256) continue;
         k = cnt++;
         pid[k] = id; pl[k] = 0.0; tlast[k] = dt; tfirst[k] = dt; has_out[k] = false;
      }
      pl[k] += p;
      if(dt < tfirst[k]) tfirst[k] = dt;
      if(entry == DEAL_ENTRY_OUT || entry == DEAL_ENTRY_OUT_BY || entry == DEAL_ENTRY_INOUT)
      {
         has_out[k] = true;
         if(dt > tlast[k]) tlast[k] = dt;
      }
   }
   // positions still open are not "closed trades"
   ulong open_ids[XS_MAXPOS];
   int no = 0;
   for(int i = PositionsTotal() - 1; i >= 0 && no < XS_MAXPOS; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      open_ids[no++] = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
   }
   // order closed trades by close time (insertion sort on index list)
   int order[256];
   int nc = 0;
   for(int j = 0; j < cnt; j++)
   {
      bool is_open = false;
      for(int q = 0; q < no; q++) if(open_ids[q] == pid[j]) is_open = true;
      if(!has_out[j] || is_open) continue;
      int pos = nc;
      while(pos > 0 && tlast[order[pos - 1]] > tlast[j]) { order[pos] = order[pos - 1]; pos--; }
      order[pos] = j;
      nc++;
   }
   g_tot_n = nc; g_tot_win = 0; g_tot_gross_win = 0.0; g_tot_gross_loss = 0.0; g_tot_profit = 0.0;
   for(int a = 0; a < nc; a++)
   {
      const double p = pl[order[a]];
      g_tot_profit += p;
      if(p > 0.0) { g_tot_win++; g_tot_gross_win += p; }
      else        { g_tot_gross_loss += -p; }
   }
   g_consec_losses = 0;
   for(int a = nc - 1; a >= 0; a--)
   {
      if(pl[order[a]] < 0.0) g_consec_losses++;
      else break;
   }
   // last losing trade bar (for cooldown)
   g_last_loss_bar = 0;
   if(nc > 0 && pl[order[nc - 1]] < 0.0) g_last_loss_bar = tlast[order[nc - 1]];

   g_trades_today = 0;
   g_day_pl = 0.0;
   for(int j = 0; j < cnt; j++)
   {
      if((long)tfirst[j] / 86400 == day_now) g_trades_today++;
      if(has_out[j] && (long)tlast[j] / 86400 == day_now) g_day_pl += pl[j];
   }
}

//+------------------------------------------------------------------+
//| account protection                                                |
//+------------------------------------------------------------------+
void UpdateRisk()
{
   const double eq = RiskEquity();
   if(eq <= 0.0) return;
   const long day = (long)TimeTradeServer() / 86400;
   const long week = (day + 3) / 7;
   if(day != g_day_id)
   {
      // the day that just ended (stats still describe it until they are recomputed)
      if(InpPushDaily && g_day_id >= 0 && g_day_start_eq > 0.0)
         SendNotification("XAU Sniper " + XTfName((ENUM_TIMEFRAMES)_Period) + " day summary: " + IntegerToString(g_trades_today) + " trade(s), P/L " +
                          StringFormat("%+.2f (%+.2f%%)", eq - g_day_start_eq, 100.0 * (eq - g_day_start_eq) / g_day_start_eq) + ", equity " + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2) +
                          ", open positions " + IntegerToString(CountPositions()));
      g_day_id = day;
      g_day_start_eq = eq;
      g_day_block = false;
      g_stats_dirty = true;
   }
   if(week != g_week_id)
   {
      g_week_id = week;
      g_week_start_eq = eq;
      g_week_block = false;
   }
   if(eq > g_peak_eq)
   {
      g_peak_eq = eq;
      GlobalVariableSet(GvLim("PEAK"), g_peak_eq);
   }
   g_block_note = "";
   if(DemoFree()) g_kill = false;
   if(!g_kill && !DemoFree() && InpMaxDDPct > 0.0 && g_peak_eq > 0.0 && 100.0 * (g_peak_eq - eq) / g_peak_eq >= InpMaxDDPct)
   {
      g_kill = true;
      GlobalVariableSet(GvLim("KILL"), 1.0);
      Print("XAU Sniper: KILL-SWITCH - drawdown ", DoubleToString(100.0 * (g_peak_eq - eq) / g_peak_eq, 1), "% from peak. Trading stopped.");
      if(InpKillFlatten) CloseAllOurs("kill-switch");
   }
   const double day_loss_pct = InpDailyLossRealized ? (-100.0 * g_day_pl / MathMax(g_day_start_eq, 1.0))
                                                     : (100.0 * (g_day_start_eq - eq) / MathMax(g_day_start_eq, 1.0));
   if(!g_day_block && !DemoFree() && InpDailyLossPct > 0.0 && g_day_start_eq > 0.0 && day_loss_pct >= InpDailyLossPct)
   {
      g_day_block = true;
      Print("XAU Sniper: daily loss limit reached - no new trades today.");
   }
   if(!g_week_block && !DemoFree() && InpWeeklyLossPct > 0.0 && g_week_start_eq > 0.0 && 100.0 * (g_week_start_eq - eq) / g_week_start_eq >= InpWeeklyLossPct)
   {
      g_week_block = true;
      Print("XAU Sniper: weekly loss limit reached - no new trades this week.");
   }
   const string who = InpLimitsOwnTradesOnly ? " (this EA's trades)" : " (whole account, your own trades included)";
   if(g_kill)            g_block_note = "KILL-SWITCH: " + KillText();
   else if(g_week_block) g_block_note = "paused: this week's loss reached " + DoubleToString(InpWeeklyLossPct, 1) + "%" + who;
   else if(g_day_block)  g_block_note = "paused: today's loss reached " + DoubleToString(InpDailyLossPct, 1) + "%" + who + ", resumes tomorrow";
}

// A loss streak pauses trading for the rest of that day, or until the paper-traded signals recover.
// (The earlier version counted the streak over 45 days of history, so once paused the EA could never
// win a trade to end it.)
bool StreakPauseActive()
{
   if(InpMaxConsecLosses <= 0 || g_consec_losses < InpMaxConsecLosses) return false;
   if(g_last_loss_bar == 0 || (long)g_last_loss_bar / 86400 != (long)TimeTradeServer() / 86400) return false;   // a new day clears it
   if(InpPaperResume && g_paper.Recovered()) return false;
   return true;
}

// Checks that hold in every mode, demo free run included: they protect the account from a margin call
// and from paying more spread than the Strategy Lab assumed.
string TechnicalBlock()
{
   if(AccountInfoDouble(ACCOUNT_MARGIN_FREE) <= 0.0) return "no free margin: open trades are using all of it";
   const double ml = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
   if(ml > 0.0 && ml < 300.0) return "margin level " + DoubleToString(ml, 0) + "% is too low for another trade";
   MqlTick tk;
   if(SymbolInfoTick(_Symbol, tk) && InpCostPrice > 0.0 && tk.ask - tk.bid > 1.5 * InpCostPrice)
      return "spread " + DoubleToString(tk.ask - tk.bid, 2) + " is above 1.5x the tested cost (" + DoubleToString(InpCostPrice, 2) + ")";
   return "";
}

// returns "" when a new entry is allowed
string EntryBlocked(const XSignal &s)
{
   const string tb = TechnicalBlock();
   if(StringLen(tb) > 0) return tb;
   if(DemoFree())
   {
      // demo: only hard technical limits apply; every risk rule is a warning
      if(CountPositions() >= MaxPositions()) return "demo position limit (" + IntegerToString(MaxPositions()) + ") reached";
      if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED)) return "auto-trading disabled";
      if(SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE) != SYMBOL_TRADE_MODE_FULL) return "symbol not fully tradable now";
      const double dpt = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
      const double dsp = (double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
      if(InpMaxSpreadPts > 0 && dsp > InpMaxSpreadPts) return "spread " + DoubleToString(dsp * dpt, 2) + " too wide";
      if(InpUseNews && g_news_blocked) return "news: " + g_news_note;
      return "";
   }
   if(g_kill) return "kill-switch active";
   if(g_week_block) return "weekly loss limit";
   if(g_day_block) return "daily loss limit";
   if(StreakPauseActive())
      return "paused after " + IntegerToString(g_consec_losses) + " losses in a row" +
             (InpPaperResume ? " (paper trades so far: " + IntegerToString(g_paper.rn) + ", resumes when they recover)" : " (until tomorrow)");
   if(InpMaxTradesPerDay > 0 && g_trades_today >= InpMaxTradesPerDay) return "max trades today";
   if(CountPositions() >= MaxPositions()) return (MaxPositions() > 1) ? "position limit reached" : "position already open";
   if(g_mode == XAU_MODE_TREND && InpMaxOpenRiskPct > 0.0 && OpenRiskPct() + RiskCapped() > InpMaxOpenRiskPct + 1e-9)
      return "open risk would exceed " + DoubleToString(InpMaxOpenRiskPct, 1) + "%";
   if(InpOneTradePerSymbol && AnyPositionOnSymbol()) return "another position already open on this symbol";
   if(AnyPositionOnSymbol() && AccountInfoInteger(ACCOUNT_MARGIN_MODE) != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING) return "netting account: symbol already in use";
   if(InpCooldownBars > 0 && g_last_loss_bar > 0 &&
      TimeCurrent() - g_last_loss_bar < (datetime)(InpCooldownBars * PeriodSeconds((ENUM_TIMEFRAMES)_Period))) return "cooldown after loss";
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED)) return "auto-trading disabled";
   if(SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE) != SYMBOL_TRADE_MODE_FULL) return "symbol not fully tradable now";
   const double pt = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   const double sp_pts = (double)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   if(InpMaxSpreadPts > 0 && sp_pts > InpMaxSpreadPts) return "spread " + DoubleToString(sp_pts * pt, 2) + " too wide";
   if(InpMaxSpreadATR > 0.0 && s.atr > 0.0 && sp_pts * pt > InpMaxSpreadATR / 100.0 * s.atr) return "spread too large vs ATR";
   if(InpUseNews && g_news_blocked) return "news: " + g_news_note;
   return "";
}

// Some brokers refuse SL/TP on the market request itself. Open, attach the stops, and if they cannot be
// attached close the position at once: this EA never leaves a naked position open.
bool SendOrderThenProtect(const bool buy, const double lots, const double sl, const double tp, const string cmt)
{
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return false;
   const double price = buy ? tk.ask : tk.bid;
   const bool ok = buy ? g_trade.Buy(lots, _Symbol, price, 0.0, 0.0, cmt) : g_trade.Sell(lots, _Symbol, price, 0.0, 0.0, cmt);
   if(!ok || !RetOk(g_trade.ResultRetcode())) return false;
   Sleep(200);
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      if(PositionGetDouble(POSITION_SL) > 0.0) continue;
      if(g_trade.PositionModify(t, sl, tp) && RetOk(g_trade.ResultRetcode())) return true;
      Print("XAU Sniper: could not attach stops, closing position ", (long)t);
      ClosePart(t, 0.0);
      return false;
   }
   return false;
}

bool SendOrder(const bool buy, const double lots, const double sl, const double tp, const string cmt)
{
   for(int a = 0; a < 3; a++)
   {
      MqlTick tk;
      if(!SymbolInfoTick(_Symbol, tk)) return false;
      const double price = buy ? tk.ask : tk.bid;
      bool ok = buy ? g_trade.Buy(lots, _Symbol, price, sl, tp, cmt) : g_trade.Sell(lots, _Symbol, price, sl, tp, cmt);
      const uint rc = g_trade.ResultRetcode();
      if(ok && RetOk(rc)) return true;
      if(rc == TRADE_RETCODE_INVALID_STOPS) return SendOrderThenProtect(buy, lots, sl, tp, cmt);
      if(!RetRetry(rc)) break;
      Sleep(150);
   }
   Print("XAU Sniper: order failed, retcode ", (int)g_trade.ResultRetcode(), " ", g_trade.ResultRetcodeDescription());
   return false;
}

//+------------------------------------------------------------------+
//| engine refresh, daily Strategy Lab and entry                       |
//+------------------------------------------------------------------+
bool RefreshEngine()
{
   const int want = XMaxI(InpSignalBars, 900);
   const int got = XLoadRates(_Symbol, (ENUM_TIMEFRAMES)_Period, want, g_rates);
   if(got < 700) { g_engine_ok = false; return false; }
   FillConfig(g_eng.cfg, (ENUM_TIMEFRAMES)_Period);
   const int need_h = (int)((double)got * g_eng.cfg.base_sec / g_eng.cfg.htf_sec) + 320;
   const int gh = XLoadRates(_Symbol, g_htf, need_h, g_hrates);
   if(gh < 300) { g_engine_ok = false; return false; }   // never trade without the higher-timeframe trend
   g_eng.SetBase(g_rates, got);
   g_eng.SetHTF(g_hrates, gh);
   int gd = 0;
   if(g_eng.cfg.d1_mode > 0)
   {
      gd = XLoadRates(_Symbol, PERIOD_D1, XDailyBarsNeeded(got, (ENUM_TIMEFRAMES)_Period), g_drates);
      if(gd < XDailyMinBars(g_eng.cfg.d1_def)) { g_engine_ok = false; return false; }      // never trade the daily filter blind
   }
   g_eng.SetDaily(g_drates, gd);
   if(StringLen(g_inter_sym) > 0)
   {
      const int gi = XLoadRates(g_inter_sym, (ENUM_TIMEFRAMES)_Period, got + 50, g_irates);
      if(gi > 100) g_eng.SetInter(g_irates, gi, g_inter_invert);
   }
   if(!g_eng.Compute()) { g_engine_ok = false; return false; }
   g_eng.FitDayRange(g_eng.n - 2);                  // today's expected range for the panel (same model as the indicator)
   g_engine_ok = true;
   return true;
}

// Once per server day on the same fixed window as the indicator, so both choose the same strategy.
void RunLabIfNeeded()
{
   const datetime ds = XServerDayStart(TimeCurrent());
   if(g_lab_ok && ds == g_lab_day) return;
   FillConfig(g_lab.cfg, (ENUM_TIMEFRAMES)_Period);
   const bool ok = XRunDailyLab(g_lab, _Symbol, (ENUM_TIMEFRAMES)_Period, g_htf, g_hist, g_inter_sym, g_inter_invert,
                                LabTarget(), InpLabMinTrades, InpLabFolds, ds);
   if(!ok) return;                       // try again on the next bar
   g_lab_ok = true;
   g_lab_day = ds;
   // TREND mode: every passing combination may trade, best first
   g_npass = 0;
   for(int k = 0; k < XLAB_CELLS; k++)
   {
      const int c = g_lab.LabRanked(k);
      if(c < 0) break;
      if(g_lab.lab[c].qualified) g_pass[g_npass++] = c;
   }
   int us = (int)InpStrategy;
   if(InpOrbSolo) us = XS_ORB;
   g_cell = XResolveCell(g_lab, us, (int)InpExit, InpLabMinTrades, g_proven);
   g_dd_key = -1;                                   // new Lab result: recompute the drawdown chance
   if(g_cell < 0) { g_act_s = -1; return; }
   g_act_s = g_cell / XP_COUNT;
   g_act_p = g_cell % XP_COUNT;
   XMakeExit(g_act_p, g_eng.cfg, g_act_x);
   if(g_mode == XAU_MODE_TREND) Print("XAU Sniper: TREND mode - ", g_npass, " combinations passed the Lab (target ", DoubleToString(LabTarget(), 0), "% winners)");
   Print("XAU Sniper: Strategy Lab -> ", XStratName(g_act_s), " + ", XExitName(g_act_p), (g_proven ? " [PROVEN]" : " [UNPROVEN]"),
         ": ", DoubleToString(g_lab.lab[g_cell].all.WinRate(), 1), "% won, avg ", DoubleToString(g_lab.lab[g_cell].all.Expectancy(), 3),
         "R over ", g_lab.lab[g_cell].all.n, " trades; auto-pick walk-forward ", DoubleToString(g_lab.lab_auto.WinRate(), 1), "% / ",
         DoubleToString(g_lab.lab_auto.Expectancy(), 3), "R (", g_lab.lab_auto.n, " trades)");
}

bool TryEnterCell(const int st, const int pr, const bool proven);

void TryEnter()
{
   g_skip_note = "";
   if(g_act_s < 0) { g_last_reason = XR_WARMUP; return; }
   if(g_mode != XAU_MODE_TREND || g_npass == 0)
   {
      TryEnterCell(g_act_s, g_act_p, g_proven);
      return;
   }
   // TREND mode: every passing combination may trade, each with its own position, best first
   int last_reason = XR_NOSETUP;
   string note = "";
   for(int k = 0; k < g_npass; k++)
   {
      const int c = g_pass[k];
      if(CellOpen(c)) continue;
      g_skip_note = "";
      TryEnterCell(c / XP_COUNT, c % XP_COUNT, true);
      if(k == 0 || g_last_reason == XR_OK) last_reason = g_last_reason;
      if(StringLen(g_skip_note) > 0) note = g_skip_note;
   }
   g_last_reason = last_reason;
   g_skip_note = note;
}

// One Lab combination: signal on the last closed bar, checks, size, order. Returns true when an order was sent.
bool TryEnterCell(const int st, const int pr, const bool proven)
{
   const int i = g_eng.n - 2;                       // last CLOSED bar
   XExit xx;
   XMakeExit(pr, g_eng.cfg, xx);
   XSignal s;
   const bool has = g_eng.StrategySignal(st, i, xx, s);
   g_last_reason = s.reason;
   if(!has) return false;
   g_last_sig = s;

   if(!proven && !(DemoFree() && InpDemoUnproven))
   {
      g_skip_note = "signal skipped: no strategy has passed the Strategy Lab on this chart";
      Print("XAU Sniper: ", g_skip_note);
      Journal("SKIP", 0, st, pr, s.dir, 0.0, g_eng.m_c[i], s.sl, 0.0, 0.0, s.atr, 0.0, 0, "unproven");
      return false;
   }
   // while a loss-streak pause is active, follow the signals on paper so we know when to resume
   if(!DemoFree() && InpPaperResume && StreakPauseActive()) g_paper.Add(g_eng.m_t[i], s.dir, s.sl);

   const string blocked = EntryBlocked(s);
   if(StringLen(blocked) > 0)
   {
      g_skip_note = "signal skipped: " + blocked;
      Print("XAU Sniper: ", g_skip_note);
      Journal("SKIP", 0, st, pr, s.dir, 0.0, g_eng.m_c[i], s.sl, 0.0, 0.0, s.atr, 0.0, proven ? 1 : 0, blocked);
      return false;
   }

   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return false;
   const bool buy = (s.dir > 0);
   const double entry = buy ? tk.ask : tk.bid;
   const double dist = buy ? (entry - s.sl) : (s.sl - entry);
   if(dist < 0.4 * s.atr || dist > xx.sl_max_atr * s.atr * 1.3)
   {
      g_skip_note = "signal skipped: price moved, stop distance no longer valid";
      Print("XAU Sniper: ", g_skip_note);
      return false;
   }
   const double stops = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(dist <= stops) { g_skip_note = "signal skipped: stop inside broker minimum distance"; return false; }

   double risk = RiskCapped();
   if(g_consec_losses >= 2) risk *= XClamp(InpStreakScale, 0.1, 1.0);
   if(InpD1Scale)
   {
      double d1adx;
      const int d1 = XTrendState(_Symbol, PERIOD_D1, d1adx);
      if(d1 != 0 && d1 != s.dir) risk *= 0.5;
   }
   risk = XMin(risk, XS_MAX_RISK_PCT);

   XLotPlan lp;
   const bool demo = DemoFree();
   // free run may exceed the chosen risk with the smallest lot, but never beyond InpDemoMaxRiskPct of equity
   const double overrun = demo ? XMax(InpMaxRiskOverrun, XClamp(InpDemoMaxRiskPct, 0.5, 50.0) / XMax(risk, 0.01)) : InpMaxRiskOverrun;
   XPlanLots(_Symbol, AccountInfoDouble(ACCOUNT_EQUITY), risk, dist, buy, entry, overrun,
             InpMaxLots, AccountInfoDouble(ACCOUNT_MARGIN_FREE), XClamp(InpMarginUsePct, 5.0, 95.0) / 100.0, lp);
   if(!lp.ok)
   {
      g_skip_note = "signal skipped: " + lp.note;
      if(StringFind(lp.note, "account too small") >= 0)
      {
         // tell the user what balance this trade needs at the chosen risk
         string snote = "";
         const double per_lot = XLossPerLot(_Symbol, buy, entry, dist, snote);
         const double vmin = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
         if(per_lot > 0.0 && vmin > 0.0)
            g_skip_note += "; this trade needs about " + DoubleToString(vmin * per_lot * 100.0 / XMax(risk, 0.01), 0) + " " +
                           AccountInfoString(ACCOUNT_CURRENCY) + " at " + DoubleToString(risk, 1) + "% risk";
         g_small = true;
         g_small_note = g_skip_note;
      }
      Print("XAU Sniper: ", g_skip_note);
      Journal("SKIP", 0, st, pr, s.dir, 0.0, entry, s.sl, 0.0, lp.risk_pct, s.atr, 0.0, proven ? 1 : 0, lp.note);
      return false;
   }
   if(StringLen(lp.src_note) > 0) Print("XAU Sniper: sizing note - ", lp.src_note);
   // targets in price from the ACTUAL entry, using the profile's multiples
   const double sl = NormalizeDouble(s.sl, _Digits);
   double tp = 0.0;
   if(xx.tp2_r > 0.0)                                  tp = entry + s.dir * xx.tp2_r * dist;
   else if(xx.tp1_r > 0.0 && xx.part >= 0.999)   tp = entry + s.dir * xx.tp1_r * dist;
   tp = (tp > 0.0) ? NormalizeDouble(tp, _Digits) : 0.0;
   const string cmt = InpComment + " " + StratCode(st) + "/" + IntegerToString(pr);
   g_small = false;
   if(SendOrder(buy, lp.lots, sl, tp, cmt))
   {
      const ulong ord = g_trade.ResultOrder();
      if(ord > 0) { GlobalVariableSet(GvPos(ord, "X"), (double)pr); GlobalVariableSet(GvPos(ord, "C"), (double)(st * XP_COUNT + pr)); }
      if(demo && lp.risk_pct > risk * 1.5)
         Print("XAU Sniper: DEMO note - minimum lot risks ", DoubleToString(lp.risk_pct, 1), "% (target ", DoubleToString(risk, 2), "%). A live account would have refused this trade.");
      Journal("OPEN", ord, st, pr, s.dir, lp.lots, entry, sl, tp, lp.risk_pct, s.atr, 0.0, proven ? 1 : 0, "");
      if(InpPushTrades)
         SendNotification("XAU Sniper " + XTfName((ENUM_TIMEFRAMES)_Period) + ": " + (buy ? "BUY " : "SELL ") + DoubleToString(lp.lots, 2) + " at " +
                          DoubleToString(entry, _Digits) + ", stop " + DoubleToString(sl, _Digits) + ", risk " + DoubleToString(lp.risk_pct, 1) + "% [" +
                          XStratName(st) + " / " + XExitShort(pr) + "]");
      Print("XAU Sniper: ", (buy ? "BUY " : "SELL "), DoubleToString(lp.lots, 2), " ", _Symbol, " [", XStratName(st), " + ", XExitName(pr), "]",
            " entry ", DoubleToString(entry, _Digits), " SL ", DoubleToString(sl, _Digits), " TP ", DoubleToString(tp, _Digits),
            " risk ", DoubleToString(lp.risk_pct, 2), "% (", DoubleToString(lp.risk_money, 2), ")");
      g_stats_dirty = true;
      g_paper.Reset();
      return true;
   }
   return false;
}

//+------------------------------------------------------------------+
// Optional (InpProtectManual): give every position on this symbol that has no stop loss one, manual trades
// included. The stop sits where the position would lose InpProtectPct of equity; a position that is already
// losing more than that gets its stop InpProtectPct of equity beyond the current price, so the damage is
// capped from here on instead of being closed at once.
void ProtectManual()
{
   if(!InpProtectManual || InpProtectPct <= 0.0) return;
   static datetime s_last = 0;
   if(TimeCurrent() - s_last < 30) return;
   s_last = TimeCurrent();
   const double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   if(eq <= 0.0) return;
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return;
   const double pt = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   const double stops = (double)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * pt;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      const ulong t = PositionGetTicket(i);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetDouble(POSITION_SL) > 0.0) continue;
      const bool buy = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      const double vol = PositionGetDouble(POSITION_VOLUME);
      const double open = PositionGetDouble(POSITION_PRICE_OPEN);
      const double tp = PositionGetDouble(POSITION_TP);
      string note = "";
      const double per_unit = XLossPerLot(_Symbol, buy, open, 1.0, note);   // money per lot for a 1.0 price move
      if(per_unit <= 0.0 || vol <= 0.0) continue;
      const double dist = eq * InpProtectPct / 100.0 / (vol * per_unit);
      const double px = buy ? tk.bid : tk.ask;
      double sl = buy ? open - dist : open + dist;
      const bool beyond = buy ? (sl >= px - stops) : (sl <= px + stops);
      if(beyond) sl = buy ? px - XMax(dist, stops + pt) : px + XMax(dist, stops + pt);
      sl = NormalizeDouble(sl, _Digits);
      if(g_trade.PositionModify(t, sl, tp) && RetOk(g_trade.ResultRetcode()))
         Print("XAU Sniper: added a stop at ", DoubleToString(sl, _Digits), " to position ", (long)t, " (it had none; InpProtectManual)");
      else
         Print("XAU Sniper: could not add a stop to position ", (long)t, ": ", g_trade.ResultRetcodeDescription());
   }
}

//+------------------------------------------------------------------+
void RefreshNews()
{
   if(!InpUseNews) { g_news_blocked = false; g_news_note = ""; return; }
   g_news.Refresh(TimeCurrent());
   g_news.gmt_offset_sec = XOffsetAt(g_eng.cfg, TimeCurrent());
   string why;
   g_news_blocked = g_news.Blocked(TimeCurrent(), why);
   g_news_note = g_news_blocked ? why : g_news.NextText(TimeCurrent());
}

//+------------------------------------------------------------------+
void OnTick()
{
   UpdateRisk();
   ManagePositions();

   const datetime bt = iTime(_Symbol, (ENUM_TIMEFRAMES)_Period, 0);
   if(bt == g_last_bar || bt == 0) return;
   g_last_bar = bt;

   RefreshNews();
   if(g_stats_dirty) RecomputeStats();
   if(!RefreshEngine()) return;
   RunLabIfNeeded();
   CheckMeanExits();
   if(!DemoFree() && InpPaperResume && g_paper.pn > 0) g_paper.Update(g_eng, g_act_x);
   TryEnter();
   DrawPanel();
}

void OnTimer()
{
   if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(GvName("LOCK_" + _Symbol), (double)TimeLocal());
   ProtectManual();
   if(g_stats_dirty) RecomputeStats();
   RefreshNews();
   DrawPanel();
}

void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request, const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD) return;
   g_stats_dirty = true;
   if((!InpPushTrades && !InpJournal) || !HistoryDealSelect(trans.deal)) return;
   if(HistoryDealGetInteger(trans.deal, DEAL_MAGIC) != InpMagic || HistoryDealGetString(trans.deal, DEAL_SYMBOL) != _Symbol) return;
   const long entry = HistoryDealGetInteger(trans.deal, DEAL_ENTRY);
   if(entry != DEAL_ENTRY_OUT && entry != DEAL_ENTRY_OUT_BY && entry != DEAL_ENTRY_INOUT) return;
   const double pl = HistoryDealGetDouble(trans.deal, DEAL_PROFIT) + HistoryDealGetDouble(trans.deal, DEAL_SWAP) + HistoryDealGetDouble(trans.deal, DEAL_COMMISSION);
   // the closing deal of a buy is a sell
   const bool was_buy = (HistoryDealGetInteger(trans.deal, DEAL_TYPE) == DEAL_TYPE_SELL);
   const ulong pos_id = (ulong)HistoryDealGetInteger(trans.deal, DEAL_POSITION_ID);
   const int cell = GlobalVariableCheck(GvPos(pos_id, "C")) ? (int)GlobalVariableGet(GvPos(pos_id, "C")) : -1;
   Journal("CLOSE", pos_id, (cell >= 0) ? cell / XP_COUNT : -1, (cell >= 0) ? cell % XP_COUNT : -1, was_buy ? 1 : -1,
           HistoryDealGetDouble(trans.deal, DEAL_VOLUME), HistoryDealGetDouble(trans.deal, DEAL_PRICE), 0.0, 0.0, 0.0, 0.0, pl, -1, "");
   if(!InpPushTrades) return;
   SendNotification("XAU Sniper " + XTfName((ENUM_TIMEFRAMES)_Period) + ": closed " + (was_buy ? "BUY " : "SELL ") +
                    DoubleToString(HistoryDealGetDouble(trans.deal, DEAL_VOLUME), 2) + " at " + DoubleToString(HistoryDealGetDouble(trans.deal, DEAL_PRICE), _Digits) +
                    ", P/L " + StringFormat("%+.2f ", pl) + AccountInfoString(ACCOUNT_CURRENCY) + ", equity " + DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2));
}

//+------------------------------------------------------------------+
//| custom optimisation criterion: rewards steadiness, not just profit|
//+------------------------------------------------------------------+
double OnTester()
{
   const double trades = TesterStatistics(STAT_TRADES);
   if(trades < 40.0) return 0.0;
   const double rf = TesterStatistics(STAT_RECOVERY_FACTOR);
   const double pf = TesterStatistics(STAT_PROFIT_FACTOR);
   const double np = TesterStatistics(STAT_PROFIT);
   if(np <= 0.0) return np;
   return rf * XMin(pf, 3.0) * MathSqrt(trades);
}

// One row in the EA's journal (MQL5/Files/XAU_Export/XAU_Sniper_journal_<symbol>.csv): OPEN, CLOSE and SKIP events
// with everything needed to compare live trading with the tests. Send that file for analysis.
void Journal(const string event, const ulong pos_id, const int st, const int pr, const int dir, const double lots, const double price,
             const double sl, const double tp, const double risk_pct, const double atr, const double pl, const int proven, const string note)
{
   if(!InpJournal) return;
   const string fn = "XAU_Export\\XAU_Sniper_journal_" + _Symbol + ".csv";
   const int h = FileOpen(fn, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, ',');
   if(h == INVALID_HANDLE) return;
   if(FileSize(h) == 0)
      FileWrite(h, "event", "server_time", "position", "symbol", "timeframe", "mode", "demo_mode", "strategy", "exit", "dir", "lots", "price", "stop",
                "target", "risk_pct", "atr", "spread", "daily_trend", "proven", "result_money", "equity", "balance", "note");
   FileSeek(h, 0, SEEK_END);
   MqlTick tk;
   const double spread = SymbolInfoTick(_Symbol, tk) ? tk.ask - tk.bid : 0.0;
   const int n = g_eng.n;
   const int dr = (n > 0 && g_eng.d1n > 0) ? g_eng.m_dreg[n - 1] : 0;
   string demo = "live";
   if(IsDemo()) demo = DemoFree() ? "demo_free" : "demo_rehearsal";
   FileWrite(h, event, TimeToString(TimeTradeServer(), TIME_DATE | TIME_SECONDS), IntegerToString((long)pos_id), _Symbol,
             XTfName((ENUM_TIMEFRAMES)_Period), (g_mode == XAU_MODE_TREND) ? "TREND" : "STEADY", demo,
             (st >= 0) ? XStratName(st) : "", (pr >= 0) ? XExitShort(pr) : "", (dir > 0) ? "buy" : ((dir < 0) ? "sell" : ""),
             DoubleToString(lots, 2), DoubleToString(price, _Digits), DoubleToString(sl, _Digits), DoubleToString(tp, _Digits),
             DoubleToString(risk_pct, 2), DoubleToString(atr, _Digits), DoubleToString(spread, _Digits), IntegerToString(dr),
             (proven < 0) ? "" : IntegerToString(proven), DoubleToString(pl, 2), DoubleToString(AccountInfoDouble(ACCOUNT_EQUITY), 2),
             DoubleToString(AccountInfoDouble(ACCOUNT_BALANCE), 2), note);
   FileClose(h);
}

// Win-rate the Lab measured for what the EA trades now (TREND: all passing combinations together).
double TestedWinRate()
{
   if(!g_lab_ok) return 0.0;
   if(g_mode == XAU_MODE_TREND && g_npass > 0)
   {
      int nn = 0, ww = 0;
      for(int k = 0; k < g_npass; k++) { nn += g_lab.lab[g_pass[k]].all.n; ww += g_lab.lab[g_pass[k]].all.wins; }
      return (nn > 0) ? 100.0 * ww / nn : 0.0;
   }
   return (g_cell >= 0) ? g_lab.lab[g_cell].all.WinRate() : 0.0;
}

// % of equity the smallest lot risks with a typical stop on this chart (the last signal's, else 1.5 ATR)
double MinLotRiskPct()
{
   const double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   if(eq <= 0.0 || g_eng.n < 3) return 0.0;
   const double dist = (g_last_sig.risk > 0.0) ? g_last_sig.risk : 1.5 * g_eng.m_atr[g_eng.n - 2];
   string note = "";
   const double per_lot = XLossPerLot(_Symbol, true, g_eng.m_c[g_eng.n - 2], dist, note);
   return 100.0 * SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN) * per_lot / eq;
}

// risk per trade the account really takes: the chosen risk, or more when even the smallest lot is bigger
double EffectiveRiskPct()
{
   return XMax(RiskCapped(), MinLotRiskPct());
}

// Chance of a 20% drawdown within the next 100 trades with the tested win/loss sizes and the effective risk.
// Recomputed only when the Lab result or the risk changes (-1 = not available).
double DrawdownChance()
{
   if(!g_lab_ok || g_cell < 0) return -1.0;
   const int key = g_cell * 100 + g_npass;
   const double risk = MathRound(EffectiveRiskPct() * 10.0) / 10.0;
   if(key == g_dd_key && risk == g_dd_risk) return g_dd_chance;
   int nn = 0, ww = 0, ll = 0;
   double sw = 0.0, sl = 0.0;
   const int cnt = (g_mode == XAU_MODE_TREND && g_npass > 0) ? g_npass : 1;
   for(int k = 0; k < cnt; k++)
   {
      const int c = (g_mode == XAU_MODE_TREND && g_npass > 0) ? g_pass[k] : g_cell;
      nn += g_lab.lab[c].all.n; ww += g_lab.lab[c].all.wins; ll += g_lab.lab[c].all.losses;
      sw += g_lab.lab[c].all.sum_win; sl += g_lab.lab[c].all.sum_loss;
   }
   g_dd_key = key; g_dd_risk = risk;
   g_dd_chance = (nn >= 30 && ww > 0 && ll > 0) ? XDrawdownChance((double)ww / nn, (double)ll / nn, sw / ww, sl / ll, risk, 100, 20.0, 2000) : -1.0;
   return g_dd_chance;
}

//+------------------------------------------------------------------+
//| panel (bottom left by default, so it never covers the indicator)  |
//+------------------------------------------------------------------+
void DrawPanel()
{
   if(!InpShowPanel || (MQLInfoInteger(MQL_TESTER) && !MQLInfoInteger(MQL_VISUAL_MODE))) { g_panel.Clear(); return; }
   const color cText = XRGB(214, 222, 235), cDim = XRGB(140, 150, 166), cGreen = XRGB(0, 222, 132);
   const color cRed = XRGB(255, 92, 92), cGold = XRGB(255, 200, 64), cCyan = XRGB(64, 200, 255);
   const double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   const int np = CountPositions();

   string mode = (g_mode == XAU_MODE_TREND) ? "  TREND" : "  STEADY";
   mode += "   [LIVE rules]";
   if(DemoFree()) mode = ((g_mode == XAU_MODE_TREND) ? "  TREND" : "  STEADY") + string("   [DEMO free run]");
   else if(IsDemo()) mode = ((g_mode == XAU_MODE_TREND) ? "  TREND" : "  STEADY") + string("   [DEMO rehearsal]");
   string status = "LOOKING FOR A SETUP";
   color sc = cCyan;
   string sub = StringLen(g_skip_note) > 0 ? g_skip_note : XReasonText(g_last_reason);
   if(g_kill)                           { status = "STOPPED - loss limit hit"; sc = cRed; sub = KillText(); }
   else if(g_week_block || g_day_block) { status = "PAUSED"; sc = cGold; sub = g_block_note; }
   else if(np > 0)                      { status = "IN " + IntegerToString(np) + " TRADE"; if(np > 1) status += "S"; sc = cGreen; sub = "managing the exit: " + XExitName(g_act_p); }
   else if(g_news_blocked)              { status = "PAUSED - NEWS"; sc = cGold; sub = g_news_note; }
   else if(!g_lab_ok)                   { status = "LEARNING"; sub = "Strategy Lab is testing this chart's history"; }
   else if(g_act_s < 0)                 { status = "NO STRATEGY YET"; sc = cGold; sub = "not enough trades in the history to judge"; }
   else if(!g_proven && !(DemoFree() && InpDemoUnproven) && !(g_mode == XAU_MODE_TREND && g_npass > 0)) { status = "STANDING ASIDE"; sc = cGold; sub = "nothing passed the Strategy Lab here"; }
   else if(g_small)                     { status = "ACCOUNT TOO SMALL HERE"; sc = cGold; sub = g_small_note; }

   g_panel.Begin();
   g_panel.Line("XAU SNIPER  " + XTfName((ENUM_TIMEFRAMES)_Period) + mode, cGold);
   g_panel.Line(status, sc, 3);
   g_panel.Line(sub, cDim);
   if(g_lab_ok && g_eng.n > 0)
   {
      bool go;
      const int n = g_eng.n;
      const bool intraday = PeriodSeconds((ENUM_TIMEFRAMES)_Period) < 86400;
      const string today = XTodayPlan(g_mode, g_npass, g_proven || (DemoFree() && InpDemoUnproven), g_small, g_eng.cfg.d1_mode,
                                      (g_eng.d1n > 0) ? g_eng.m_dreg[n - 1] : 0, intraday ? g_eng.DayRangeForecast(n - 1) : 0.0,
                                      intraday ? g_eng.m_adru[n - 1] * g_eng.m_adr[n - 1] : 0.0, go);
      g_panel.Line(today, go ? cGreen : cGold);
      // every entry check in one row
      const int dr = (g_eng.d1n > 0) ? g_eng.m_dreg[n - 1] : 0;
      MqlTick ck;
      const bool spread_ok = !(SymbolInfoTick(_Symbol, ck) && InpCostPrice > 0.0 && ck.ask - ck.bid > 1.5 * InpCostPrice);
      const double mlv = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);
      const bool margin_ok = AccountInfoDouble(ACCOUNT_MARGIN_FREE) > 0.0 && (mlv <= 0.0 || mlv >= 300.0);
      const bool lab_ok = g_proven || (g_mode == XAU_MODE_TREND && g_npass > 0) || (DemoFree() && InpDemoUnproven);
      const bool trend_ok = !(g_eng.cfg.d1_mode == 2 && dr <= 0) && !(g_eng.cfg.d1_mode == 1 && dr == 0);
      const bool limits_ok = DemoFree() || !(g_kill || g_day_block || g_week_block || StreakPauseActive());
      // size: the smallest lot must fit the risk rule (free run allows up to InpDemoMaxRiskPct)
      const double size_cap = DemoFree() ? XClamp(InpDemoMaxRiskPct, 0.5, 50.0) : RiskCapped() * XMax(InpMaxRiskOverrun, 1.0);
      const bool size_ok = !g_small && EffectiveRiskPct() <= size_cap + 1e-9;
      const string row = XCheckRow(lab_ok, trend_ok, !(InpUseNews && g_news_blocked), spread_ok, margin_ok, size_ok, limits_ok);
      g_panel.Line(row, (StringFind(row, "NO") < 0) ? cGreen : cDim);
   }
   if(g_mode == XAU_MODE_TREND && g_npass > 0)
   {
      g_panel.Line("TREND mode: " + IntegerToString(g_npass) + " strateg" + (g_npass > 1 ? "ies" : "y") + " passed today, each may trade (max "
                   + IntegerToString(MaxPositions()) + " at once)", cGreen);
      for(int k = 0; k < g_npass && k < 3; k++)
      {
         const int c = g_pass[k];
         const XStats st = g_lab.lab[c].all;
         g_panel.Line("  " + XStratName(c / XP_COUNT) + " / " + XExitShort(c % XP_COUNT) + ": " + DoubleToString(st.WinRate(), 0) + "% won, "
                      + StringFormat("%+.2f", st.Expectancy()) + "R, " + IntegerToString(st.n) + " trades", cDim);
      }
   }
   else if(g_act_s >= 0)
   {
      string badge = "  [PROVEN]";
      if(!g_proven) badge = "  [UNPROVEN]";
      string mtag = "";
      if(g_mode == XAU_MODE_TREND) mtag = "TREND mode, nothing passed: ";
      g_panel.Line(mtag + "Trading: " + XStratName(g_act_s) + " + " + XExitName(g_act_p) + badge, g_proven ? cGreen : cGold);
      const XStats st = g_lab.lab[g_cell].all;
      g_panel.Line("Lab here: " + DoubleToString(st.WinRate(), 0) + "% won, avg " + StringFormat("%+.2f", st.Expectancy()) + "R, "
                   + IntegerToString(st.n) + " trades", cDim);
   }
   // open positions in plain words
   for(int pi = PositionsTotal() - 1; pi >= 0; pi--)
   {
      const ulong t = PositionGetTicket(pi);
      if(t == 0) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol || PositionGetInteger(POSITION_MAGIC) != InpMagic) continue;
      const bool b = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
      const int kk = StIndex(t, false);
      string plan = "";
      if(kk >= 0) plan = "  [" + XExitShort(g_st_prof[kk]) + "]";
      g_panel.Line((b ? "  BUY " : "  SELL ") + DoubleToString(PositionGetDouble(POSITION_VOLUME), 2) + " @" + DoubleToString(PositionGetDouble(POSITION_PRICE_OPEN), _Digits)
                   + "  stop " + DoubleToString(PositionGetDouble(POSITION_SL), _Digits) + "  P/L " + DoubleToString(PositionGetDouble(POSITION_PROFIT), 2) + plan,
                   PositionGetDouble(POSITION_PROFIT) >= 0.0 ? cGreen : cRed);
   }
   const double dpl = (g_day_start_eq > 0.0) ? 100.0 * (RiskEquity() - g_day_start_eq) / g_day_start_eq : 0.0;
   g_panel.Line("Equity " + DoubleToString(eq, 2) + "   today " + StringFormat("%+.2f%%", dpl) + "   trades today " + IntegerToString(g_trades_today), cText);
   if(g_tot_n > 0)
   {
      const double pf = (g_tot_gross_loss > 1e-9) ? g_tot_gross_win / g_tot_gross_loss : 99.0;
      g_panel.Line("Live results (45 days): " + IntegerToString(g_tot_n) + " trades, " + DoubleToString(100.0 * g_tot_win / g_tot_n, 0) + "% won, P/L "
                   + DoubleToString(g_tot_profit, 2) + ", profit factor " + DoubleToString(pf, 2), g_tot_profit >= 0.0 ? cGreen : cRed);
   }
   else g_panel.Line("Live results: no closed trades yet", cDim);
   const string drift = XLiveDrift(g_tot_n, g_tot_win, TestedWinRate());
   if(StringLen(drift) > 0) g_panel.Line(drift, cRed);
   const double ddc = DrawdownChance();
   if(ddc >= 0.0)
   {
      const double er = EffectiveRiskPct();
      const string at = (er > RiskCapped() + 0.05) ? (DoubleToString(er, 1) + "% risk (the smallest lot here; your setting " + DoubleToString(RiskCapped(), 1) + "%)")
                                                   : (DoubleToString(er, 1) + "% risk");
      g_panel.Line("Risk check: chance of a 20% drawdown within the next 100 trades at " + at + ": about "
                   + DoubleToString(100.0 * ddc, 0) + "%", (ddc > 0.10) ? cRed : cDim);
   }
   const string warn = XAccountWarning(_Symbol);
   if(StringLen(warn) > 0) g_panel.Line("RISK: " + warn, cRed);
   if(StringFind(warn, "NO stop") >= 0 && !InpProtectManual) g_panel.Line("Tip: InpProtectManual = true lets the EA put a stop on them", cDim);
   if(InpUseNews && StringFind(g_news_note, " in ") >= 0) g_panel.Line("News: " + g_news_note, g_news_blocked ? cRed : cDim);
   g_panel.End();
}
