//+------------------------------------------------------------------+
//| small math helpers (avoid MathMax/MathMin overload ambiguity)    |
//+------------------------------------------------------------------+
double XMin(const double a, const double b) { return (a < b) ? a : b; }
double XMax(const double a, const double b) { return (a > b) ? a : b; }
int    XMinI(const int a, const int b)      { return (a < b) ? a : b; }
int    XMaxI(const int a, const int b)      { return (a > b) ? a : b; }
int    XClampI(const int x, const int lo, const int hi) { return (x < lo) ? lo : ((x > hi) ? hi : x); }
double XAbs(const double a)                 { return (a < 0.0) ? -a : a; }
double XClamp(const double x, const double lo, const double hi)
{
   if(x < lo) return lo;
   if(x > hi) return hi;
   return x;
}

// Least squares helpers: m is a k x (k+1) normal-equation matrix (row-major), accumulated with XOlsAdd.
void XOlsAdd(XD(m), XCD(x), const int k, const double y)
{
   for(int i = 0; i < k; i++)
   {
      for(int j = 0; j < k; j++) m[i * (k + 1) + j] += x[i] * x[j];
      m[i * (k + 1) + k] += x[i] * y;
   }
}

bool XOlsSolve(XD(m), const int k, XD(out))
{
   for(int i = 0; i < k; i++) m[i * (k + 1) + i] += 1e-6;
   for(int c = 0; c < k; c++)
   {
      int p = c;
      for(int r = c + 1; r < k; r++) if(XAbs(m[r * (k + 1) + c]) > XAbs(m[p * (k + 1) + c])) p = r;
      if(XAbs(m[p * (k + 1) + c]) < 1e-12) return false;
      if(p != c) for(int j = 0; j <= k; j++) { const double t = m[c * (k + 1) + j]; m[c * (k + 1) + j] = m[p * (k + 1) + j]; m[p * (k + 1) + j] = t; }
      for(int r = 0; r < k; r++)
      {
         if(r == c) continue;
         const double f = m[r * (k + 1) + c] / m[c * (k + 1) + c];
         for(int j = c; j <= k; j++) m[r * (k + 1) + j] -= f * m[c * (k + 1) + j];
      }
   }
   for(int i = 0; i < k; i++) out[i] = m[i * (k + 1) + k] / m[i * (k + 1) + i];
   return true;
}

