; XAU_Sniper_GoldORB
; The GOLD_ORB strategy on its own: opening range breakout, one long and one short per day, fixed 3R target (no partials), 24h time stop.
; Attach to an XAUUSD H1 chart (the original ran on H1). Stops are ATR-scaled instead of the original fixed 400 points, which is far too tight at today's gold prices.
; Breakout systems earn in trending years and lose in ranging ones; the source's only test was 2019 (a strong year). Validate on your own data first.
InpRiskPct=1.0
InpGradeScaling=false
InpStreakScale=0.5
InpMaxLots=0.0
InpMarginUsePct=50.0
InpMaxRiskOverrun=1.5
InpDailyLossPct=3.0
InpWeeklyLossPct=6.0
InpMaxDDPct=15.0
InpKillFlatten=true
InpResetKill=false
InpMaxConsecLosses=3
InpMaxTradesPerDay=2
InpMaxPositions=1
InpCooldownBars=0
InpHistoryBars=3000
InpScoreMin=1.7
InpMinConfluence=2
InpMinGrade=1
InpAdaptiveGate=false
InpTP1_R=3.0
InpTP2_R=3.5
InpPartialPct=100.0
InpTrailATR=2.0
InpSLMinATR=0.9
InpSLMaxATR=2.6
InpHoldMinutes=1440
InpSessionFilter=false
InpTradeStartGMT=7.0
InpTradeEndGMT=20.0
InpFridayCutGMT=19.0
InpFridayFlatten=true
InpFlattenGMT=20.5
InpMaxSpreadPts=60
InpMaxSpreadATR=12.0
InpUseNews=true
InpNewsBefore=30
InpNewsAfter=30
InpManualGmt=false
InpGmtOffsetHrs=2.0
InpServerDst=1
InpLondonSessions=true
InpAdrBlock=0.0
InpRegimeWeights=false
InpOneTradePerSymbol=true
InpDailyLossRealized=false
InpD1Scale=false
InpDemoUnlocked=true
